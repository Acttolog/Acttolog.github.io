25:["$","section",null,{"className":"sec nb-sec","id":"ab-sources","children":["$","div",null,{"className":"wrap","children":["$","$L21",null,{"children":["$","$L32",null,{"notices":[{"id":"nw-un-data","scope":"network","category":"resource","kind":"source","title":{"en":"UN Data Commons","ne":"संयुक्त राष्ट्रसंघ डाटा"},"org":{"en":"United Nations Statistics Division","ne":"संयुक्त राष्ट्रसंघ तथ्याङ्क महाशाखा"},"summary":{"en":"Cross-agency UN statistics — population, health, education and trade series.","ne":"विभिन्न एजेन्सीका राष्ट्रसंघीय तथ्याङ्क — जनसङ्ख्या, स्वास्थ्य, शिक्षा र व्यापार शृङ्खला।"},"detail":{"en":"A single searchable catalogue over the UN system’s statistical databases. ACTTOLOG’s country indicators cite series from here; each dataset carries its own source agency and revision date.","ne":"राष्ट्रसंघीय प्रणालीका तथ्याङ्कीय डाटाबेसहरूको एउटै खोजযোগ्य सूची। ACTTOLOG का देश सूचकहरूले यहाँका शृङ्खला उद्धृत गर्छन्।"},"sourceUrl":"https://data.un.org","sourceName":"data.un.org","location":{"en":"New York","ne":"न्यूयोर्क"},"tags":["statistics","indicators","open data"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"nw-usgs-quake","scope":"network","category":"resource","kind":"source","title":{"en":"USGS Earthquake Hazards Program","ne":"यूएसजीएस भूकम्प कार्यक्रम"},"org":{"en":"United States Geological Survey","ne":"संयुक्त राज्य भूगर्भ सर्वेक्षण"},"summary":{"en":"Real-time global earthquake catalogue and shake maps.","ne":"वास्तविक-समय विश्वव्यापी भूकम्प सूची र शेक नक्सा।"},"detail":{"en":"The reference catalogue for global seismicity, updated continuously from the world’s networks. Nepal sits on the Main Himalayan Thrust, so this is the authoritative record for any earthquake magnitude or depth quoted on the site.","ne":"विश्वव्यापी भूकम्पीयताको सन्दर्भ सूची, निरन्तर अद्यावधिक। नेपाल मुख्य हिमालयी थ्रस्टमा पर्छ, त्यसैले परिमाण र गहिराइको आधिकारिक रेकर्ड यही हो।"},"sourceUrl":"https://earthquake.usgs.gov","sourceName":"earthquake.usgs.gov","location":{"en":"Reston, Virginia","ne":"रेस्टन, भर्जिनिया"},"tags":["earthquake","seismicity","hazard"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"nw-naturalearth","scope":"network","category":"resource","kind":"source","title":{"en":"Natural Earth","ne":"नेचुरल अर्थ"},"org":{"en":"Natural Earth (public domain map data)","ne":"नेचुरल अर्थ (सार्वजनिक डोमेन नक्सा डाटा)"},"summary":{"en":"Public-domain vector and raster map data at three scales.","ne":"तीन स्केलमा सार्वजनिक-डोमेन भेक्टर र रास्टर नक्सा डाटा।"},"detail":{"en":"Free, curated cartography built for small-scale world maps. Coastlines, admin boundaries and populated places come from here rather than from a proprietary tile service, so the base map stays reproducible and licence-clean.","ne":"सानो-स्केल विश्व नक्साका लागि निःशुल्क, क्युरेटेड कार्टोग्राफी। तटरेखा, प्रशासनिक सिमाना र बस्तीहरू यहाँबाट आउँछन्, त्यसैले आधार नक्सा पुनःउत्पादनयोग्य रहन्छ।"},"sourceUrl":"https://naturalearthdata.com","sourceName":"naturalearthdata.com","location":{"en":"Public domain","ne":"सार्वजनिक डोमेन"},"tags":["cartography","vector","public domain"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"nw-who","scope":"network","category":"resource","kind":"source","title":{"en":"World Health Organization","ne":"विश्व स्वास्थ्य संगठन"},"org":{"en":"World Health Organization","ne":"विश्व स्वास्थ्य संगठन"},"summary":{"en":"Global health statistics, outbreak bulletins and country profiles.","ne":"विश्व स्वास्थ्य तथ्याङ्क, प्रकोप बुलेटिन र देश प्रोफाइल।"},"detail":{"en":"The UN’s directing authority on international health. Disease-outlook news and the Global Health Observatory are the citable source for any health indicator shown on ACTTOLOG.","ne":"अन्तर्राष्ट्रिय स्वास्थ्यमा राष्ट्रसंघको निर्देशक निकाय। रोग-दृष्टिकोण समाचार र विश्व स्वास्थ्य अवलोकन केन्द्र स्वास्थ्य सूचकको उद्धरणयोग्य स्रोत हुन्।"},"sourceUrl":"https://www.who.int","sourceName":"who.int","location":{"en":"Geneva","ne":"जेनेभा"},"tags":["health","statistics","outbreak"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"nw-wb-catalog","scope":"network","category":"resource","kind":"source","title":{"en":"World Bank Data Catalog","ne":"विश्व बैंक डाटा सूची"},"org":{"en":"World Bank Group","ne":"विश्व बैंक समूह"},"summary":{"en":"Development indicators, microdata and survey metadata.","ne":"विकास सूचक, माइक्रोडाटा र सर्वेक्षण मेटाडाटा।"},"detail":{"en":"Searchable index of the Bank’s open datasets, including the World Development Indicators and household surveys. Each entry states its licence, coverage and last revision, which is what makes a quoted figure auditable.","ne":"बैंकका खुला डाटासेटहरूको खोजयोग्य अनुक्रमणिका। हरेक प्रविष्टिले इजाजतपत्र, कभरेज र अन्तिम संशोधन बताउँछ, जसले उद्धृत अङ्क लेखापरीक्षणयोग्य बनाउँछ।"},"sourceUrl":"https://datacatalog.worldbank.org","sourceName":"datacatalog.worldbank.org","location":{"en":"Washington, DC","ne":"वासिङ्टन, डीसी"},"tags":["development","indicators","microdata"],"posted":"2026-11-18","verifiedOn":"2026-11-18"}],"categories":[{"id":"resource","label":{"en":"Resource","ne":"स्रोत"},"color":"var(--gold)","count":5}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"en","variant":"section","accent":"var(--cy)","title":{"en":"Open data sources","ne":"खुला डाटा स्रोत"},"subtitle":{"en":"The open data portals behind ACTTOLOG’s Earth, indicators and maps — each linked to the body that publishes it.","ne":"ACTTOLOG को पृथ्वी, सूचक र नक्साहरूका पछाडिका खुला डाटा पोर्टलहरू — प्रत्येक तिनै प्रकाशन गर्ने निकायमा लिङ्क गरिएको।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:48.931Z"},"mof.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:51.114Z"},"mofaga.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:45:23.285Z"},"gorkhapatra.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:24.060Z"},"nea.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:25.358Z"},"ntc.net.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:26.993Z"},"noc.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:28.884Z"},"vacancy.nepalairlines.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:31.583Z"},"epf.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:32.487Z"},"nlk.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:33.201Z"},"ddc.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:46:05.372Z"},"caanepal.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:06.687Z"},"jobs.nrb.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:0