0:{"buildId":"xz5GWcpCVEMXWFCc_VMq7","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"lang":"ne","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],[["$","$L3",null,{"settings":{"brand":"ACTTOLOG","org":"Acttolog","tagline":{"en":"Welcome to Acttolog World","ne":"Acttolog संसारमा स्वागत छ"},"lines":[{"en":"Discover. Learn. Create. Connect.","ne":"खोज्नुहोस्। सिक्नुहोस्। सिर्जना गर्नुहोस्। जोडिनुहोस्।"},{"en":"One World. Endless Possibilities.","ne":"एउटै संसार। असीम सम्भावनाहरू।"},{"en":"Explore the Digital World.","ne":"डिजिटल संसार अन्वेषण गर्नुहोस्।"}],"purpose":{"en":"Acttolog is a digital ecosystem that connects technology, research, education, entertainment, creativity, useful resources, and emerging digital opportunities in one connected world.","ne":"Acttolog एउटा डिजिटल इकोसिस्टम हो जसले प्रविधि, अनुसन्धान, शिक्षा, मनोरञ्जन, सिर्जनशीलता, उपयोगी स्रोत र नयाँ डिजिटल अवसरहरूलाई एउटै जोडिएको संसारमा ल्याउँछ।"},"vision":{"en":"To become a global digital ecosystem where people can easily discover knowledge, technology, entertainment, useful resources, and new opportunities.","ne":"ज्ञान, प्रविधि, मनोरञ्जन, उपयोगी स्रोत र नयाँ अवसरहरू सजिलै भेट्टाउन सकिने विश्वव्यापी डिजिटल इकोसिस्टम बन्ने।"},"mission":{"en":"To make knowledge, technology, research, creativity, entertainment, education, and useful digital resources more accessible by bringing them together through meaningful, practical, and responsible digital experiences.","ne":"ज्ञान, प्रविधि, अनुसन्धान, सिर्जनशीलता, मनोरञ्जन, शिक्षा र उपयोगी डिजिटल स्रोतहरूलाई अर्थपूर्ण, व्यावहारिक र जिम्मेवार डिजिटल अनुभवमार्फत एकसाथ ल्याई सबैका लागि सहज बनाउने।"},"values":["Innovation","Accessibility","Knowledge & Learning","Creativity","Technology","Trust & Transparency","Research & Evidence","User Empowerment","Digital Inclusion","Responsible Technology"],"valuesNe":["नवप्रवर्तन","पहुँच","ज्ञान र सिकाइ","सिर्जनशीलता","प्रविधि","विश्वास र पारदर्शिता","अनुसन्धान र प्रमाण","प्रयोगकर्ता सशक्तीकरण","डिजिटल समावेशीकरण","जिम्मेवार प्रविधि"],"story":{"en":"Acttolog began as a single question: why are research support, learning, creative media, useful tools and new digital opportunities scattered across so many disconnected places? Acttolog is the answer being built — one connected world where each division supports the others. Research informs the Academy, the Academy feeds creativity, creativity produces media and games, and Darkroom keeps the whole world supplied with verified tools and resources.\n\nActtolog is global from launch: English and नेपाली, NPR and USD, resources for Nepal and for international users. Nothing here invents a founding date, founder biography, awards, clients, investors or partnerships — the story grows as the ecosystem grows, and every word is editable in the CMS.","ne":"Acttolog एउटै प्रश्नबाट सुरु भयो: अनुसन्धान सहयोग, सिकाइ, सिर्जनशील मिडिया, उपयोगी औजार र नयाँ डिजिटल अवसरहरू किन यति धेरै छुट्टाछुट्टै ठाउँमा छरिएका छन्? Acttolog त्यसको उत्तर हो — एउटा जोडिएको संसार जहाँ प्रत्येक विभागले अर्कोलाई सहयोग गर्छ। अनुसन्धानले एकेडेमीलाई दिशा दिन्छ, एकेडेमीले सिर्जनशीलता जन्माउँछ, सिर्जनशीलताले मिडिया र खेल बनाउँछ, र डार्करूमले सम्पूर्ण संसारलाई प्रमाणित औजारले भरिरहन्छ।\n\nActtolog सुरुवातदेखि नै विश्वव्यापी छ: अङ्ग्रेजी र नेपाली, रु र USD, नेपाल र अन्तर्राष्ट्रिय दुवैका लागि स्रोतहरू।"},"future":{"en":"New divisions can be added through the CMS without redesigning the world: new research programmes, media formats, game projects, resource collections and commerce models. The architecture stays editable, migratable and honest — no feature is announced before it works.","ne":"CMS मार्फत नै नयाँ विभाग थप्न सकिन्छ — नयाँ अनुसन्धान कार्यक्रम, मिडिया स्वरूप, खेल परियोजना, स्रोत संग्रह र व्यापार मोडेल। संरचना सधैं सम्पादनयोग्य, स्थानान्तरणयोग्य र इमानदार रहन्छ।"},"responsible":{"en":"Acttolog avoids absolute guarantees, hides nothing behind fake popularity numbers, labels paid placement clearly if it is ever enabled, keeps user profiles private by default, separates analytics from identity, and never presents external information as Acttolog content.","ne":"Acttolog अतिरञ्जित ग्यारेन्टी गर्दैन, नक्कली लोकप्रियता देखाउँदैन, प्रायोजित सामग्री खुलेमा स्पष्ट लेबल लगाउँछ, प्रयोगकर्ता प्रोफाइल निजी राख्छ, एनालिटिक्स र पहिचान छुट्टाउँछ, र बाहिरी जानकारीलाई Acttolog सामग्री भनेर देखाउँदैन।"},"phone":"9802336200","email":"thesynresearch@gmail.com","address":"","usdToNpr":133,"social":{"facebook":"https://www.facebook.com/profile.php?id=61586303026922","instagram":"","youtube":"","tiktok":"","linkedin":"","x":"","github":""},"footerNote":{"en":"Acttolog — one connected digital world.","ne":"Acttolog — एउटै जोडिएको डिजिटल संसार।"},"nlNote":{"en":"Receive Acttolog updates — new resources, courses, research notes and media.","ne":"नयाँ स्रोत, पाठ्यक्रम, अनुसन्धान सामग्री र मिडियाबारे Acttolog अपडेट पाउनुहोस्।"},"respNote":{"en":"Messages are routed to the private admin inbox. Connect an email provider in production to receive notifications.","ne":"सन्देश निजी एडमिन इनबक्समा जान्छ। इमेल प्रदायक जोडेपछि सूचना प्राप्त हुन्छ।"}},"ticker":["BOT CHECK · नेपाल एसबीआई बैंक · बोट चुनौती — जाँचकर्तालाई पृष्ठ दिइएन (HTTP 403 · 302 ms)","NO RESPONSE · दुग्ध विकास संस्थान · पछिल्लो जाँचमा पहुँचयोग्य भएन (timeout after 15s)","NOTICE · तुरुन्त-खेल्ने सूची परिमार्जन","NOTICE · सप्ताहन्तको हेर्ने-सूची परिमार्जन","NOTICE · डिजिटल पुस्तकालय — नेपाल र अन्तर्राष्ट्रिय प्रमाण थपियो","NOTICE · डार्करुममा नयाँ प्रमाणित स्रोत थपियो","NEW · खोज नेपाल","NEW · क्युब/२६","NEW · GOOGLE SCHOLAR","NEW · ZOTERO"],"altLang":{"href":"/","label":"English version","lang":"en"},"verified":{"count":57,"total":62,"date":"2026-11-17T23:48:21.811Z"}}],"$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb"]]}],null,"$Lc"]}],"isPartial":"$@d","staleTime":"$e","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$e","varyParams":null},{"rsc":"$L11","isPartial":"$@12","staleTime":"$e","varyParams":"$13"}],"isUpgradeableISRFallback":false,"a":"$@14","rootVaryParams":null,"needsRuntimeRequest":"$@15"}
