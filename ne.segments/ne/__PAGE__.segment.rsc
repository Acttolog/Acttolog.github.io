403 · 302 ms)"}},{"id":"notice:gm-quick","at":"2026-11-16","kind":"notice","title":{"en":"Quick-play lineup refreshed","ne":"तुरुन्त-खेल्ने सूची परिमार्जन"},"org":{"en":"ACTTOLOG · Games","ne":"ACTTOLOG · खेल"},"route":"/games","ext":false,"color":"var(--mg)","icon":"bell"},{"id":"release:/games/khoja-nepal:2026-10-30","at":"2026-10-30","kind":"release","title":{"en":"Khoja Nepal","ne":"खोज नेपाल"},"route":"/games/khoja-nepal","ext":false,"color":"var(--ok)","icon":"game"},{"id":"release:/games/cube-26:2026-10-29","at":"2026-10-29","kind":"release","title":{"en":"CUBE/26","ne":"क्युब/२६"},"route":"/games/cube-26","ext":false,"color":"var(--ok)","icon":"game"}],"sources":{"items":[{"id":"psc","name":{"en":"Public Service Commission (Loksewa Ayog)","ne":"लोक सेवा आयोग"},"host":"psc.gov.np","url":"https://psc.gov.np/category/notice","status":"reachable","httpStatus":200,"ms":107,"checkedAt":"2026-11-17T23:44:47.525Z","lastVerifiedOn":"2026-11-18"},{"id":"psconline1-psc","name":{"en":"PSC Online — Loksewa application portal","ne":"लोक सेवा अनलाइन — आवेदन पोर्टल"},"host":"psconline1.psc.gov.np","url":"https://psconline1.psc.gov.np","status":"reachable","httpStatus":200,"ms":56,"checkedAt":"2026-11-17T23:48:13.804Z","lastVerifiedOn":"2026-11-18"},{"id":"gorkhapatra","name":{"en":"Gorkhapatra — the official gazette","ne":"गोरखापत्र — आधिकारिक राजपत्र"},"host":"gorkhapatra.org.np","url":"https://gorkhapatra.org.np","status":"reachable","httpStatus":200,"ms":174,"checkedAt":"2026-11-17T23:45:24.060Z","lastVerifiedOn":"2026-11-18"},{"id":"jobs-nrb","name":{"en":"Nepal Rastra Bank (central bank)","ne":"नेपाल राष्ट्र बैंक (केन्द्रीय बैंक)"},"host":"jobs.nrb.org.np","url":"https://jobs.nrb.org.np","status":"reachable","httpStatus":200,"ms":96,"checkedAt":"2026-11-17T23:46:07.392Z","lastVerifiedOn":"2026-11-18"},{"id":"moha","name":{"en":"Ministry of Home Affairs","ne":"गृह मन्त्रालय"},"host":"moha.gov.np","url":"https://moha.gov.np","status":"reachable","httpStatus":200,"ms":797,"checkedAt":"2026-11-17T23:44:48.931Z","lastVerifiedOn":"2026-11-18"},{"id":"nea","name":{"en":"Nepal Electricity Authority","ne":"नेपाल विद्युत् प्राधिकरण"},"host":"nea.org.np","url":"https://nea.org.np/en","status":"reachable","httpStatus":200,"ms":693,"checkedAt":"2026-11-17T23:45:25.358Z","lastVerifiedOn":"2026-11-18"}],"meta":{"compiledAt":"2026-11-17T23:48:21.811Z","checked":62,"reachable":57,"unreachable":4,"note":{"en":"Automated reachability check of official portals, run at build time by tools/research-sources.js — not a live government vacancy feed. A reachable row only means the portal answered our HTTPS request at the recorded moment; it says nothing about current vacancies. \"Bot check\" means the server returned a WAF or JavaScript challenge instead of the page, so we could not verify it. Where a server sends an incomplete certificate chain we complete it from the certificate's own AIA record and still verify against the standard root store. Always open the official site and verify the current notice, dates and eligibility before applying.","ne":"tools/research-sources.js ले बिल्ड समयमा चलाएको आधिकारिक पोर्टलहरूको स्वचालित पहुँच जाँच — प्रत्यक्ष सरकारी पदपूर्ति फिड होइन। पहुँचयोग्य पङ्क्तिले रेकर्ड गरिएको क्षणमा पोर्टलले हाम्रो HTTPS अनुरोधको जवाफ दियो भन्ने मात्र बुझाउँछ; हालको पदपूर्तिबारे केही भन्दैन। \"बोट जाँच\" भन्नाले सर्भरले पृष्ठको सट्टा WAF वा जाभास्क्रिप्ट चुनौती फर्कायो, त्यसैले हामीले जाँच्न सकेनौँ। सर्भरले अपुरो प्रमाणपत्र साङ्लो पठाएमा हामी त्यसकै AIA रेकर्डबाट पूरा गर्छौँ र मानक रुट स्टोरविरुद्ध जाँच्छौँ। आवेदन दिनुअघि आधिकारिक साइट खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्।"}}},"quick":[{"title":{"en":"Snake Himalaya","ne":"स्नेक हिमालय"},"thumb":"/media/arcade/thumbs/snake-himalaya.jpg","url":"/arcade/index.html?game=snake-himalaya","tag":"Arcade"},{"title":{"en":"Himalaya Breakout","ne":"हिमालय ब्रेकआउट"},"thumb":"/media/arcade/thumbs/himalaya-breakout.jpg","url":"/arcade/index.html?game=himalaya-breakout","tag":"Arcade"},{"title":{"en":"Danphe Flight","ne":"डाँफे उडान"},"thumb":"/media/arcade/thumbs/danphe-flight.jpg","url":"/arcade/index.html?game=danphe-flight","tag":"Arcade"},{"title":{"en":"Memory Nepal","ne":"मेमोरी नेपाल"},"thumb":"/media/arcade/thumbs/memory-nepal.jpg","url":"/arcade/index.html?game=memory-nepal","tag":"Puzzle"},{"title":{"en":"Himalaya Stack","ne":"हिमालय स्ट्याक"},"thumb":"/media/arcade/thumbs/himalaya-stack.jpg","url":"/arcade/index.html?game=himalaya-stack","tag":"Arcade"},{"title":{"en":"Ludo Himalaya","ne":"लुडो हिमालय"},"thumb":"/media/arcade/thumbs/ludo-himalaya.jpg","url":"/arcade/index.html?game=ludo-himalaya","tag":"Board"}],"offer":{"title":{"en":"Thesyn Gold","ne":"थेसिन गोल्ड"},"short":{"en":"Complete project support with scheduled reviews.","ne":"तालिकाबद्ध समीक्षासहित पूर्ण परियोजना सहयोग।"},"npr":30000,"usd":225,"slug":"thesyn-gold"},"loksewa":{"papers":4,"subjects":17,"points":171,"questions":14},"guide":{"places":32,"regions":12},"notices":{"items":[{"id":"lk-practice","scope":"loksewa","category":"exam","kind":"notice","title":{"en":"Free officer-level practice test — current set","ne":"निःशुल्क अधिकृत-तह अभ्यास परीक्षण — हालको सेट"},"org":{"en":"ACTTOLOG · Loksewa Ghar","ne":"ACTTOLOG · लोकसेवा घर"},"summary":{"en":"Negative-marking mock with instant score and explanations. Runs in your browser — no account, nothing sent anywhere.","ne":"नकारात्मक घटाइसहितको नक्कली परीक्षण, तुरुन्त नतिजा र व्याख्या। ब्राउजरमै चल्छ — खाता चाहिँदैन, कतै पठाइँदैन।"},"detail":{"en":"The current practice set is available through the end of this cycle and is refreshed from the syllabus points listed in the house. Your result and checklist stay on this device only.","ne":"हालको अभ्यास सेट यो चक्रको अन्त्यसम्म उपलब्ध छ र घरमा सूचीबद्ध पाठ्यबुँदाबाट परिमार्जन हुन्छ। तपाईंको नतिजा र चेकलिस्ट यही यन्त्रमा मात्र बस्छ।"},"sourceUrl":"/loksewa#lk-test","sourceName":"Loksewa Ghar","tags":["practice","mock","free"],"posted":"2026-11-01","verifiedOn":"2026-11-17","closesOn":"2026-12-31","featured":true},{"id":"lk-downloads","scope":"loksewa","category":"exam","kind":"notice","title":{"en":"Syllabus map, 12-week planner & law list — free PDF","ne":"पाठ्यक्रम नक्सा, १२-हप्ते योजना र कानून सूची — निःशुल्क PDF"},"org":{"en":"ACTTOLOG · Loksewa Ghar","ne":"ACTTOLOG · लोकसेवा घर"},"summary":{"en":"Print-ready documents built from the real folder tree: every paper, subject, folder and point, plus the rank-first plan.","ne":"वास्तविक फोल्डर संरचनाबाट बनेका छाप-तयार कागज: हरेक पेपर, विषय, फोल्डर र बुँदा, साथै रैंक-प्रथम योजना।"},"detail":{"en":"The download centre builds its documents from the real syllabus folder tree, so every paper, subject, folder and point in the PDF matches the syllabus map on this site. The files are free, print-ready and generated here — no third-party mirror and no sign-up.","ne":"डाउनलोड केन्द्रले दस्तावेज वास्तविक पाठ्यक्रम फोल्डर संरचनाबाट बनाउँछ, त्यसैले PDF मा भएको प्रत्येक प्रश्नपत्र, विषय, फोल्डर र बुँदा यसै साइटको पाठ्यक्रम नक्सासँग मिल्छ। फाइलहरू निःशुल्क, छाप्न तयार र यहीं बनाइएका हुन् — तेस्रो पक्षको मिरर छैन, दर्ता पनि चाहिँदैन।"},"sourceUrl":"/loksewa/downloads","sourceName":"Loksewa Ghar","tags":["pdf","syllabus","planner","free"],"posted":"2026-11-10","verifiedOn":"2026-11-17","featured":true},{"id":"rs-ugc","scope":"research","category":"government","kind":"source","title":{"en":"University Grants Commission Nepal","ne":"विश्वविद्यालय अनुदान आयोग नेपाल"},"org":{"en":"Government body","ne":"सरकारी निकाय"},"summary":{"en":"Research grants, fellowships and faculty-development notices for universities and researchers.","ne":"विश्वविद्यालय र अनुसन्धानकर्ताका लागि अनुसन्धान अनुदान, फेलोसिप र प्राध्यापक-विकास सूचना।"},"detail":{"en":"The University Grants Commission funds Nepali universities and researchers. Its notices carry research grants, fellowships, doctoral support and faculty-development calls, each with its own eligibility and deadline. These are competitive awards administered by the Commission, not Loksewa vacancies, so the application route is the Commission’s own call document.","ne":"विश्वविद्यालय अनुदान आयोगले नेपालका विश्वविद्यालय र अनुसन्धानकर्तालाई अनुदान दिन्छ। यसका सूचनामा अनुसन्धान अनुदान, फेलोसिप, विद्यावारिधि सहयोग र प्राध्यापक विकासका आह्वान आउँछन्, प्रत्येकको छुट्टै योग्यता र अन्तिम मिति हुन्छ। यी आयोग आफैंले सञ्चालन गर्ने प्रतिस्पर्धात्मक पुरस्कार हुन्, लोक सेवाका रिक्त पद होइनन्, त्यसैले आवेदनको बाटो आयोगकै आह्वान दस्तावेज हो।"},"sourceUrl":"https://ugc.gov.np","sourceName":"ugc.gov.np","location":{"en":"Bhaktapur","ne":"भक्तपुर"},"tags":["grant","fellowship","research"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"en-premiere","scope":"entertainment","category":"release","kind":"notice","title":{"en":"Nepal Series — new screening live","ne":"नेपाल सिरिज — नयाँ प्रदर्शनी live"},"org":{"en":"ACTTOLOG · Entertainment","ne":"ACTTOLOG · मनोरञ्जन"},"summary":{"en":"A new featured screening is now streaming in the Entertainment hall. Open the hall to watch.","ne":"नयाँ विशेष प्रदर्शनी अब मनोरञ्जन हलमा स्ट्रिम हुँदैछ। हेर्न हल खोल्नुहोस्।"},"detail":{"en":"Open the hall to watch the featured screening. Each title in the hall has its own page with the release date and the category it belongs to, and the Nepal Series titles are ACTTOLOG’s own productions rather than embedded third-party uploads.","ne":"विशेष प्रदर्शन हेर्न हल खोल्नुहोस्। हलको प्रत्येक शीर्षकको छुट्टै पृष्ठ हुन्छ, जसमा प्रकाशन मिति र त्यो पर्ने श्रेणी हुन्छ, र नेपाल सिरिजका शीर्षक तेस्रो पक्षको अपलोड होइनन् — एक्टोलग आफ्नै निर्माण हुन्।"},"sourceUrl":"/entertainment","sourceName":"Entertainment","tags":["screening","nepal series","featured"],"posted":"2026-11-14","verifiedOn":"2026-11-17","featured":true},{"id":"gm-launch","scope":"games","category":"release","kind":"notice","title":{"en":"Nepal Series game — now playable","ne":"नेपाल सिरिज खेल — अब खेल्न मिल्ने"},"org":{"en":"ACTTOLOG · Games","ne":"ACTTOLOG · खेल"},"summary":{"en":"A new Nepal-themed game is live in the arcade. Launch instantly — no account, plays on mobile.","ne":"नयाँ नेपाल-थिमको खेल आर्केडमा live छ। तुरुन्त सुरु — खाता चाहिँदैन, मोबाइलमा चल्छ।"},"detail":{"en":"The arcade runs entirely in the browser: no account, no install and no download. Nepal Series games are original builds with touch controls, so the same link plays on a phone and on a desktop.","ne":"आर्केड पूरै ब्राउजरमा चल्छ: खाता चाहिँदैन, इन्स्टल गर्नुपर्दैन, डाउनलोड पनि छैन। नेपाल सिरिजका खेल मौलिक निर्माण हुन् र टच नियन्त्रण छन्, त्यसैले एउटै लिंक फोन र डेस्कटप दुवैमा खेल्न सकिन्छ।"},"sourceUrl":"/games","sourceName":"Games","tags":["arcade","nepal series","mobile"],"posted":"2026-11-13","verifiedOn":"2026-11-17","featured":true}],"categories":[{"id":"government","label":{"en":"Government","ne":"सरकारी"},"color":"var(--cy)","count":1},{"id":"exam","label":{"en":"Exam","ne":"परीक्षा"},"color":"var(--ok)","count":2},{"id":"release","label":{"en":"Release","ne":"रिलिज"},"color":"var(--mg)","count":2}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:48.931Z"},"mof.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:51.114Z"},"mofaga.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:45:23.285Z"},"gorkhapatra.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:24.060Z"},"nea.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:25.358Z"},"ntc.net.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:26.993Z"},"noc.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:28.884Z"},"vacancy.nepalairlines.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:31.583Z"},"epf.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:32.487Z"},"nlk.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:33.201Z"},"ddc.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:46:05.372Z"},"caanepal.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:06.687Z"},"jobs.nrb.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:07.392Z"},"nepalbank.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:08.554Z"},"rbb.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:09.528Z"},"vacancy.adbl.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:10.266Z"},"nabilbank.com":{"status":"reachable","checkedAt":"2026-11-17T23:46:12.019Z"},"globalimebank.com":{"status":"reachable","checkedAt":"2026-11-17T23:46:12.756Z"},"nicasiabank.com":{"status":"reachable","checkedAt":"2026-11-17T23:46:13.435Z"},"everestbankltd.com"