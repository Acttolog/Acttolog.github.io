28:[["$","title","0",{"children":"प्रशासनिक योग्यता — पाठ्यक्रम र चेकलिस्ट — लोकसेवा घर (प्रिन्ट/PDF) | ACTTOLOG"}],["$","meta","1",{"name":"description","content":"पहिलो पेपरले पाँच परिवारमा गति र शुद्धता नाप्छ: भूगोल, इतिहास-राजनीति र अर्थतन्त्र, विज्ञान-प्रविधि, मानसिक क्षमता, र भाषा। सही उत्तरमा एक अङ्क, गलतमा त्यसको पाँचौं भाग घट्छ — त्यसैले अनुमान तालिम लिनुपर्ने सीप हो, बानी होइन।"}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","meta","3",{"name":"robots","content":"noindex, follow"}],["$","link","4",{"rel":"canonical","href":"https://acttolog.github.io/loksewa/print/aptitude"}],["$","meta","5",{"property":"og:title","content":"ACTTOLOG — Research, Learning, Media & Games from Nepal"}],["$","meta","6",{"property":"og:description","content":"ACTTOLOG joins thesis and research support, courses, verified resources, stories and games into one bilingual world built in Nepal. Start the descent."}],["$","meta","7",{"property":"og:url","content":"https://acttolog.github.io"}],["$","meta","8",{"property":"og:site_name","content":"ACTTOLOG"}],["$","meta","9",{"property":"og:locale","content":"en_US"}],["$","meta","10",{"property":"og:image","content":"https://acttolog.github.io/media/og-home.jpg"}],["$","meta","11",{"property":"og:image:width","content":"1200"}],["$","meta","12",{"property":"og:image:height","content":"630"}],["$","meta","13",{"property":"og:image:alt","content":"ACTTOLOG — Research, Learning, Media & Games from Nepal"}],["$","meta","14",{"property":"og:type","content":"website"}],["$","meta","15",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","16",{"name":"twitter:title","content":"ACTTOLOG — Research, Learning, Media & Games from Nepal"}],["$","meta","17",{"name":"twitter:description","content":"ACTTOLOG joins thesis and research support, courses, verified resources, stories and games into one bilingual world built in Nepal. Start the descent."}],["$","meta","18",{"name":"twi