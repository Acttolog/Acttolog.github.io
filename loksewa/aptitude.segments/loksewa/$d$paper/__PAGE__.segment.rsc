9:["$","section",null,{"className":"sec lksec","children":["$","div",null,{"className":"wrap lk-two","children":[["$","$L4",null,{"children":["$","$L17",null,{"questions":[{"paper":"aptitude","q":{"en":"In a series 5, 11, 23, 47, ▢ — which number continues it?","ne":"5, 11, 23, 47, ▢ शृङ्खलामा अर्को सङ्ख्या के हुन्छ?"},"options":[{"en":"95","ne":"९५"},{"en":"96","ne":"९६"},{"en":"94","ne":"९४"},{"en":"99","ne":"९९"}],"answer":0,"explain":{"en":"Each term is double the previous plus one: 47 × 2 + 1 = 95.","ne":"हरेक पद अघिल्लोको दोब्बरमा एक जोड: ४७ × २ + १ = ९५।"}},{"paper":"aptitude","q":{"en":"Which river system is the largest of Nepal by basin?","ne":"नेपालको सिन्धु जलाधार क्षेत्रमा सबैभन्दा ठूलो कुन?"},"options":[{"en":"Gandaki","ne":"गण्डकी"},{"en":"Koshi","ne":"कोशी"},{"en":"Karnali","ne":"कर्णाली"},{"en":"Mahanadi","ne":"महानदी"}],"answer":1,"explain":{"en":"The Koshi system drains the largest area of the country's rivers.","ne":"कोशी प्रणालीले देशका नदीहरूमध्ये सबैभन्दा बढी क्षेत्र पानी निकास गर्छ।"}},{"paper":"aptitude","q":{"en":"Nepali: which word is spelled correctly?","ne":"कुन शब्दको हिज्जे सही छ?"},"options":[{"en":"सुशासन","ne":"सुशासन"},{"en":"सुशाशन","ne":"सुशाशन"},{"en":"सुस्शासन","ne":"सुस्शासन"},{"en":"सुशासन्","ne":"सुशासन्"}],"answer":0,"explain":{"en":"Good governance is सुशासन.","ne":"सुशासन नै सही रूप हो।"}},{"paper":"aptitude","q":{"en":"The Constitution of Nepal was promulgated in which Bikram Sambat year?","ne":"नेपालको संविधान कुन वि.सं. मा जारी भयो?"},"options":[{"en":"2062","ne":"२०६२"},{"en":"2063","ne":"२०६३"},{"en":"2072","ne":"२०७२"},{"en":"2074","ne":"२०७४"}],"answer":2,"explain":{"en":"19 September 2015, which is 3 Aswin 2072.","ne":"२०७२ असोज ३ गते (१९ सेप्टेम्बर २०१५)।"}},{"paper":"aptitude","q":{"en":"A shop marks an item 20% above cost and then gives a 10% discount. What is the profit percent on cost?","ne":"एक पसलेले वस्तु लागतभन्दा २०% बढीमा राखेर १०% छुट दिन्छ। लागतमा नाफा कति प्रतिशत?"},"options":[{"en":"8%","ne":"८%"},{"en":"10%","ne":"१०%"},{"en":"12%","ne":"१२%"},{"en":"18%","ne":"१८%"}],"answer":0,"explain":{"en":"1.20 × 0.90 = 1.08, so 8% profit.","ne":"१.२० × ०.९० = १.०८, अर्थात् ८% नाफा।"}},{"paper":"aptitude","q":{"en":"Choose the correct preposition: The report was submitted ___ the deadline.","ne":"सही पूर्ियोजन छान्नुहोस्: The report was submitted ___ the deadline."},"options":[{"en":"in","ne":"in"},{"en":"on","ne":"on"},{"en":"at","ne":"at"},{"en":"by","ne":"by"}],"answer":3,"explain":{"en":"\"By the deadline\" means not later than it.","ne":"by the deadline को अर्थ त्यसभन्दा पछि होइन।"}}],"paperLabel":{"en":"Administration Aptitude","ne":"प्रशासनिक योग्यता"}}]}],["$","$L4",null,{"delay":60,"children":["$","$L18",null,{"units":[{"key":"aptitude/geography/physical","label":{"en":"Physical set-up","ne":"भौतिक संरचना"},"href":"/loksewa/aptitude/geography"},{"key":"aptitude/geography/human","label":{"en":"Population and settlement","ne":"जनसंख्या र बस्ती"},"href":"/loksewa/aptitude/geography"},{"key":"aptitude/geography/resources","label":{"en":"Resources and economy of place","ne":"स्रोत र स्थानको अर्थतन्त्र"},"href":"/loksewa/aptitude/geography"},{"key":"aptitude/geography/world","label":{"en":"World geography basics","ne":"विश्व भूगोलको आधार"},"href":"/loksewa/aptitude/geography"},{"key":"aptitude/polity/history","label":{"en":"Nepal's modern history","ne":"नेपालको आधुनिक इतिहास"},"href":"/loksewa/aptitude/polity"},{"key":"aptitude/polity/constitution","label":{"en":"Constitution as polity","ne":"राजनीतिको आधार संविधान"},"href":"/loksewa/aptitude/polity"},{"key":"aptitude/polity/economy","label":{"en":"Economy in one page","ne":"एक पृष्ठको अर्थतन्त्र"},"href":"/loksewa/aptitude/polity"},{"key":"aptitude/polity/institutions","label":{"en":"State institutions","ne":"राज्यका निकाय"},"href":"/loksewa/aptitude/polity"},{"key":"aptitude/sciencetech/everyday","label":{"en":"Everyday science","ne":"दैनिक विज्ञान"},"href":"/loksewa/aptitude/sciencetech"},{"key":"aptitude/sciencete