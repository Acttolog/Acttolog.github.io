24:["$","$L35",null,{"packages":[{"id":"pk1","name":"Silver","tagline":{"en":"Essential support","ne":"आवश्यक सहयोग"},"npr":25000,"usd":190,"interval":{"en":"per project","ne":"प्रति परियोजना"},"desc":{"en":"One chapter, one analysis or one structured consultation block, scoped in writing before work begins.","ne":"एउटा अध्याय, एउटा विश्लेषण वा एउटा संरचित परामर्श ब्लक — काम सुरु हुनुअघि लिखित कार्यक्षेत्रसहित।"},"features":[{"en":"Single deliverable scope","ne":"एकल डेलिभरेबल कार्यक्षेत्र"},{"en":"Methodology review","ne":"विधि समीक्षा"},{"en":"One revision cycle","ne":"एक संशोधन चक्र"},{"en":"Referencing consistency check","ne":"सन्दर्भ एकरूपता जाँच"},{"en":"Email support","ne":"इमेल सहयोग"}],"discount":0,"validUntil":"2026-11-05","accent":"#c9d4e5","mode":"inquiry","status":"published","audience":"global","popular":false,"terms":{"en":"Deliverable, timeline and revision count are confirmed in the written scope.","ne":"डेलिभरेबल, समयसीमा र संशोधन सङ्ख्या लिखित कार्यक्षेत्रमा तय हुन्छ।"}},{"id":"pk2","name":"Gold","tagline":{"en":"Complete project support","ne":"पूर्ण परियोजना सहयोग"},"npr":60000,"usd":450,"interval":{"en":"per project","ne":"प्रति परियोजना"},"desc":{"en":"Planning, analysis and writing structure across the whole project, with analysis files handed over at the end.","ne":"सम्पूर्ण परियोजनाभर योजना, विश्लेषण र लेखन संरचना, अन्त्यमा विश्लेषण फाइल हस्तान्तरणसहित।"},"features":[{"en":"Multi-chapter scope","ne":"बहु-अध्याय कार्यक्षेत्र"},{"en":"Research design workshop","ne":"अनुसन्धान डिजाइन कार्यशाला"},{"en":"Data analysis and diagnostics","ne":"डाटा विश्लेषण र डायग्नोस्टिक्स"},{"en":"Three revision cycles","ne":"तीन संशोधन चक्र"},{"en":"Scheduled review sessions","ne":"तालिकाबद्ध समीक्षा बैठक"},{"en":"Priority support","ne":"प्राथमिकता सहयोग"}],"discount":15,"validUntil":"2026-10-21","accent":"#f5c26b","mode":"both","status":"published","audience":"global","popular":false,"terms":{"en":"Includes one handover walkthrough so every decision can be defended.","ne":"एक हस्तान्तरण वॉकथ्रु समावेश — हरेक निर्णय प्रस्ट पार्न सकिने गरी।"}},{"id":"pk3","name":"Diamond","tagline":{"en":"Full research programme","ne":"पूर्ण अनुसन्धान कार्यक्रम"},"npr":120000,"usd":900,"interval":{"en":"per programme","ne":"प्रति कार्यक्रम"},"desc":{"en":"Proposal to final document, reproducible analysis handover, viva preparation and Academy access included.","ne":"प्रस्तावदेखि अन्तिम कागजातसम्म, पुनरुत्पादनयोग्य विश्लेषण हस्तान्तरण, भाइभा तयारी र एकेडेमी पहुँच समावेश।"},"features":[{"en":"Proposal to final document","ne":"प्रस्तावदेखि अन्तिम कागजातसम्म"},{"en":"Reproducible analysis handover","ne":"पुनरुत्पादनयोग्य विश्लेषण हस्तान्तरण"},{"en":"Unlimited revision cycles in term","ne":"अवधिभित्र असीमित संशोधन"},{"en":"Viva preparation session","ne":"भाइभा तयारी बैठक"},{"en":"Academy access included","ne":"एकेडेमी पहुँच समावेश"},{"en":"Dedicated contact channel","ne":"समर्पित सम्पर्क च्यानल"}],"discount":20,"validUntil":"2026-11-20","accent":"#8ce9ff","mode":"both","status":"published","audience":"global","popular":false,"terms":{"en":"Programme length and milestones are agreed in the written scope.","ne":"कार्यक्रम अवधि र माइलस्टोन लिखित कार्यक्षेत्रमा सहमत हुन्छ।"}}],"faq":[{"q":{"en":"Which programmes do you support?","ne":"कुन कार्यक्रममा सहयोग गर्नुहुन्छ?"},"a":{"en":"Research-based programmes including MBS, MBA, MPA and MA, plus other programmes with a dissertation or research report. Support is described as guidance and experience, not university affiliation.","ne":"MBS, MBA, MPA र MA सहितका अनुसन्धानमा आधारित कार्यक्रम, साथै थेसिस वा प्रतिवेदन भएका अन्य कार्यक्रम। सहयोगलाई मार्गदर्शन र अनुभव मानिन्छ, आधिकारिक सम्बन्ध होइन।"}},{"q":{"en":"Which analysis tools are supported?","ne":"कुन विश्लेषण औजारमा सहयोग छ?"},"a":{"en":"SPSS, STATA, EViews and Excel, chosen according to the research design and data structure.","ne":"अनुसन्धान डिजाइन र डाटा संरचनाअनुसार SPSS, STATA, EViews र Excel।"}},{"q":{"en":"Do you guarantee plagiarism-free work?","ne":"प्लेजरिजम-मुक्त कार्यको ग्यारेन्टी छ?"},"a":{"en":"No absolute guarantee is advertised. Manual academic quality review, similarity checking, AI-related checking and citation checking are performed and findings are reported honestly.","ne":"कुनै निश्चित ग्यारेन्टी दिइँदैन। म्यानुअल समीक्षा, सिमिलारिटी जाँच, एआई सम्बन्धी जाँच र उद्धरण जाँच गरिन्छ र नतिजा इमानदारीपूर्वक भनिन्छ।"}},{"q":{"en":"How does an engagement start?","ne":"कार्य कसरी सुरु हुन्छ?"},"a":{"en":"Send the topic, deadline, institutional format and work done so far. You receive a written scope before any work begins.","ne":"विषय, समयसीमा, संस्थागत ढाँचा र भएका कार्य पठाउनुहोस्। काम सुरु हुनुअघि लिखित कार्यक्षेत्र पठाइन्छ।"}},{"q":{"en":"Is viva preparation included?","ne":"भाइभा तयारी समावेश छ?"},"a":{"en":"Yes — question framing, defence of methodology and analysis choices, and structure for confident answers.","ne":"हो — प्रश्न तयारी, विधि र विश्लेषण छनोटको बचाउ, र स्पष्ट उत्तरको संरचनासहित।"}}]}]
