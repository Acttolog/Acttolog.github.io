4a:["$","section",null,{"className":"lab-plate","aria-labelledby":"deal-h","children":[["$","h2",null,{"id":"deal-h","children":["$","$L23",null,{"value":{"en":"What this page gave up","ne":"यस पृष्ठले के त्याग्यो"}}]}],["$","p",null,{"className":"lab-body","children":["$","$L23",null,{"value":{"en":"It replaced a neon-glass bento of feature tiles with a cast spec sheet: the eyebrow above the headline, the gradient text, the glow behind the hero and the icon seated in a coloured chip are all gone, because a tile grid of eight assertions is the shape every model reaches for, and a spec table says the same things in a form a site office would recognise.","ne":"नियोन-ग्लास बेन्टो टायलको सट्टा कास्ट स्पेड सिट राखिएको छ — हेडलाइन माथिको eyebrow, ग्रेडियन्ट टेक्स्ट, हिरो पछाडिको ग्लो र रङ चिपभित्रको आइकन हटाइयो।"}}]}],["$","div",null,{"className":"lab-meta","style":{"marginTop":20},"children":[["$","div",null,{"children":[["$","b",null,{"children":"8 → 0"}],["$","span",null,{"className":"lab-label","children":["$","$L23",null,{"value":{"en":"sloplint FAIL on this route","ne":"यस रूटको sloplint FAIL"}}]}]]}],["$","div",null,{"children":[["$","b",null,{"children":"11 → 0"}],["$","span",null,{"className":"lab-label","children":["$","$L23",null,{"value":{"en":"REFLEX, spacing off the 4px scale","ne":"REFLEX, 4px स्केलबाहिरको स्पेसिङ"}}]}]]}],["$","div",null,{"children":[["$","b",null,{"children":"0"}],["$","span",null,{"className":"lab-label","children":["$","$L23",null,{"value":{"en":"bytes of JavaScript added","ne":"थपिएको JavaScript"}}]}]]}]]}],["$","p",null,{"className":"lab-body","style":{"marginTop":20},"children":["$","$L1a",null,{"href":"/nepal","className":"lab-link","children":["$","$L23",null,{"value":{"en":"See the same content in Nepali","ne":"यही सामग्री नेपालीमा हेर्नुहोस्"}}]}]}]]}]
