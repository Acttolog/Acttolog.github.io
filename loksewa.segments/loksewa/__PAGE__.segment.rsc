6:["$","section",null,{"className":"sec nb-sec","id":"lk-notices","children":["$","div",null,{"className":"wrap","children":["$","$L18",null,{"children":["$","$L19",null,{"notices":[{"id":"lk-psc","scope":"loksewa","category":"government","kind":"source","title":{"en":"Public Service Commission (Loksewa Ayog)","ne":"लोक सेवा आयोग"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"All civil-service vacancy advertisements — Section Officer and below — plus exam notices, admit cards and results.","ne":"शाखा अधिकृत र सोभन्दा तलका सबै पदपूर्ति विज्ञापन, परीक्षा सूचना, प्रवेशपत्र र नतिजा।"},"detail":{"en":"The Commission is the constitutional body that recruits for the civil service. Open and inclusive competitive advertisements are published here and in Gorkhapatra. Applications are submitted through the Commission's online portal.","ne":"आयोग निजामती सेवामा पदपूर्ति गर्ने संवैधानिक निकाय हो। खुला र समावेशी प्रतिस्पर्धात्मक विज्ञापन यहाँ र गोरखापत्रमा प्रकाशित हुन्छन्। आवेदन आयोगको अनलाइन पोर्टलबाट दिइन्छ।"},"sourceUrl":"https://psc.gov.np/category/notice","sourceName":"psc.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["civil service","officer","advertisement"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"lk-moha","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Home Affairs","ne":"गृह मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Civil Service Act and Rules, departmental process, and vacancy notices for bodies under the Ministry.","ne":"निजामती सेवा ऐन र नियमावली, विभागीय कारबाही, र मन्त्रालय अन्तर्गतका निकायका पदपूर्ति सूचना।"},"sourceUrl":"https://moha.gov.np","sourceName":"moha.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["act","regulation","administration"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-mof","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Finance","ne":"अर्थ मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Finance-group posts, treasury and revenue notices, budget documents and economic surveys referenced in the exam.","ne":"अर्थ समूहका पद, कोष तथा राजस्व सूचना, बजेट दस्तावेज र परीक्षामा सन्दर्भ हुने आर्थिक सर्वेक्षण।"},"sourceUrl":"https://mof.gov.np","sourceName":"mof.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["finance","budget","revenue"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-mofaga","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Federal Affairs & General Administration","ne":"सङ्घीय मामिला तथा सामान्य प्रशासन मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Provincial and local-level service notices, general administration circulars and civil-service reform updates.","ne":"प्रदेश र स्थानीय तहका सेवा सूचना, सामान्य प्रशासन परिपत्र र निजामती सुधार अपडेट।"},"sourceUrl":"https://mofaga.gov.np","sourceName":"mofaga.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["local level","provincial","administration"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-gorkhapatra","scope":"loksewa","category":"government","kind":"source","title":{"en":"Gorkhapatra — the official gazette","ne":"गोरखापत्र — आधिकारिक राजपत्र"},"org":{"en":"Gorkhapatra Sansthan","ne":"गोरखापत्र संस्थान"},"summary":{"en":"Every government vacancy is legally published here first. The daily carries advertisements from all ministries, departments and public bodies.","ne":"हरेक सरकारी पदपूर्ति कानुनी रूपमा पहिले यहीँ प्रकाशित हुन्छ। दैनिकले सबै मन्त्रालय, विभाग र सार्वजनिक निकायका विज्ञापन छापछ।"},"detail":{"en":"When a notice says 'as published in Gorkhapatra', this is the source of record. Read the advertisement number and date, then apply through the body named in it.","ne":"कुनै सूचनामा 'गोरखापत्रमा प्रकाशित भए बमोजिम' भनिएको छ भने यही आधिकारिक स्रोत हो। विज्ञापन नम्बर र मिति पढेर