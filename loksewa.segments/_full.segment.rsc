29:["$","section",null,{"className":"sec lksec","id":"lk-test","children":["$","div",null,{"className":"wrap","children":[["$","$L31",null,{"children":[["$","h2",null,{"className":"h2","children":"अभ्यास, र कहाँ बाँकी छ देख्नुहोस्"}],["$","p",null,{"className":"lead mt-4","children":"तलको परीक्षण तुरुन्त चल्छ। नतिजा र चेकलिस्ट तपाईंको ब्राउजरमा मात्र बस्छ — कतै पठाइँदैन, खाता पनि चाहिँदैन।"}]]}],["$","div",null,{"className":"lk-two","children":[["$","$L31",null,{"children":["$","$L3e",null,{"questions":[{"paper":"aptitude","q":{"en":"In a series 5, 11, 23, 47, ▢ — which number continues it?","ne":"5, 11, 23, 47, ▢ शृङ्खलामा अर्को सङ्ख्या के हुन्छ?"},"options":[{"en":"95","ne":"९५"},{"en":"96","ne":"९६"},{"en":"94","ne":"९४"},{"en":"99","ne":"९९"}],"answer":0,"explain":{"en":"Each term is double the previous plus one: 47 × 2 + 1 = 95.","ne":"हरेक पद अघिल्लोको दोब्बरमा एक जोड: ४७ × २ + १ = ९५।"}},{"paper":"aptitude","q":{"en":"Which river system is the largest of Nepal by basin?","ne":"नेपालको सिन्धु जलाधार क्षेत्रमा सबैभन्दा ठूलो कुन?"},"options":[{"en":"Gandaki","ne":"गण्डकी"},{"en":"Koshi","ne":"कोशी"},{"en":"Karnali","ne":"कर्णाली"},{"en":"Mahanadi","ne":"महानदी"}],"answer":1,"explain":{"en":"The Koshi system drains the largest area of the country's rivers.","ne":"कोशी प्रणालीले देशका नदीहरूमध्ये सबैभन्दा बढी क्षेत्र पानी निकास गर्छ।"}},{"paper":"aptitude","q":{"en":"Nepali: which word is spelled correctly?","ne":"कुन शब्दको हिज्जे सही छ?"},"options":[{"en":"सुशासन","ne":"सुशासन"},{"en":"सुशाशन","ne":"सुशाशन"},{"en":"सुस्शासन","ne":"सुस्शासन"},{"en":"सुशासन्","ne":"सुशासन्"}],"answer":0,"explain":{"en":"Good governance is सुशासन.","ne":"सुशासन नै सही रूप हो।"}},{"paper":"aptitude","q":{"en":"The Constitution of Nepal was promulgated in which Bikram Sambat year?","ne":"नेपालको संविधान कुन वि.सं. मा जारी भयो?"},"options":[{"en":"2062","ne":"२०६२"},{"en":"2063","ne":"२०६३"},{"en":"2072","ne":"२०७२"},{"en":"2074","ne":"२०७४"}],"answer":2,"explain":{"en":"19 September 2015, which is 3 Aswin 2072.","ne":"२०७२ असोज ३ गते (१९ सेप्टेम्बर २०१५)।"}},{"paper":"aptitude","q":{"en":"A shop marks an item 20% above cost and then gives a 10% discount. What is the profit percent on cost?","ne":"एक पसलेले वस्तु लागतभन्दा २०% बढीमा राखेर १०% छुट दिन्छ। लागतमा नाफा कति प्रतिशत?"},"options":[{"en":"8%","ne":"८%"},{"en":"10%","ne":"१०%"},{"en":"12%","ne":"१२%"},{"en":"18%","ne":"१८%"}],"answer":0,"explain":{"en":"1.20 × 0.90 = 1.08, so 8% profit.","ne":"१.२० × ०.९० = १.०८, अर्थात् ८% नाफा।"}},{"paper":"aptitude","q":{"en":"Choose the correct preposition: The report was submitted ___ the deadline.","ne":"सही पूर्ियोजन छान्नुहोस्: The report was submitted ___ the deadline."},"options":[{"en":"in","ne":"in"},{"en":"on","ne":"on"},{"en":"at","ne":"at"},{"en":"by","ne":"by"}],"answer":3,"explain":{"en":"\"By the deadline\" means not later than it.","ne":"by the deadline को अर्थ त्यसभन्दा पछि होइन।"}},{"paper":"governance","q":{"en":"Which body recommends the number of members and their terms for a provincial assembly?","ne":"कुन निकायले प्रदेश सभाका सदस्य संख्या र कार्यकाल सिफारिस गर्छ?"},"options":[{"en":"The Commission itself","ne":"आयोग आफैँ"},{"en":"The Council of Ministers","ne":"मन्त्रिपरिषद"},{"en":"The President","ne":"राष्ट्रपति"},{"en":"The Chief Minister","ne":"प्रमुखमन्त्री"}],"answer":0,"explain":{"en":"The Commission is the constitutional body for its own composition and service rules.","ne":"आयोग आफ्नो गठन र सेवासम्बन्धी कानूनी निकाय हो।"}},{"paper":"governance","q":{"en":"Under the RTI Act, if information is refused, what may the applicant do?","ne":"सूचना अधिकार ऐनअन्तर्गत सूचना इनकार भएमा निवेदकले के गर्न सक्छ?"},"options":[{"en":"Nothing further","ne":"थप केही गर्न सक्दैन"},{"en":"Review then appeal to the Commission","ne":"पुनरावलोकनपछि आयोगमा जोहर"},{"en":"Sue immediately in the district court","ne":"जिल्ला अदालतमा तुरुन्त मुद्दा"},{"en":"Ask the police","ne":"प्रहरीसँग जान"}],"answer":1,"explain":{"en":"First a review by the designated officer, then appeal to the Information Commission.","ne":"पहिले तोकिमै अधिकारीबाट पुनरावलोकन, त्यसपछि सूचना आयोगमा जोहर।"}},{"paper":"contemporary","q":{"en":"Which is the largest share of Nepal's household income from abroad?","ne":"विदेशबाट आउने घरेलु आम्दानोको सबैभन्दा ठूलो स्रोत कुन?"},"options":[{"en":"Remittance from foreign employment","ne":"बैदेशिक रोजगारको विप्रेषण"},{"en":"Tourism receipts","ne":"पर्यटन आम्दानी"},{"en":"Foreign aid budget support","ne":"विदेशी सहायता"},{"en":"IT exports","ne":"सूचना प्रविधि निर्यात"}],"answer":0,"explain":{"en":"Remittance dominates external household income.","ne":"बाह्य घरेलु आम्दानीमा विप्रेषणको हिस्सा सबैभन्दा ठूलो छ।"}},{"paper":"contemporary","q":{"en":"Graduating from LDC status mainly changes which of these?","ne":"अल्पविकसित देश श्रेणीबाट निस्कँदा मुख्यतः के फेरिन्छ?"},"options":[{"en":"Preferential market access and some aid terms","ne":"प्राथमिकताप्राप्त बजार पहुँच र केही सहायता सर्त"},{"en":"The national currency","ne":"राष्ट्रिय मुद्रा"},{"en":"The number of provinces","ne":"प्रदेश संख्या"},{"en":"Citizenship rules","ne":"नागरिकता नियम"}],"answer":0,"explain":{"en":"Graduation re-prices trade preferences and part of concessional finance.","ne":"स्तरोन्नतिले व्यापार प्राथमिकता र छुटसुविधागत वित्तको सर्त फेर्छ।"}},{"paper":"service","q":{"en":"In the budget cycle, which document authorises spending before the year begins?","ne":"बजेट चक्रमा, वर्ष सुरु हुनुअघि खर्चको अधिकार दिने कागज कुन?"},"options":[{"en":"Appropriation Act","ne":"व्यय विधेयक/ऐन"},{"en":"Audit report","ne":"लेखा परीक्षण प्रतिवेदन"},{"en":"Finance statement","ne":"वित्तीय विवरण"},{"en":"Performance agreement","ne":"कार्यसम्पादन सम्झौता"}],"answer":0,"explain":{"en":"Money may be drawn only under an appropriation.","ne ":"व्यय विधेयकबिना राजकोषबाट पैसा निस्कन मिल्दैन।"}},{"paper":"service","q":{"en":"Which audit type asks whether a programme achieved its stated result?","ne":"कुन लेखा परीक्षणले कार्यक्रमले लक्षित नतिजा पायो कि भन्धर सोध्छ?"},"options":[{"en":"Compliance audit","ne":"अनुपालन"},{"en":"Performance audit","ne":"कार्यसम्पादन"},{"en":"Financial audit","ne":"वित्तीय"},{"en":"Internal control test","ne":"आन्तरिक नियन्त्रण"}],"answer":1,"explain":{"en":"Performance audit looks at economy, efficiency and effectiveness.","ne":"कार्यसम्पादन परीक्षणले मितव्ययिता, दक्षता र प्रभावकारिता हेर्छ।"}},{"paper":"service","q":{"en":"Under fiscal federalism, which grant is meant to close the revenue shortfall of a local level?","ne":"वित्तीय संघीयतामा, स्थानीय तहको राजस्व घाटा घटाउन कुन अनुदान हो?"},"options":[{"en":"Equalisation grant","ne":"बराबरी अनुदान"},{"en":"Special grant","ne":"विशेष अनुदान"},{"en":"Capital grant","ne":"पुँजी अनुदान"},{"en":"Matching grant","ne":"समानुपातिक अनुदान"}],"answer":0,"explain":{"en":"The fiscal commission recommends equalisation grants for shortfall.","ne":"वित्त आयोगले घाटा पूरै गर्न बराबरी अनुदान सिफारिस गर्छ।"}},{"paper":"service","q":{"en":"What is the first document in a personnel file after selection?","ne":"चयनपछि व्यक्तिको फाइलमा पहिलो कागज कुन?"},"options":[{"en":"Appointment letter","ne":"खुल्ला पत्र"},{"en":"Performance agreement","ne":"कार्यसम्पादन सम्झौता"},{"en":"Transfer order","ne":" सरुवा आदेश"},{"en":"Audit objection","ne":"लेखा आपत्ति"}],"answer":0,"explain":{"en":"Selection leads to appointment; the rest follow in service.","ne":"चयनपछि नियुक्ति, अनि सेवामा बाँकी आउँछ।"}}],"paperLabel":{"en":"Officer level — शाखा अधिकृत (Section Officer)","ne":"अधिकृत तह — शाखा अधिकृत"}}]}],"$L3f"]}],"$L40","$L41"]}]}]
