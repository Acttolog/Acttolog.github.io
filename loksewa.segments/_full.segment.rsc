f:["$","$1","c",{"children":[["$","$L20",null,{"children":[["$","section",null,{"className":"lk-hero","id":"lk-top","children":[["$","$L21",null,{}],["$","div",null,{"className":"lk-hero-veil","aria-hidden":"true"}],["$","div",null,{"className":"wrap lk-hero-in","children":[["$","div",null,{"className":"lk-hero-copy","children":[["$","div",null,{"className":"eyebrow lk-hero-kicker","children":["Officer level — शाखा अधिकृत (Section Officer)"," · ","संकलन २०२६ · हरेक चक्रमा जाँच्नुहोस्"]}],["$","h1",null,{"className":"lk-h1","children":["लोकसेवा घर",["$","span",null,{"className":"lk-h1-en","children":"Loksewa Ghar"}]]}],["$","p",null,{"className":"lk-lead","children":"नेपालको लोकसेवा परीक्षालाई चाहिने सबै कुरा एउटै घरमा — कानून, पाठ्यक्रम, विषय, अभ्यास र रैंक ल्याउने योजना।"}],["$","p",null,{"className":"lk-lead lk-lead-en","children":"Everything the Nepal civil service exam needs, in one house — laws, syllabus, subjects, practice and a rank-first plan."}],["$","div",null,{"className":"lk-hero-cta","children":[["$","a",null,{"className":"btn btn-p btn-lg","href":"#lk-papers","children":[["$","svg",null,{"width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5M3 17l9 5 9-5\"/>"}}]," विषयहरू चयन गर्नुहोस्"]}],["$","$L16",null,{"className":"btn btn-g btn-lg","href":"/loksewa/downloads","children":[["$","svg",null,{"width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M12 3v13M7 12l5 5 5-5M4 21h16\"/>"}}]," डाउनलोड केन्द्र"]}],["$","a",null,{"className":"btn btn-g btn-lg","href":"#lk-test","children":["निःशुल्क अभ्यास परीक्षण ",["$","svg",null,{"width":16,"height":16,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M5 12h14M13 6l6 6-6 6\"/>"}}]]}]]}],["$","div",null,{"className":"lk-hero-stats","children":[["$","span",null,{"children":[["$","b",null,{"children":4}]," पेपर"]}],["$","span",null,{"children":[["$","b",null,{"children":17}]," विषय"]}],["$","span",null,{"children":[["$","b",null,{"children":57}]," फोल्डर"]}],["$","span",null,{"children":[["$","b",null,{"children":10}]," कानून"]}]]}]]}],["$","aside",null,{"className":"lk-mentor","aria-label":"तयारी गर्ने — prepared by","children":[["$","div",null,{"className":"lk-mentor-photo","children":[["$","img",null,{"src":"/media/founder-pro.jpg","alt":"ACTTOLOG — founder of Loksewa Ghar","width":640,"height":800,"loading":"eager","decoding":"async"}],["$","span",null,{"className":"lk-mentor-ring","aria-hidden":"true"}]]}],["$","h2",null,{"children":"Acttolog"}],["$","p",null,{"className":"lk-mentor-role","children":"लोकसेवा घर — निर्माता र प्रशिक्षक"}],["$","p",null,{"className":"lk-mentor-bio","children":"परीक्षा तयारी, क्षेत्र-प्रमाणित नेपाल गाइड, प्रमाण-आधारित अनुसन्धान लेजर, खेल्न मिल्ने आर्केड र सदस्य अफर — एउटै द्विभाषिक प्लेटफर्म, साइन-इन बिना।"}],["$","div",null,{"className":"lk-mentor-links","children":[["$","$L16",null,{"href":"/about","children":[["$","svg",null,{"width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z\"/><path d=\"M14 3v5h5M9 13h6M9 17h4\"/>"}}]," परिचय"]}],["$","$L16",null,{"href":"/contact","children":[["$","svg",null,{"width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/>"}}]," सम्पर्क"]}],["$","a",null,{"href":"tel:9802336200","children":[["$","svg",null,{"width":13,"height":13,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","className":"$undefined","style":"$undefined","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M21 12a8 8 0 01-8 8H7l-4 3v-6a8 8 0 018-8h2a8 8 0 018 3z\"/>"}}]," ","9802336200"]}]]}]]}]]}],"$L22"]}],"$L23","$L24","$L25","$L26","$L27","$L28","$L29"]}],null,"$L2a"]}]
