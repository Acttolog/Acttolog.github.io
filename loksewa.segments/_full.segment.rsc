23:["$","section",null,{"className":"sec nb-sec","id":"lk-notices","children":["$","div",null,{"className":"wrap","children":["$","$L31",null,{"children":["$","$L32",null,{"notices":[{"id":"lk-psc","scope":"loksewa","category":"government","kind":"source","title":{"en":"Public Service Commission (Loksewa Ayog)","ne":"लोक सेवा आयोग"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"All civil-service vacancy advertisements — Section Officer and below — plus exam notices, admit cards and results.","ne":"शाखा अधिकृत र सोभन्दा तलका सबै पदपूर्ति विज्ञापन, परीक्षा सूचना, प्रवेशपत्र र नतिजा।"},"detail":{"en":"The Commission is the constitutional body that recruits for the civil service. Open and inclusive competitive advertisements are published here and in Gorkhapatra. Applications are submitted through the Commission's online portal.","ne":"आयोग निजामती सेवामा पदपूर्ति गर्ने संवैधानिक निकाय हो। खुला र समावेशी प्रतिस्पर्धात्मक विज्ञापन यहाँ र गोरखापत्रमा प्रकाशित हुन्छन्। आवेदन आयोगको अनलाइन पोर्टलबाट दिइन्छ।"},"sourceUrl":"https://psc.gov.np/category/notice","sourceName":"psc.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["civil service","officer","advertisement"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"lk-moha","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Home Affairs","ne":"गृह मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Civil Service Act and Rules, departmental process, and vacancy notices for bodies under the Ministry.","ne":"निजामती सेवा ऐन र नियमावली, विभागीय कारबाही, र मन्त्रालय अन्तर्गतका निकायका पदपूर्ति सूचना।"},"detail":{"en":"The Home Ministry is the parent body for the civil-service rules the exam is drawn from, and for the Nepal Police, Armed Police Force, Department of Immigration and the district administration offices. Its notice page carries departmental vacancy advertisements and the circulars that amend service conditions — read the Act and the Rules here rather than a coaching summary.","ne":"गृह मन्त्रालय निजामती सेवा ऐन र नियमावलीको मूल निकाय हो, जसबाट परीक्षाको पाठ्यक्रम बन्छ। नेपाल प्रहरी, सशस्त्र प्रहरी बल, अध्यागमन विभाग र जिल्ला प्रशासन कार्यालयहरू यसैअन्तर्गत पर्छन्। सूचना पृष्ठमा मातहतका निकायको पदपूर्ति विज्ञापन र सेवा शर्त संशोधन गर्ने परिपत्रहरू आउँछन् — कोचिङ सारांशभन्दा ऐन र नियमावली यहीं पढ्नुहोस्।"},"sourceUrl":"https://moha.gov.np","sourceName":"moha.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["act","regulation","administration"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-mof","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Finance","ne":"अर्थ मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Finance-group posts, treasury and revenue notices, budget documents and economic surveys referenced in the exam.","ne":"अर्थ समूहका पद, कोष तथा राजस्व सूचना, बजेट दस्तावेज र परीक्षामा सन्दर्भ हुने आर्थिक सर्वेक्षण।"},"detail":{"en":"The Finance Ministry publishes the budget, the Economic Survey and the revenue and treasury circulars that the finance-group papers quote directly. Vacancy notices for bodies under the Ministry appear on the same portal as those documents, so one address serves both the syllabus and the advertisement.","ne":"अर्थ मन्त्रालयले बजेट, आर्थिक सर्वेक्षण र राजस्व तथा कोष परिपत्रहरू प्रकाशित गर्छ, जसलाई अर्थ समूहका प्रश्नपत्रले सिधै उद्धृत गर्छन्। मन्त्रालय मातहतका निकायको पदपूर्ति सूचना ती दस्तावेजसँगै एउटै पोर्टलमा आउँछ, त्यसैले एउटै ठेगानाले पाठ्यक्रम र विज्ञापन दुवै दिन्छ।"},"sourceUrl":"https://mof.gov.np","sourceName":"mof.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["finance","budget","revenue"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-mofaga","scope":"loksewa","category":"government","kind":"source","title":{"en":"Ministry of Federal Affairs & General Administration","ne":"सङ्घीय मामिला तथा सामान्य प्रशासन मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Provincial and local-level service notices, general administration circulars and civil-service reform updates.","ne":"प्रदेश र स्थानीय तहका सेवा सूचना, सामान्य प्रशासन परिपत्र र निजामती सुधार अपडेट।"},"detail":{"en":"This Ministry carries the provincial and local-level service agenda: staff adjustment, local-level recruitment guidance and general-administration circulars. Local-level vacancies are advertised by the individual palika, so treat the Ministry page as the rule source and the palika’s own notice as the application source.","ne":"यो मन्त्रालयले प्रदेश र स्थानीय तहको सेवा सम्बन्धी काम हेर्छ: कर्मचारी समायोजन, स्थानीय तहको पदपूर्ति मार्गदर्शन र सामान्य प्रशासन परिपत्र। स्थानीय तहको रिक्त पदको विज्ञापन सम्बन्धित पालिकाले निकाल्छ, त्यसैले मन्त्रालयको पृष्ठलाई नियमको स्रोत र पालिकाको सूचनालाई आवेदनको स्रोत मान्नुहोस्।"},"sourceUrl":"https://mofaga.gov.np","sourceName":"mofaga.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["local level","provincial","administration"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-gorkhapatra","scope":"loksewa","category":"government","kind":"source","title":{"en":"Gorkhapatra — the official gazette","ne":"गोरखापत्र — आधिकारिक राजपत्र"},"org":{"en":"Gorkhapatra Sansthan","ne":"गोरखापत्र संस्थान"},"summary":{"en":"Every government vacancy is legally published here first. The daily carries advertisements from all ministries, departments and public bodies.","ne":"हरेक सरकारी पदपूर्ति कानुनी रूपमा पहिले यहीँ प्रकाशित हुन्छ। दैनिकले सबै मन्त्रालय, विभाग र सार्वजनिक निकायका विज्ञापन छापछ।"},"detail":{"en":"When a notice says 'as published in Gorkhapatra', this is the source of record. Read the advertisement number and date, then apply through the body named in it.","ne":"कुनै सूचनामा 'गोरखापत्रमा प्रकाशित भए बमोजिम' भनिएको छ भने यही आधिकारिक स्रोत हो। विज्ञापन नम्बर र मिति पढेर, त्यसमा उल्लेखित निकायमार्फत आवेदन दिनुहोस्।"},"sourceUrl":"https://gorkhapatra.org.np","sourceName":"gorkhapatra.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["gazette","advertisement","source of record"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"lk-nea","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Nepal Electricity Authority","ne":"नेपाल विद्युत् प्राधिकरण"},"org":{"en":"Public corporation","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Vacancy notices for engineering, administration and finance posts across the Authority's offices and projects.","ne":"प्राधिकरणका कार्यालय र आयोजनाहरूमा इन्जिनियरिङ, प्रशासन र अर्थ पदका पदपूर्ति सूचना।"},"detail":{"en":"Nepal Electricity Authority is the state utility for generation, transmission and distribution. Recruitment runs by project and office, so one advertisement often lists several districts. Engineering, administration and finance posts appear together; the notice PDF states the degree, the level and the duty office, and the application goes to the Authority’s own portal, not to Loksewa Ayog.","ne":"नेपाल विद्युत् प्राधिकरण उत्पादन, प्रसारण र वितरण हेर्ने राज्यको निकाय हो। पदपूर्ति आयोजना र कार्यालयअनुसार हुन्छ, त्यसैले एउटै विज्ञापनमा धेरै जिल्ला पर्न सक्छन्। इन्जिनियरिङ, प्रशासन र आर्थिक पद सँगै आउँछन्; सूचनाको PDF मा शैक्षिक योग्यता, तह र कार्यस्थल खुल्छ, र आवेदन प्राधिकरणकै पोर्टलमा दिइन्छ — लोक सेवा आयोगमा होइन।"},"sourceUrl":"https://nea.org.np/en","sourceName":"nea.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["engineering","corporation","energy"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-ntc","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Nepal Telecom","ne":"नेपाल टेलिकम"},"org":{"en":"Public corporation","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Recruitment for technical, IT and administrative roles at Nepal Doorsanchar Company Limited.","ne":"नेपाल दूरसञ्चार कम्पनी लिमिटेडमा प्राविधिक, आईटी र प्रशासनिक पदका लागि पदपूर्ति।"},"detail":{"en":"Nepal Doorsanchar Company Limited (Nepal Telecom) is the state telecom operator. The career page lists technical, IT and administrative posts with the advertisement PDF and the online form. These are company-service posts rather than civil service, so the pay scale and probation terms come from the Company’s own service rules quoted in the notice.","ne":"नेपाल दूरसञ्चार कम्पनी लिमिटेड (नेपाल टेलिकम) राज्यको दूरसञ्चार सञ्चालक हो। करियर पृष्ठमा प्राविधिक, सूचना प्रविधि र प्रशासनिक पदको विज्ञापन PDF र अनलाइन फारम हुन्छ। यी कम्पनी सेवाका पद हुन्, निजामती सेवाका होइनन्, त्यसैले तलबमान र परीक्षणकालका शर्त सूचनामा उल्लेखित कम्पनीकै सेवा नियमबाट आउँछन्।"},"sourceUrl":"https://www.ntc.net.np/post/new-career","sourceName":"ntc.net.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["telecom","it","technical"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-noc","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Nepal Oil Corporation","ne":"नेपाल आयल निगम"},"org":{"en":"Public corporation","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Vacancy advertisements for management, technical and depot-level posts.","ne":"व्यवस्थापन, प्राविधिक र डिपो तहका पदका पदपूर्ति विज्ञापन।"},"detail":{"en":"Nepal Oil Corporation is the state fuel importer and distributor. Vacancies are mostly depot, technical and management posts tied to a specific storage or distribution location, so the advertisement names the depot — check the posting district before you apply.","ne":"नेपाल आयल निगम राज्यको इन्धन आयात तथा वितरण निकाय हो। रिक्त पद प्रायः डिपो, प्राविधिक र व्यवस्थापनका हुन्छन् र निश्चित भण्डारण वा वितरण स्थलसँग जोडिएका हुन्छन्। विज्ञापनमा डिपोको नाम हुन्छ, त्यसैले आवेदन दिनुअघि कार्यस्थल जिल्ला जाँच्नुहोस्।"},"sourceUrl":"https://noc.org.np","sourceName":"noc.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["corporation","management","technical"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-nac","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Nepal Airlines Corporation","ne":"नेपाल वायुसेवा निगम"},"org":{"en":"Public corporation","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Recruitment notices for aviation, engineering, ground and administrative staff.","ne":"उड्डयन, इन्जिनियरिङ, ग्राउन्ड र प्रशासनिक कर्मचारीका लागि पदपूर्ति सूचना।"},"detail":{"en":"Nepal Airlines Corporation runs the national flag carrier. The recruitment subdomain carries aviation, engineering, ground-handling and administrative notices. Flight and technical posts require the licence or type qualification stated in the advertisement itself — that notice, not a general eligibility table, is the authority.","ne":"नेपाल वायुसेवा निगमले राष्ट्रिय ध्वजावाहक सञ्चालन गर्छ। पदपूर्ति उपडोमेनमा उडान, इन्जिनियरिङ, ग्राउन्ड ह्यान्डलिङ र प्रशासनिक सूचना आउँछन्। उडान र प्राविधिक पदका लागि विज्ञापनमै लेखिएको लाइसेन्स वा टाइप योग्यता चाहिन्छ — सामान्य योग्यता तालिका होइन, त्यही सूचना आधिकारिक हुन्छ।"},"sourceUrl":"https://vacancy.nepalairlines.com.np/","sourceName":"vacancy.nepalairlines.com.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["aviation","corporation"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-epf","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Employees Provident Fund","ne":"कर्मचारी सञ्चय कोष"},"org":{"en":"Public institution","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Vacancy notices for officer and assistant levels at the national provident fund.","ne":"राष्ट्रिय सञ्चय कोषमा अधिकृत र सहायक तहका पदपूर्ति सूचना।"},"detail":{"en":"The Employees Provident Fund manages the national contributory provident scheme. This link opens the vacancy notice type, which filters the Fund’s publications down to recruitment only — that is why it is linked instead of the homepage. Officer and assistant advertisements state the level, the qualification and the closing date inside the PDF.","ne":"कर्मचारी सञ्चय कोषले राष्ट्रिय योगदानमा आधारित सञ्चय कोष योजना सञ्चालन गर्छ। यो लिंकले पदपूर्ति सूचना प्रकार खोल्छ, जसले कोषका प्रकाशनलाई पदपूर्तिमा मात्र सीमित गर्छ — त्यसैले गृहपृष्ठको सट्टा यही जोडिएको छ। अधिकृत र सहायक तहका विज्ञापनमा तह, योग्यता र अन्तिम मिति PDF भित्रै लेखिएको हुन्छ।"},"sourceUrl":"https://epf.org.np/notice-type/vacancy/","sourceName":"epf.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["fund","officer","finance"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-cit","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Citizen Investment Trust","ne":"नागरिक लगानी कोष"},"org":{"en":"Public institution","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Recruitment for management, finance and IT posts at the national investment trust.","ne":"राष्ट्रिय लगानी कोषमा व्यवस्थापन, अर्थ र आईटी पदका लागि पदपूर्ति।"},"detail":{"en":"Citizen Investment Trust (Nagarik Lagani Kosh) runs pension and investment schemes for public-sector employees. Its site publishes a dedicated vacancies page, linked here instead of the homepage, listing officer and assistant advertisements with the level, the qualification and the closing date inside each notice.","ne":"नागरिक लगानी कोषले सार्वजनिक क्षेत्रका कर्मचारीका लागि निवृत्तिभरण र लगानी योजना सञ्चालन गर्छ। यसको साइटमा छुट्टै रिक्त पद पृष्ठ छ, गृहपृष्ठको सट्टा यही जोडिएको छ, जसमा अधिकृत र सहायक तहका विज्ञापन हुन्छन् र प्रत्येक सूचनाभित्र तह, योग्यता र अन्तिम मिति लेखिएको हुन्छ।"},"sourceUrl":"https://www.nlk.org.np/content/vacancies","sourceName":"nlk.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["investment","finance","it"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-ddc","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Dairy Development Corporation","ne":"दुग्ध विकास संस्थान"},"org":{"en":"Public corporation","ne":"सार्वजनिक संस्थान"},"summary":{"en":"Vacancy notices for technical, production and administrative posts.","ne":"प्राविधिक, उत्पादन र प्रशासनिक पदका पदपूर्ति सूचना।"},"detail":{"en":"Dairy Development Corporation is the state dairy processor and distributor. Posts are technical (dairy technology, quality control), production and administrative, and are often tied to a specific plant. Where the work is shift-based, the advertisement names the plant and the shift pattern.","ne":"दुग्ध विकास संस्थान राज्यको दुग्ध प्रशोधन तथा वितरण निकाय हो। पदहरू प्राविधिक (दुग्ध प्रविधि, गुणस्तर नियन्त्रण), उत्पादन र प्रशासनिक हुन्छन् र प्रायः निश्चित कारखानासँग जोडिएका हुन्छन्। पालीमा काम हुने भए विज्ञापनमा कारखाना र पालीको ढाँचा खुलाइन्छ।"},"sourceUrl":"https://ddc.gov.np","sourceName":"ddc.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["corporation","technical","production"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-caan","scope":"loksewa","category":"sansthan","kind":"source","title":{"en":"Civil Aviation Authority of Nepal","ne":"नेपाल नागरिक उड्डयन प्राधिकरण"},"org":{"en":"Regulatory body","ne":"नियामक निकाय"},"summary":{"en":"Recruitment for air-traffic, engineering, safety and administrative roles.","ne":"हवाई यातायात, इन्जिनियरिङ, सुरक्षा र प्रशासनिक पदका लागि पदपूर्ति।"},"detail":{"en":"The Civil Aviation Authority of Nepal is the regulator for aerodromes, air navigation services and safety oversight. Air-traffic and engineering posts carry licence and medical requirements set out in the advertisement; administrative posts follow the Authority’s service rules. Notices are published under the vacancy heading on the Authority’s site.","ne":"नेपाल नागरिक उड्डयन प्राधिकरण विमानस्थल, हवाई यातायात सेवा र सुरक्षा निगरानीको नियामक हो। हवाई यातायात नियन्त्रण र इन्जिनियरिङ पदमा विज्ञापनमा तोकिएका लाइसेन्स र स्वास्थ्य शर्त लागू हुन्छन्; प्रशासनिक पद प्राधिकरणको सेवा नियमअनुसार हुन्छन्। सूचनाहरू प्राधिकरणको साइटमा पदपूर्ति शीर्षकमुनि प्रकाशित हुन्छन्।"},"sourceUrl":"https://caanepal.gov.np","sourceName":"caanepal.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["aviation","regulator","engineering"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-nrb","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Nepal Rastra Bank (central bank)","ne":"नेपाल राष्ट्र बैंक (केन्द्रीय बैंक)"},"org":{"en":"Central bank","ne":"केन्द्रीय बैंक"},"summary":{"en":"Officer and assistant recruitment through the Bank's dedicated jobs portal; notices also in Gorkhapatra.","ne":"बैंकको छुट्टै जब पोर्टलबाट अधिकृत र सहायक पदपूर्ति; सूचना गोरखापत्रमा पनि।"},"detail":{"en":"NRB runs its own online recruitment system. Create an account on the jobs portal, watch the advertisement window, and submit within the published dates.","ne":"राष्ट्र बैंकले आफ्नै अनलाइन पदपूर्ति प्रणाली चलाउँछ। जब पोर्टलमा खाता खोल्नुहोस्, विज्ञापन अवधि हेर्नुहोस्, र प्रकाशित मितिभित्र आवेदन दिनुहोस्।"},"sourceUrl":"https://jobs.nrb.org.np","sourceName":"jobs.nrb.org.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["central bank","officer","banking"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"lk-nbl","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Nepal Bank Limited","ne":"नेपाल बैंक लिमिटेड"},"org":{"en":"Government-owned commercial bank","ne":"सरकारी स्वामित्वको वाणिज्य बैंक"},"summary":{"en":"The country's oldest bank — officer, assistant and trainee recruitment on its career page.","ne":"देशको सबैभन्दा पुरानो बैंक — अधिकृत, सहायक र ट्रेनी पदपूर्ति करियर पृष्ठमा।"},"detail":{"en":"Nepal Bank Limited is the country’s oldest bank and remains government-majority owned, with branches in every province. Officer, assistant and trainee advertisements are posted on the career page as downloadable notices with an online application link. Bank deadlines are set by the Bank and are usually shorter than a Loksewa window, so read the closing date printed in the advertisement itself.","ne":"नेपाल बैंक लिमिटेड देशको सबैभन्दा पुरानो बैंक हो र सरकारको बहुमत स्वामित्वमा छ; सबै प्रदेशमा शाखा छन्। अधिकृत, सहायक र प्रशिक्षार्थीका विज्ञापन करियर पृष्ठमा डाउनलोड गर्न मिल्ने सूचना र अनलाइन आवेदन लिंकसहित आउँछन्। बैंकको अन्तिम मिति बैंक आफैंले तोक्छ र लोक सेवाको अवधिभन्दा छोटो हुन्छ, त्यसैले विज्ञापनभित्र छापिएको मिति पढ्नुहोस्।"},"sourceUrl":"https://www.nepalbank.com.np/career","sourceName":"nepalbank.com.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","government-owned","trainee"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-rbb","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Rastriya Banijya Bank","ne":"राष्ट्रिय वाणिज्य बैंक"},"org":{"en":"Government-owned commercial bank","ne":"सरकारी स्वामित्वको वाणिज्य बैंक"},"summary":{"en":"Large recurring intakes across levels; applications via the Bank's recruitment portal.","ne":"विभिन्न तहमा ठूला नियमित पदपूर्ति; आवेदन बैंकको पदपूर्ति पोर्टलबाट।"},"detail":{"en":"Rastriya Banijya Bank is fully government-owned and runs one of the largest branch networks in the country, which is why its intakes are high-volume and recur across levels. Applications go through the Bank’s own recruitment portal; the advertisement PDF carries the level-wise vacancy count, the eligibility table and the fee.","ne":"राष्ट्रिय वाणिज्य बैंक पूर्ण सरकारी स्वामित्वमा छ र देशका सबैभन्दा ठूला शाखा सञ्जालमध्ये एक चलाउँछ, त्यसैले यसको पदपूर्ति ठूलो संख्यामा र विभिन्न तहमा दोहोरिन्छ। आवेदन बैंककै पदपूर्ति पोर्टलबाट दिइन्छ; विज्ञापनको PDF मा तहअनुसार पद संख्या, योग्यता तालिका र दस्तुर हुन्छ।"},"sourceUrl":"https://www.rbb.com.np/career","sourceName":"rbb.com.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","government-owned","intake"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-adbl","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Agriculture Development Bank","ne":"कृषि विकास बैंक"},"org":{"en":"Government-owned commercial bank","ne":"सरकारी स्वामित्वको वाणिज्य बैंक"},"summary":{"en":"Officer and assistant recruitment, including agriculture and rural-credit focused posts.","ne":"अधिकृत र सहायक पदपूर्ति, कृषि र ग्रामीण कर्जामा केन्द्रित पदसहित।"},"detail":{"en":"Agriculture Development Bank is government-majority owned with an agriculture and rural-credit mandate, so some posts ask for agriculture, livestock or cooperative qualifications alongside the usual banking streams. Recruitment is published on a dedicated vacancy subdomain rather than on the main site.","ne":"कृषि विकास बैंक सरकारको बहुमत स्वामित्वमा छ र कृषि तथा ग्रामीण कर्जाको जिम्मेवारी बोकेको छ, त्यसैले केही पदमा सामान्य बैंकिङ धारसँगै कृषि, पशुपालन वा सहकारी विषयको योग्यता मागिन्छ। पदपूर्ति मूल साइटमा नभई छुट्टै पदपूर्ति उपडोमेनमा प्रकाशित हुन्छ।"},"sourceUrl":"https://vacancy.adbl.gov.np/","sourceName":"vacancy.adbl.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","agriculture","government-owned"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-nabil","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Nabil Bank","ne":"नबिल बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Nepal's first private commercial bank — vacancies on its official site.","ne":"नेपालको पहिलो निजी वाणिज्य बैंक — पदपूर्ति आधिकारिक साइटमा।"},"detail":{"en":"Nabil Bank was Nepal’s first private-sector commercial bank. Vacancies are listed on the Bank’s official site under its career heading; each listing names the position, the duty station and the closing date, and the application is submitted on the Bank’s own form.","ne":"नाबिल बैंक नेपालको पहिलो निजी क्षेत्रको वाणिज्य बैंक हो। रिक्त पद बैंकको आधिकारिक साइटमा करियर शीर्षकमुनि सूचीबद्ध हुन्छन्; प्रत्येक सूचीमा पद, कार्यस्थल र अन्तिम मिति खुल्छ, र आवेदन बैंककै फारमबाट दिइन्छ।"},"sourceUrl":"https://www.nabilbank.com","sourceName":"nabilbank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","private"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-globalime","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Global IME Bank","ne":"ग्लोबल आईएमई बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"One of the largest branch networks — trainee and officer intakes on its official site.","ne":"सबैभन्दा ठूला शाखा सञ्जालमध्ये — ट्रेनी र अधिकृत पदपूर्ति आधिकारिक साइटमा।"},"detail":{"en":"Global IME Bank grew through mergers into one of the widest private branch networks, so trainee and officer intakes appear in batches covering many districts. Check the duty station in the advertisement — a single notice often covers several branches at once.","ne":"ग्लोबल आइएमई बैंक मर्जरमार्फत निजी क्षेत्रका सबैभन्दा फराकिला शाखा सञ्जालमध्ये एक बनेको छ, त्यसैले प्रशिक्षार्थी र अधिकृतका पद धेरै जिल्ला समेटेर समूहमा आउँछन्। विज्ञापनमा कार्यस्थल जाँच्नुहोस् — एउटै सूचनाले एकैपटक धेरै शाखा समेट्न सक्छ।"},"sourceUrl":"https://www.globalimebank.com","sourceName":"globalimebank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","trainee"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-nicasia","scope":"loksewa","category":"bank","kind":"source","title":{"en":"NIC Asia Bank","ne":"एनआईसी एसिया बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Frequent recruitment across business, IT and operations — official career notices.","ne":"व्यवसाय, आईटी र सञ्चालनमा नियमित पदपूर्ति — आधिकारिक करियर सूचना।"},"detail":{"en":"NIC Asia Bank recruits frequently across business, IT and operations. Notices on the official site are position-specific and usually short-lived; the closing date and the required experience are stated per post, not per batch.","ne":"एनआइसी एसिया बैंकले व्यवसाय, सूचना प्रविधि र सञ्चालन क्षेत्रमा बारम्बार पदपूर्ति गर्छ। आधिकारिक साइटका सूचना पदअनुसार छुट्टाछुट्टै हुन्छन् र प्रायः छोटो अवधिका लागि खुल्छन्; अन्तिम मिति र आवश्यक अनुभव समूहको नभई प्रत्येक पदको छुट्टै लेखिएको हुन्छ।"},"sourceUrl":"https://www.nicasiabank.com","sourceName":"nicasiabank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","it","operations"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-everest","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Everest Bank","ne":"एभरेष्ट बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Officer and assistant vacancies published on the Bank's official site.","ne":"अधिकृत र सहायक पदपूर्ति बैंकको आधिकारिक साइटमा प्रकाशित।"},"detail":{"en":"Everest Bank publishes officer and assistant vacancies on the careers page of its official site. Each listing carries the advertisement PDF with the eligibility table and the application link; there is no separate Loksewa route for these posts.","ne":"एभरेष्ट बैंकले अधिकृत र सहायक तहका रिक्त पद आफ्नो आधिकारिक साइटको करियर पृष्ठमा प्रकाशित गर्छ। प्रत्येक सूचीमा योग्यता तालिका र आवेदन लिंकसहितको विज्ञापन PDF हुन्छ; यी पदका लागि लोक सेवाबाट छुट्टै बाटो हुँदैन।"},"sourceUrl":"https://everestbankltd.com/careers/","sourceName":"everestbankltd.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-himalayan","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Himalayan Bank","ne":"हिमालयन बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Recruitment notices for management, credit and branch roles.","ne":"व्यवस्थापन, कर्जा र शाखा पदका लागि पदपूर्ति सूचना।"},"detail":{"en":"Himalayan Bank’s career-notice page lists management, credit and branch roles. Because credit and risk posts ask for specific experience, read the experience clause as carefully as the academic requirement — it is the clause most applicants fail.","ne":"हिमालयन बैंकको करियर सूचना पृष्ठमा व्यवस्थापन, कर्जा र शाखाका पद सूचीबद्ध हुन्छन्। कर्जा र जोखिमका पदमा निश्चित अनुभव मागिने हुनाले शैक्षिक योग्यताजत्तिकै ध्यान अनुभवको शर्तमा दिनुहोस् — धेरै आवेदक यही शर्तमा अयोग्य हुन्छन्।"},"sourceUrl":"https://himalayanbank.com/career-notice/","sourceName":"himalayanbank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","credit"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-prabhu","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Prabhu Bank","ne":"प्रभु बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Vacancy advertisements on the Bank's official website.","ne":"बैंकको आधिकारिक वेबसाइटमा पदपूर्ति विज्ञापन।"},"detail":{"en":"Prabhu Bank posts vacancy advertisements on its official website. The notices are dated PDFs, and the file name and the posting date can differ — rely on the closing date printed inside the advertisement rather than the date shown in the list.","ne":"प्रभु बैंकले आफ्नो आधिकारिक वेबसाइटमा पदपूर्ति विज्ञापन प्रकाशित गर्छ। सूचनाहरू मिति भएका PDF हुन्छन्, र फाइलको नाम र प्रकाशन मिति फरक पर्न सक्छ — सूचीमा देखिएको मितिभन्दा विज्ञापनभित्र छापिएको अन्तिम मितिलाई मान्नुहोस्।"},"sourceUrl":"https://www.prabhubank.com","sourceName":"prabhubank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-sanima","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Sanima Bank","ne":"सानीमा बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Officer and trainee recruitment notices on the official site.","ne":"अधिकृत र ट्रेनी पदपूर्ति सूचना आधिकारिक साइटमा।"},"detail":{"en":"Sanima Bank publishes officer and trainee recruitment notices on its official site. Trainee advertisements normally specify the academic stream and the age limit; both are printed in the notice, and neither can be inferred from the job title.","ne":"सानिमा बैंकले अधिकृत र प्रशिक्षार्थी पदपूर्तिका सूचना आफ्नो आधिकारिक साइटमा प्रकाशित गर्छ। प्रशिक्षार्थीका विज्ञापनमा सामान्यतया शैक्षिक धार र उमेर हद तोकिएको हुन्छ; दुवै सूचनामै छापिएका हुन्छन्, पदको नामबाट अनुमान गर्न मिल्दैन।"},"sourceUrl":"https://www.sanimabank.com","sourceName":"sanimabank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","trainee"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-kumari","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Kumari Bank","ne":"कुमारी बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Career and vacancy notices published on the Bank's official site.","ne":"करियर र पदपूर्ति सूचना बैंकको आधिकारिक साइटमा प्रकाशित।"},"detail":{"en":"Kumari Bank publishes career and vacancy notices on its official site. Where one notice lists several positions, each has its own vacancy count and eligibility row — apply against the specific row you qualify for, not against the notice as a whole.","ne":"कुमारी बैंकले करियर र पदपूर्ति सूचना आफ्नो आधिकारिक साइटमा प्रकाशित गर्छ। एउटै सूचनामा धेरै पद भए प्रत्येकको छुट्टै पद संख्या र योग्यता पङ्क्ति हुन्छ — सिङ्गो सूचनाको सट्टा आफू योग्य हुने पङ्क्तिको विरुद्ध आवेदन दिनुहोस्।"},"sourceUrl":"https://www.kumaribank.com","sourceName":"kumaribank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-mach","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Machhapuchchhre Bank","ne":"माछापुच्छ्रे बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Recruitment for branch, IT and operations roles — official notices.","ne":"शाखा, आईटी र सञ्चालन पदका लागि पदपूर्ति — आधिकारिक सूचना।"},"detail":{"en":"Machhapuchchhre Bank recruits for branch, IT and operations roles. IT posts commonly ask for a demonstrable stack or certification, so the technical requirement in the advertisement is the deciding clause rather than the degree alone.","ne":"माछापुच्छ्रे बैंकले शाखा, सूचना प्रविधि र सञ्चालनका पदमा पदपूर्ति गर्छ। सूचना प्रविधिका पदमा प्रायः देखाउन सकिने प्रविधि सीप वा प्रमाणपत्र मागिन्छ, त्यसैले डिग्री मात्र नभई विज्ञापनको प्राविधिक शर्त निर्णायक हुन्छ।"},"sourceUrl":"https://www.machbank.com","sourceName":"machbank.com","location":{"en":"Pokhara","ne":"पोखरा"},"tags":["commercial bank","it"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-siddhartha","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Siddhartha Bank","ne":"सिद्धार्थ बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Vacancy notices on the Bank's official website.","ne":"बैंकको आधिकारिक वेबसाइटमा पदपूर्ति सूचना।"},"detail":{"en":"Siddhartha Bank posts vacancy notices on its official website. The notice list is chronological and older files stay visible after their deadline has passed, so confirm the closing date inside the newest posting before preparing an application.","ne":"सिद्धार्थ बैंकले आफ्नो आधिकारिक वेबसाइटमा पदपूर्ति सूचना प्रकाशित गर्छ। सूचना सूची मितिअनुसार हुन्छ र म्याद नाघेका पुराना फाइल पनि देखिरहन्छन्, त्यसैले आवेदन तयार गर्नुअघि सबैभन्दा नयाँ सूचनाभित्रको अन्तिम मिति पुष्टि गर्नुहोस्।"},"sourceUrl":"https://www.siddharthabank.com","sourceName":"siddharthabank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-citizens","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Citizens Bank International","ne":"सिटिजन्स बैंक इन्टरनेसनल"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Officer and assistant recruitment on the official career page.","ne":"अधिकृत र सहायक पदपूर्ति आधिकारिक करियर पृष्ठमा।"},"detail":{"en":"Citizens Bank International publishes officer and assistant recruitment on its official career page. Assistant-level advertisements usually state the intermediate-level stream and the minimum grade, which differ from the officer-level requirements in the same notice.","ne":"सिटिजन्स बैंक इन्टरनेसनलले अधिकृत र सहायक तहको पदपूर्ति आफ्नो आधिकारिक करियर पृष्ठमा प्रकाशित गर्छ। सहायक तहका विज्ञापनमा सामान्यतया मध्यवर्ती तहको धार र न्यूनतम ग्रेड तोकिएको हुन्छ, जुन एउटै सूचनाको अधिकृत तहको शर्तभन्दा फरक हुन्छ।"},"sourceUrl":"https://www.ctznbank.com/career/","sourceName":"ctznbank.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-prime","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Prime Commercial Bank","ne":"प्राइम कमर्सियल बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Career notices for branch and central-office posts.","ne":"शाखा र केन्द्रीय कार्यालय पदका लागि करियर सूचना।"},"detail":{"en":"Prime Commercial Bank posts career notices for branch and central-office posts. Central-office roles name the department and often a specific software or regulatory familiarity; branch roles name the province or district instead.","ne":"प्राइम कमर्सियल बैंकले शाखा र केन्द्रीय कार्यालयका पदका लागि करियर सूचना प्रकाशित गर्छ। केन्द्रीय कार्यालयका पदमा विभाग र प्रायः निश्चित सफ्टवेयर वा नियामक ज्ञान खुलाइन्छ; शाखाका पदमा प्रदेश वा जिल्ला उल्लेख हुन्छ।"},"sourceUrl":"https://www.primebank.com.np","sourceName":"primebank.com.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-nepalsbi","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Nepal SBI Bank","ne":"नेपाल एसबीआई बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Recruitment notices on the Bank's official site.","ne":"बैंकको आधिकारिक साइटमा पदपूर्ति सूचना।"},"detail":{"en":"Nepal SBI Bank is a joint venture with the State Bank of India and publishes recruitment notices on its official site. Its service conditions come from the Bank’s own rules, so the pay scale and the probation period are the ones stated in the advertisement.","ne":"नेपाल एसबीआई बैंक भारतीय स्टेट बैंकसँगको संयुक्त उद्यम हो र पदपूर्ति सूचना आफ्नो आधिकारिक साइटमा प्रकाशित गर्छ। सेवा शर्त बैंककै नियमबाट आउँछन्, त्यसैले तलबमान र परीक्षणकाल विज्ञापनमा लेखिएअनुसार हुन्छन्।"},"sourceUrl":"https://nsbl.statebank/careers","sourceName":"nsbl.statebank","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-sc","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Standard Chartered Bank Nepal","ne":"स्ट्यान्डर्ड चार्टर्ड बैंक नेपाल"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"International bank — careers listed on its global careers portal.","ne":"अन्तर्राष्ट्रिय बैंक — करियर यसको विश्वव्यापी करियर पोर्टलमा सूचीबद्ध।"},"detail":{"en":"Standard Chartered Bank Nepal is the Nepal operation of an international bank, so vacancies are listed on the group’s global careers portal and filtered by country. Search that portal for Nepal to see the open roles; the Nepal section of the local site carries the country context and contact details.","ne":"स्ट्यान्डर्ड चार्टर्ड बैंक नेपाल अन्तर्राष्ट्रिय बैंकको नेपाल सञ्चालन हो, त्यसैले रिक्त पद समूहको विश्वव्यापी करियर पोर्टलमा देशअनुसार छानेर हेरिन्छ। खुला पद देख्न त्यो पोर्टलमा नेपाल खोज्नुहोस्; स्थानीय साइटको नेपाल खण्डमा देशको सन्दर्भ र सम्पर्क विवरण हुन्छ।"},"sourceUrl":"https://www.sc.com/np","sourceName":"sc.com/np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","international"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-laxmi","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Laxmi Sunrise Bank","ne":"लक्ष्मी सनराइज बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Vacancy notices on the Bank's official website.","ne":"बैंकको आधिकारिक वेबसाइटमा पदपूर्ति सूचना।"},"detail":{"en":"Laxmi Sunrise Bank was formed by the merger of Laxmi Bank and Sunrise Bank, and posts vacancy notices on its official website. Advertisements published under either legacy name may still be listed — check the letterhead and the date inside the PDF before treating a posting as current.","ne":"लक्ष्मी सनराइज बैंक लक्ष्मी बैंक र सनराइज बैंकको मर्जरबाट बनेको हो र पदपूर्ति सूचना आफ्नो आधिकारिक वेबसाइटमा प्रकाशित गर्छ। पुराना नामबाट प्रकाशित विज्ञापन पनि सूचीमा रहन सक्छन् — कुनै सूचनालाई हालको मान्नुअघि PDF भित्रको लेटरहेड र मिति जाँच्नुहोस्।"},"sourceUrl":"https://www.laxmisunrise.com","sourceName":"laxmisunrise.com","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"lk-nimb","scope":"loksewa","category":"bank","kind":"source","title":{"en":"Nepal Investment Mega Bank","ne":"नेपाल इन्भेष्टमेन्ट मेगा बैंक"},"org":{"en":"Commercial bank","ne":"वाणिज्य बैंक"},"summary":{"en":"Officer and trainee recruitment on the official site.","ne":"अधिकृत र ट्रेनी पदपूर्ति आधिकारिक साइटमा।"},"detail":{"en":"Nepal Investment Mega Bank was formed by the merger of Nepal Investment Bank and Mega Bank, and publishes officer and trainee recruitment on the career section of its official site. Older advertisements under those two legacy names are not current openings.","ne":"नेपाल इन्भेस्टमेन्ट मेगा बैंक नेपाल इन्भेस्टमेन्ट बैंक र मेगा बैंकको मर्जरबाट बनेको हो र अधिकृत तथा प्रशिक्षार्थी पदपूर्ति आफ्नो आधिकारिक साइटको करियर खण्डमा प्रकाशित गर्छ। ती दुई पुराना नामबाट प्रकाशित विज्ञापन हालका रिक्त पद होइनन्।"},"sourceUrl":"https://www.nimb.com.np/en/career","sourceName":"nimb.com.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["commercial bank","trainee"],"posted":"2026-11-17","verifiedOn":"2026-11-18"},{"id":"lk-practice","scope":"loksewa","category":"exam","kind":"notice","title":{"en":"Free officer-level practice test — current set","ne":"निःशुल्क अधिकृत-तह अभ्यास परीक्षण — हालको सेट"},"org":{"en":"ACTTOLOG · Loksewa Ghar","ne":"ACTTOLOG · लोकसेवा घर"},"summary":{"en":"Negative-marking mock with instant score and explanations. Runs in your browser — no account, nothing sent anywhere.","ne":"नकारात्मक घटाइसहितको नक्कली परीक्षण, तुरुन्त नतिजा र व्याख्या। ब्राउजरमै चल्छ — खाता चाहिँदैन, कतै पठाइँदैन।"},"detail":{"en":"The current practice set is available through the end of this cycle and is refreshed from the syllabus points listed in the house. Your result and checklist stay on this device only.","ne":"हालको अभ्यास सेट यो चक्रको अन्त्यसम्म उपलब्ध छ र घरमा सूचीबद्ध पाठ्यबुँदाबाट परिमार्जन हुन्छ। तपाईंको नतिजा र चेकलिस्ट यही यन्त्रमा मात्र बस्छ।"},"sourceUrl":"/loksewa#lk-test","sourceName":"Loksewa Ghar","tags":["practice","mock","free"],"posted":"2026-11-01","verifiedOn":"2026-11-17","closesOn":"2026-12-31","featured":true},{"id":"lk-downloads","scope":"loksewa","category":"exam","kind":"notice","title":{"en":"Syllabus map, 12-week planner & law list — free PDF","ne":"पाठ्यक्रम नक्सा, १२-हप्ते योजना र कानून सूची — निःशुल्क PDF"},"org":{"en":"ACTTOLOG · Loksewa Ghar","ne":"ACTTOLOG · लोकसेवा घर"},"summary":{"en":"Print-ready documents built from the real folder tree: every paper, subject, folder and point, plus the rank-first plan.","ne":"वास्तविक फोल्डर संरचनाबाट बनेका छाप-तयार कागज: हरेक पेपर, विषय, फोल्डर र बुँदा, साथै रैंक-प्रथम योजना।"},"detail":{"en":"The download centre builds its documents from the real syllabus folder tree, so every paper, subject, folder and point in the PDF matches the syllabus map on this site. The files are free, print-ready and generated here — no third-party mirror and no sign-up.","ne":"डाउनलोड केन्द्रले दस्तावेज वास्तविक पाठ्यक्रम फोल्डर संरचनाबाट बनाउँछ, त्यसैले PDF मा भएको प्रत्येक प्रश्नपत्र, विषय, फोल्डर र बुँदा यसै साइटको पाठ्यक्रम नक्सासँग मिल्छ। फाइलहरू निःशुल्क, छाप्न तयार र यहीं बनाइएका हुन् — तेस्रो पक्षको मिरर छैन, दर्ता पनि चाहिँदैन।"},"sourceUrl":"/loksewa/downloads","sourceName":"Loksewa Ghar","tags":["pdf","syllabus","planner","free"],"posted":"2026-11-10","verifiedOn":"2026-11-17","featured":true}],"categories":[{"id":"government","label":{"en":"Government","ne":"सरकारी"},"color":"var(--cy)","count":5},{"id":"sansthan","label":{"en":"Sansthan","ne":"संस्थान"},"color":"var(--vi)","count":8},{"id":"bank","label":{"en":"Bank","ne":"बैंक"},"color":"var(--gold)","count":20},{"id":"exam","label":{"en":"Exam","ne":"परीक्षा"},"color":"var(--ok)","count":2}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"ne","variant":"full","accent":"var(--gold)","title":{"en":"Vacancy & Notice Board","ne":"पदपूर्ति तथा सूचना पाटी"},"subtitle":{"en":"Government, sansthan and bank recruitment portals — each linked to the issuing body. Filter, search and save; ACTTOLOG notices carry a live closing countdown.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टल — हरेक जारी गर्ने निकायमै लिङ्क। फिल्टर, खोज र सुरक्षित गर्नुहोस्; ACTTOLOG का सूचनामा बन्द हुने समयको प्रत्यक्ष काउन्टडाउन देखिन्छ।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"