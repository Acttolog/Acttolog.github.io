18:["$","$1","c",{"children":[["$","div",null,{"children":[["$","$L24",null,{"title":"Academy","desc":"Courses → modules → lessons → resources. Academy is protected; guests see the introduction only."}],["$","$L25",null,{"configured":false}],["$","$L26",null,{"rows":[{"id":"c1","slug":"research-methods-foundations","title":{"en":"Research Methods Foundations","ne":"अनुसन्धान विधिको आधार"},"level":"Beginner","summary":{"en":"Build a defensible research design from a vague idea: questions, constructs, sampling, ethics and a written methodology.","ne":"अस्पष्ट idea बाट बलियो अनुसन्धान डिजाइन बनाउने — प्रश्न, कन्स्ट्रक्ट, नमूना, नैतिकता र लिखित विधि।"},"image":"art:academy","duration":{"en":"6 weeks","ne":"६ हप्ता"},"featured":true,"status":"published","access":"members","audience":"global","resources":[{"en":"Methodology template","ne":"विधि टेम्प्लेट"},{"en":"Research question worksheet","ne":"प्रश्न कार्यपत्र"},{"en":"Ethics checklist","ne":"नैतिकता चेकलिस्ट"}],"modules":[{"title":{"en":"From Topic to Question","ne":"विषयबाट प्रश्नसम्म"},"lessons":[{"en":"Topics, problems and questions","ne":"विषय, समस्या र प्रश्न"},{"en":"The three-filter test","ne":"तीन-फिल्टर परीक्षण"},{"en":"Writing the one-sentence question","ne":"एक-वाक्य प्रश्न लेखन"}]},{"title":{"en":"Design & Constructs","ne":"डिजाइन र कन्स्ट्रक्ट"},"lessons":[{"en":"Qualitative, quantitative and mixed designs","ne":"गुणात्मक, परिमाणात्मक र मिश्र डिजाइन"},{"en":"Operational definitions","ne":"परिचालनात्मक परिभाषा"},{"en":"Validity and reliability","ne":"वैधता र विश्वसनीयता"}]},{"title":{"en":"Sampling & Data Collection","ne":"नमूना र डाटा संकलन"},"lessons":[{"en":"Populations, frames and samples","ne":"जनसंख्या, फ्रेम र नमूना"},{"en":"Survey and interview instruments","ne":"सर्भे र अन्तर्वार्ता उपकरण"}]},{"title":{"en":"Writing the Methodology","ne":"विधि लेखन"},"lessons":[{"en":"Chapter structure reviewers expect","ne":"समीक्षकले अपेक्षा गर्ने संरचना"},{"en":"Justifying every choice","ne":"हरेक छनोटको औचित्