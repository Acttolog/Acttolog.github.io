0:{"buildId":"NHZ1rIF2n_XLy45NeZhW-","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"children":[["$","$L2",null,{"title":"Games","desc":"Browser games and interactive experiences. Playing requires Continue with Google."}],["$","$L3",null,{"configured":false}],["$","$L4",null,{"rows":[{"id":"g5","slug":"cube-26","title":{"en":"CUBE/26","ne":"क्युब/२६"},"desc":{"en":"A studio-grade 3D cube lab for 2×2 and 3×3 puzzles: scramble, solve, or paint any position sticker by sticker, then run the verified solve plan on the cube.","ne":"२×२ र ३×३ पजलका लागि स्टुडियो-स्तरको ३डी क्युब ल्याब: स्क्र्याम्बल गर्नुहोस्, समाधान गर्नुहोस्, वा जुनसुकै अवस्था स्टिकर-स्टिकर रङ्गाउनुहोस्, अनि प्रमाणित समाधान योजना क्युबमा चल्न दिनुहोस्।"},"thumb":"/media/cube26.jpg","url":"/cube26/","launch":"live","engine":"cube-26","category":"Puzzle","tags":["3d","rubik","solver"],"release":"2026-10-29","featured":true,"visible":true,"status":"published","access":"public","__href":"/games/cube-26"},{"id":"g6","slug":"khoja-nepal","title":{"en":"Khoja Nepal","ne":"खोज नेपाल"},"desc":{"en":"A daily photo hunt across Nepal: five real places, five map pins. Drop your best guess, learn the distance, then share the score.","ne":"नेपालभरका पाँच वास्तविक ठाउँको दैनिक फोटो खोजी: नक्सामा अनुमान राख्नुहोस्, दूरी थाहा पाउनुहोस् र स्कोर साझा गर्नुहोस्।"},"thumb":"/media/arcade/thumbs/khoja-nepal.jpg","url":"/arcade/index.html?game=khoja-nepal","launch":"live","engine":"arcade-khoja","category":"Geography","tags":["nepal","map","daily"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public","__href":"/games/khoja-nepal"},{"id":"g7","slug":"merge-himalaya","title":{"en":"Merge Himalaya","ne":"मर्ज हिमालय"},"desc":{"en":"The 2048 formula rebuilt as a Himalayan expedition. Merge tea houses, trekkers and base camps all the way to the 2048 Himalaya tile.","ne":"२०४८ सूत्रलाई हिमाली अभियानमा बदलिएको खेल। चिया घर, ट्रेकर र आधार शिविर मिलाउँदै २०४८ को हिमालय टाइलसम्म पुग्नुहोस्।"},"thumb":"/media/arcade/thumbs/merge-himalaya.jpg","url":"/arcade/index.html?game=merge-himalaya","launch":"live","engine":"arcade-merge","category":"Puzzle","tags":["nepal","2048","merge"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public","__href":"/games/merge-himalaya"},{"id":"g8","slug":"himalaya-stack","title":{"en":"Himalaya Stack","ne":"हिमालय स्ट्याक"},"desc":{"en":"Stack blocks from Base Camp upward. One tap drops each block; perfect drops keep your tower wide while misses shave it thin. Climb toward 8,848 m.","ne":"आधार शिविरदेखि माथि ब्लकहरू थप्दै जानुहोस्। एउटा ट्यापमा ब्लक खस्छ; सटीक खसाल्दा टावर चौडा रहन्छ, चुक्दा साँघुरो हुन्छ। ८,८४८ मिटरतर्फ लक्ष्य राख्नुहोस्।"},"thumb":"/media/arcade/thumbs/himalaya-stack.jpg","url":"/arcade/index.html?game=himalaya-stack","launch":"live","engine":"arcade-stack","category":"Arcade","tags":["nepal","tower","one-tap"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public","__href":"/games/himalaya-stack"},{"id":"g9","slug":"typerush-nepal","title":{"en":"TypeRush Nepal","ne":"टाइपरश नेपाल"},"desc":{"en":"Sixty seconds, one passage about Nepal. Type facts or romanized Nepali words against the clock and chase a clean words-per-minute score.","ne":"साठी सेकेन्ड, नेपालबारे एउटा अनुच्छेद। नेपालका तथ्य वा रोमन लिपिमा नेपाली शब्द समयसँग दौडिएर टाइप गर्नुहोस् र उच्च WPM स्कोर बनाउनुहोस्।"},"thumb":"/media/arcade/thumbs/typerush-nepal.jpg","url":"/arcade/index.html?game=typerush-nepal","launch":"live","engine":"arcade-typerush","category":"Typing","tags":["nepal","typing","wpm"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public","__href":"/games/typerush-nepal"},{"id":"g10","slug":"nepal-daily","title":{"en":"Nepal Daily","ne":"नेपाल डेली"},"desc":{"en":"Ten questions a day on Nepal's mountains, culture, wildlife, food and history. The same set for everyone; practice never breaks your streak.","ne":"नेपालका हिमाल, संस्कृति, वन्यजन्तु, खानपान र इतिहासबारे दिनका दस प्रश्न। सबैका लागि एउटै सेट; अभ्यासले स्ट्रिक भाँड्दैन।"},"thumb":"/media/arcade/thumbs/nepal-daily.jpg","url":"/arcade/index.html?game=nepal-daily","launch":"live","engine":"arcade-daily","category":"Trivia","tags":["nepal","quiz","daily"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public","__href":"/games/nepal-daily"},{"id":"g11","slug":"ludo-himalaya","title":{"en":"Ludo Himalaya","ne":"लुडो हिमालय"},"desc":{"en":"The classic ludo table in three dimensions: walnut, brass and glass. Roll six to leave the yard, capture rivals, then race four marbles up your home column.","ne":"तीन आयाममा क्लासिक लुडो टेबल: ओखरको काठ, पित्तल र काँच। छक्का परे घरबाट निस्कनुहोस्, प्रतिद्वन्द्वीलाई काट्नुहोस् र चार गोटी आ-आफ्नो घरतर्फ दौडाउनुहोस्।"},"thumb":"/media/arcade/thumbs/ludo-himalaya.jpg","url":"/arcade/index.html?game=ludo-himalaya","launch":"live","engine":"arcade-ludo","category":"Board","tags":["nepal","ludo","dice","3d"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public","__href":"/games/ludo-himalaya"},{"id":"g1","slug":"orbit-recall","title":{"en":"Orbit Recall","ne":"अर्बिट रिकल"},"desc":{"en":"A memory game built from the Acttolog divisions. Match the orbital pairs before the timer drifts.","ne":"Acttolog विभागहरूबाट बनेको स्मृति खेल। समय सकिनुअघि जोडी मिलाउनुहोस्।"},"thumb":"art:games","url":"","launch":"embedded","engine":"orbit-recall","category":"Puzzle","tags":["memory"],"release":"2026-09-17","featured":true,"visible":true,"status":"published","access":"members","__href":"/games/orbit-recall"},{"id":"g2","slug":"signal-drift","title":{"en":"Signal Drift","ne":"सिग्नल ड्रिफ्ट"},"desc":{"en":"A timing game: lock the signal inside the target arc across five increasingly fast rounds.","ne":"टाइमिङ खेल: पाँच चरणमा बढ्दो गतिमा सिग्नललाई लक्षित आर्कभित्र रोक्नुहोस्।"},"thumb":"art:nebula","url":"","launch":"embedded","engine":"signal-drift","category":"Arcade","tags":["reflex"],"release":"2026-09-19","featured":true,"visible":true,"status":"published","access":"members","__href":"/games/signal-drift"},{"id":"g3","slug":"darkroom-runner","title":{"en":"Darkroom Runner","ne":"डार्करूम रनर"},"desc":{"en":"An experimental runner through corridors of unverified links. In development.","ne":"अप्रमाणित लिङ्कका गलियाराबाट दौडने प्रयोगात्मक खेल। निर्माणाधीन।"},"thumb":"art:horror","url":"","launch":"embedded","engine":"","category":"Experimental","tags":["runner"],"release":"2026-10-21","featured":false,"visible":true,"status":"draft","access":"members","__href":"/games/darkroom-runner"},{"id":"g4","slug":"market-signal","title":{"en":"Market Signal","ne":"मार्केट सिग्नल"},"desc":{"en":"An economics game about reading noisy signals. Planned for a future release.","ne":"कोलाहलपूर्ण संकेत पढ्ने अर्थशास्त्र खेल। आगामी संस्करणका लागि योजना।"},"thumb":"art:research","url":"","launch":"embedded","engine":"","category":"Educational","tags":["economics"],"release":"2026-11-20","featured":false,"visible":true,"status":"draft","access":"members","__href":"/games/market-signal"}],"cols":[{"key":"title","label":"Title"},{"key":"category","label":"Category"},{"key":"launch","label":"Launch"},{"key":"status","label":"Status"},{"key":"access","label":"Access"}]}]]}],null,"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$7","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@f","rootVaryParams":null,"needsRuntimeRequest":"$@10"}
