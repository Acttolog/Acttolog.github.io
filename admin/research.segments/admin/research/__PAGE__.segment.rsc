d practice.","ne":"डिजाइन, विधि र निष्कर्षलाई संरचित अभ्याससहित प्रस्तुत गर्ने।"},"icon":"chat","order":6,"status":"published","access":"public","visible":true},{"id":"s7","title":{"en":"Research Articles & Resources","ne":"अनुसन्धान लेख र स्रोत"},"summary":{"en":"Article structure, journal formatting and reusable templates.","ne":"लेख संरचना, जर्नल फर्माटिङ र पुनःप्रयोगयोग्य टेम्प्लेट।"},"icon":"layers","order":7,"status":"published","access":"public","visible":true},{"id":"s8","title":{"en":"Research Methodology Support","ne":"अनुसन्धान विधि सहयोग"},"summary":{"en":"Design selection, sampling, validity, reliability and justification.","ne":"डिजाइन छनोट, नमूना, वैधता, विश्वसनीयता र औचित्य।"},"icon":"sigma","order":8,"status":"published","access":"public","visible":true},{"id":"s9","title":{"en":"Formatting","ne":"फर्माटिङ"},"summary":{"en":"Institutional and journal formatting, headings, tables and figures.","ne":"संस्थागत र जर्नल फर्माटिङ, शीर्षक, तालिका र चित्र।"},"icon":"grid","order":9,"status":"published","access":"members","visible":true},{"id":"s10","title":{"en":"Referencing","ne":"सन्दर्भ सूची"},"summary":{"en":"APA, MLA, Chicago and institutional styles with consistency checks.","ne":"APA, MLA, Chicago र संस्थागत शैली, एकरूपता जाँचसहित।"},"icon":"link","order":10,"status":"published","access":"members","visible":true},{"id":"s11","title":{"en":"Revision","ne":"संशोधन"},"summary":{"en":"Structured revision cycles responding to supervisor comments.","ne":"परामर्शदाताको टिप्पणीमा आधारित संरचित संशोधन चक्र।"},"icon":"refresh","order":11,"status":"published","access":"members","visible":true},{"id":"s12","title":{"en":"Presentation Preparation","ne":"प्रस्तुति तयारी"},"summary":{"en":"Defence slides, timing, visuals and question handling.","ne":"डिफेन्स स्लाइड, समय व्यवस्थापन, भिजुअल र प्रश्न व्यवस्थापन।"},"icon":"screen","order":12,"status":"published","access":"members","visible":true}],"cols":[{"key":"title","label":"Title"},{"key":"order","label":"Order"},