ass","art":"research","order":1,"visible":true,"status":"published"},{"id":"entertainment","slug":"entertainment","name":{"en":"Entertainment","ne":"मनोरञ्जन"},"sub":{"en":"Stories & Digital Media","ne":"कथा र डिजिटल मिडिया"},"desc":{"en":"AI stories, comedy, drama, horror, short films, music and cinematic work from the Acttolog world.","ne":"एआई कथा, कमेडी, ड्रामा, हरर, छोटो चलचित्र, संगीत र सिनेमाटिक सामग्री।"},"route":"/entertainment","color":"#ff4ecd","icon":"play","art":"stage","order":2,"visible":true,"status":"published"},{"id":"academy","slug":"academy","name":{"en":"Academy","ne":"एकेडेमी"},"sub":{"en":"Learning & Knowledge","ne":"सिकाइ र ज्ञान"},"desc":{"en":"Courses, modules, lessons and resources on research, economics, finance, statistics, technology and AI.","ne":"अनुसन्धान, अर्थशास्त्र, वित्त, तथ्याङ्क, प्रविधि र एआईका पाठ्यक्रम र स्रोतहरू।"},"route":"/academy","color":"#7c5cff","icon":"book","art":"academy","order":3,"visible":true,"status":"published"},{"id":"games","slug":"games","name":{"en":"Games","ne":"खेलहरू"},"sub":{"en":"Interactive Experiences","ne":"अन्तरक्रियात्मक अनुभव"},"desc":{"en":"Browser games, mini games, educational play and experimental interactive experiences.","ne":"ब्राउजर खेल, मिनी खेल, शैक्षिक खेल र प्रयोगात्मक अनुभव।"},"route":"/games","color":"#3ddc97","icon":"game","art":"games","order":4,"visible":true,"status":"published"},{"id":"darkroom","slug":"darkroom","name":{"en":"Darkroom","ne":"डार्करूम"},"sub":{"en":"Digital Discovery & Resources","ne":"डिजिटल खोज र स्रोत"},"desc":{"en":"A verified discovery hub for official websites, tools, databases and hard-to-find resources.","ne":"आधिकारिक वेबसाइट, औजार, डाटाबेस र दुर्लभ स्रोतको प्रमाणित खोज केन्द्र।"},"route":"/darkroom","color":"#f5c26b","icon":"search","art":"editorial","order":5,"visible":true,"status":"published"}],"brand":"ACTTOLOG"}],["$","main",null,{"id":"main","children":["$","$L4",null,{"parallelRouterKey":"children","error":"$5","errorStyles":[],"errorScripts"