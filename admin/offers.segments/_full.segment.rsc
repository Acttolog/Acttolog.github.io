16:["$","$1","c",{"children":[["$","div",null,{"children":[["$","$L20",null,{"title":"Offers","desc":"Commercial offers across divisions — inquiry, purchase or both. Prices are editable, never hard-coded."}],["$","$L21",null,{"configured":false}],["$","$L22",null,{"rows":[{"id":"o1","slug":"thesyn-silver","division":"research","title":{"en":"Thesyn Silver","ne":"थेसिन सिल्भर"},"short":{"en":"Focused single-deliverable research support.","ne":"एकल डेलिभरेबल केन्द्रित अनुसन्धान सहयोग।"},"desc":{"en":"One chapter, one analysis or one structured consultation block, scoped in writing before work begins.","ne":"एउटा अध्याय, एउटा विश्लेषण वा एउटा संरचित परामर्श ब्लक — काम सुरु हुनुअघि लिखित कार्यक्षेत्रसहित।"},"npr":20000,"usd":150,"mode":"inquiry","features":[{"en":"Single deliverable","ne":"एकल डेलिभरेबल"},{"en":"Methodology review","ne":"विधि समीक्षा"},{"en":"One revision cycle","ne":"एक संशोधन चक्र"}],"terms":{"en":"Deliverable, timeline and revision count are confirmed in the written scope.","ne":"डेलिभरेबल, समयसीमा र संशोधन सङ्ख्या लिखित कार्यक्षेत्रमा तय हुन्छ।"},"art":"offers","accent":"#c9d4e5","status":"published","audience":"global","access":"public","validUntil":"2026-11-05","featured":false,"__href":"/offers/thesyn-silver"},{"id":"o2","slug":"thesyn-gold","division":"research","title":{"en":"Thesyn Gold","ne":"थेसिन गोल्ड"},"short":{"en":"Complete project support with scheduled reviews.","ne":"तालिकाबद्ध समीक्षासहित पूर्ण परियोजना सहयोग।"},"desc":{"en":"Planning, analysis and writing structure across the whole project, with analysis files handed over at the end.","ne":"परियोजनाभर योजना, विश्लेषण र लेखन संरचना, अन्त्यमा विश्लेषण फाइल हस्तान्तरणसहित।"},"npr":30000,"usd":225,"mode":"both","features":[{"en":"Multi-chapter scope","ne":"बहु-अध्याय कार्यक्षेत्र"},{"en":"Data analysis and diagnostics","ne":"डाटा विश्लेषण र डायग्नोस्टिक्स"},{"en":"Three revision cycles","ne":"तीन संशोधन चक्र"},{"en":"Scheduled review sessions","ne":"तालिकाबद्ध समीक्षा बैठक"}],"terms":{