0:{"buildId":"LJsmLpZYC0_30xDhMMCW6","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"children":[["$","$L2",null,{"title":"Offers","desc":"Commercial offers across divisions — inquiry, purchase or both. Prices are editable, never hard-coded."}],["$","$L3",null,{"configured":false}],["$","$L4",null,{"rows":[{"id":"o1","slug":"thesyn-silver","division":"research","title":{"en":"Thesyn Silver","ne":"थेसिन सिल्भर"},"short":{"en":"Focused single-deliverable research support.","ne":"एकल डेलिभरेबल केन्द्रित अनुसन्धान सहयोग।"},"desc":{"en":"One chapter, one analysis or one structured consultation block, scoped in writing before work begins.","ne":"एउटा अध्याय, एउटा विश्लेषण वा एउटा संरचित परामर्श ब्लक — काम सुरु हुनुअघि लिखित कार्यक्षेत्रसहित।"},"npr":20000,"usd":150,"mode":"inquiry","features":[{"en":"Single deliverable","ne":"एकल डेलिभरेबल"},{"en":"Methodology review","ne":"विधि समीक्षा"},{"en":"One revision cycle","ne":"एक संशोधन चक्र"}],"terms":{"en":"Deliverable, timeline and revision count are confirmed in the written scope.","ne":"डेलिभरेबल, समयसीमा र संशोधन सङ्ख्या लिखित कार्यक्षेत्रमा तय हुन्छ।"},"art":"offers","accent":"#c9d4e5","status":"published","audience":"global","access":"public","validUntil":"2026-11-05","featured":false,"__href":"/offers/thesyn-silver"},{"id":"o2","slug":"thesyn-gold","division":"research","title":{"en":"Thesyn Gold","ne":"थेसिन गोल्ड"},"short":{"en":"Complete project support with scheduled reviews.","ne":"तालिकाबद्ध समीक्षासहित पूर्ण परियोजना सहयोग।"},"desc":{"en":"Planning, analysis and writing structure across the whole project, with analysis files handed over at the end.","ne":"परियोजनाभर योजना, विश्लेषण र लेखन संरचना, अन्त्यमा विश्लेषण फाइल हस्तान्तरणसहित।"},"npr":30000,"usd":225,"mode":"both","features":[{"en":"Multi-chapter scope","ne":"बहु-अध्याय कार्यक्षेत्र"},{"en":"Data analysis and diagnostics","ne":"डाटा विश्लेषण र डायग्नोस्टिक्स"},{"en":"Three revision cycles","ne":"तीन संशोधन चक्र"},{"en":"Scheduled review sessions","ne":"तालिकाबद्ध समीक्षा बैठक"}],"terms":{"en":"Includes one handover walkthrough session.","ne":"एक हस्तान्तरण वॉकथ्रु बैठक समावेश।"},"art":"offers","accent":"#f5c26b","status":"published","audience":"global","access":"members","validUntil":"2026-10-21","featured":true,"__href":"/offers/thesyn-gold"},{"id":"o3","slug":"thesyn-diamond","division":"research","title":{"en":"Thesyn Diamond","ne":"थेसिन डाइमन्ड"},"short":{"en":"Full programme support to viva preparation.","ne":"भाइभा तयारीसम्म पूर्ण कार्यक्रम सहयोग।"},"desc":{"en":"Proposal to final document, reproducible analysis handover, viva preparation and Academy access included.","ne":"प्रस्तावदेखि अन्तिम कागजातसम्म, पुनरुत्पादनयोग्य विश्लेषण, भाइभा तयारी र एकेडेमी पहुँच समावेश।"},"npr":60000,"usd":450,"mode":"both","features":[{"en":"Proposal to final document","ne":"प्रस्तावदेखि अन्तिम कागजात"},{"en":"Unlimited revision cycles in term","ne":"अवधिभित्र असीमित संशोधन"},{"en":"Viva preparation","ne":"भाइभा तयारी"},{"en":"Academy access","ne":"एकेडेमी पहुँच"}],"terms":{"en":"Programme length and milestones agreed in the written scope.","ne":"कार्यक्रम अवधि र माइलस्टोन लिखित कार्यक्षेत्रमा सहमत।"},"art":"offers","accent":"#8ce9ff","status":"published","audience":"global","access":"members","validUntil":"2026-11-20","featured":false,"__href":"/offers/thesyn-diamond"},{"id":"o4","slug":"academy-access","division":"academy","title":{"en":"Academy Access","ne":"एकेडेमी पहुँच"},"short":{"en":"Full course library with modules, lessons and resources.","ne":"मोड्युल, पाठ र स्रोतसहित पूर्ण पाठ्यक्रम पुस्तकालय।"},"desc":{"en":"Access to published Acttolog Academy courses covering research methods, data analysis and immersive web.","ne":"प्रकाशित Acttolog एकेडेमी पाठ्यक्रममा पहुँच — अनुसन्धान विधि, डाटा विश्लेषण र इमर्सिभ वेब।"},"npr":6000,"usd":45,"mode":"both","features":[{"en":"All published courses","ne":"सबै प्रकाशित पाठ्यक्रम"},{"en":"Downloadable resources","ne":"डाउनलोडयोग्य स्रोत"},{"en":"Bilingual lessons","ne":"