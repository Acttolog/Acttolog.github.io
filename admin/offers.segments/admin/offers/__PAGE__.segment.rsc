0:{"buildId":"aIURN08RMiMzs9XHB4iDC","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"children":[["$","$L2",null,{"title":"Offers","desc":"Commercial offers across divisions — inquiry, purchase or both. Prices are editable, never hard-coded."}],["$","$L3",null,{"configured":false}],["$","$L4",null,{"rows":[{"id":"o1","slug":"thesyn-silver","division":"research","title":{"en":"Thesyn Silver","ne":"थेसिन सिल्भर"},"short":{"en":"Focused single-deliverable research support.","ne":"एकल डेलिभरेबल केन्द्रित अनुसन्धान सहयोग।"},"desc":{"en":"One chapter, one analysis or one structured consultation block, scoped in writing before work begins.","ne":"एउटा अध्याय, एउटा विश्लेषण वा एउटा संरचित परामर्श ब्लक — काम सुरु हुनुअघि लिखित कार्यक्षेत्रसहित।"},"npr":20000,"usd":150,"mode":"inquiry","features":[{"en":"Single deliverable","ne":"एकल डेलिभरेबल"},{"en":"Methodology review","ne":"विधि समीक्षा"},{"en":"One revision cycle","ne":"एक संशोधन चक्र"}],"terms":{"en":"Deliverable, timeline and revision count are confirmed in the written scope.","ne":"डेलिभरेबल, समयसीमा र संशोधन सङ्ख्या लिखित कार्यक्षेत्रमा तय हुन्छ।"},"art":"offers","accent":"#c9d4e5","status":"published","audience":"global","access":"public","validUntil":"2026-11-05","featured":false,"__href":"/offers/thesyn-silver"},{"id":"o2","slug":"thesyn-gold","division":"research","title":{"en":"Thesyn Gold","ne":"थेसिन गोल्ड"},"short":{"en":"Complete project support with scheduled reviews.","ne":"तालिकाबद्ध समीक्षासहित पूर्ण परियोजना सहयोग।"},"desc":{"en":"Planning, analysis and writing structure across the whole project, with analysis files handed over at the end.","ne":"परियोजनाभर योजना, विश्लेषण र लेखन संरचना, अन्त्यमा विश्लेषण फाइल हस्तान्तरणसहित।"},"npr":30000,"usd":225,"mode":"both","features":[{"en":"Multi-chapter scope","ne":"बहु-अध्याय कार्यक्षेत्र"},{"en":"Data analysis and diagnostics","ne":"डाटा विश्लेषण र डायग्नोस्टिक्स"},{"en":"Three revision cycles","ne":"तीन संशोधन चक्र"},{"en":"Scheduled review sessions","ne":"तालिकाबद्ध समीक्षा बैठक"}],"terms":{"en":"Includes one handover walkthrough session.","ne":"एक हस्तान्तरण वॉकथ्रु बैठक समावेश।"},"art":"offers","accent":"#f5c26b","status":"published","audience":"global","access":"members","validUntil":"2026-10-21","featured":true,"__href":"/offers/thesyn-gold"},{"id":"o3","slug":"thesyn-diamond","division":"research","title":{"en":"Thesyn Diamond","ne":"थेसिन डाइमन्ड"},"short":{"en":"Full programme support to viva preparation.","ne":"भाइभा तयारीसम्म पूर्ण कार्यक्रम सहयोग।"},"desc":{"en":"Proposal to final document, reproducible analysis handover, viva preparation and Academy access included.","ne":"प्रस्तावदेखि अन्तिम कागजातसम्म, पुनरुत्पादनयोग्य विश्लेषण, भाइभा तयारी र एकेडेमी पहुँच समावेश।"},"npr":60000,"usd":450,"mode":"both","features":[{"en":"Proposal to final document","ne":"प्रस्तावदेखि अन्तिम कागजात"},{"en":"Unlimited revision cycles in term","ne":"अवधिभित्र असीमित संशोधन"},{"en":"Viva preparation","ne":"भाइभा तयारी"},{"en":"Academy access","ne":"एकेडेमी पहुँच"}],"terms":{"en":"Programme length and milestones agreed in the written scope.","ne":"कार्यक्रम अवधि र माइलस्टोन लिखित कार्यक्षेत्रमा सहमत।"},"art":"offers","accent":"#8ce9ff","status":"published","audience":"global","access":"members","validUntil":"2026-11-20","featured":false,"__href":"/offers/thesyn-diamond"},{"id":"o4","slug":"academy-access","division":"academy","title":{"en":"Academy Access","ne":"एकेडेमी पहुँच"},"short":{"en":"Full course library with modules, lessons and resources.","ne":"मोड्युल, पाठ र स्रोतसहित पूर्ण पाठ्यक्रम पुस्तकालय।"},"desc":{"en":"Access to published Acttolog Academy courses covering research methods, data analysis and immersive web.","ne":"प्रकाशित Acttolog एकेडेमी पाठ्यक्रममा पहुँच — अनुसन्धान विधि, डाटा विश्लेषण र इमर्सिभ वेब।"},"npr":6000,"usd":45,"mode":"both","features":[{"en":"All published courses","ne":"सबै प्रकाशित पाठ्यक्रम"},{"en":"Downloadable resources","ne":"डाउनलोडयोग्य स्रोत"},{"en":"Bilingual lessons","ne":"द्विभाषिक पाठ"}],"terms":{"en":"Access is tied to the signed-in Google account and cannot be shared.","ne":"पहुँच साइन-इन Google खातासँग जोडिन्छ, साझा गर्न मिल्दैन।"},"art":"academy","accent":"#7c5cff","status":"published","audience":"global","access":"public","validUntil":"2027-01-19","featured":true,"__href":"/offers/academy-access"},{"id":"o5","slug":"entertainment-studio","division":"entertainment","title":{"en":"Entertainment Studio Pass","ne":"मनोरञ्जन स्टुडियो पास"},"short":{"en":"Members-only media library access.","ne":"सदस्य-विशेष मिडिया पुस्तकालय पहुँच।"},"desc":{"en":"Full-length media, members-only cuts and early access to new Acttolog productions.","ne":"पूर्ण मिडिया, सदस्य-विशेष कट र नयाँ प्रस्तुतिको अग्रिम पहुँच।"},"npr":3000,"usd":23,"mode":"inquiry","features":[{"en":"Full media access","ne":"पूर्ण मिडिया पहुँच"},{"en":"Members-only cuts","ne":"सदस्य-विशेष कट"},{"en":"Early releases","ne":"अग्रिम रिलिज"}],"terms":{"en":"Inquiry-based at launch; online purchase activates when a gateway is authorised.","ne":"सुरुमा सोधाईमा आधारित; गेटवे अधिकृत भएपछि अनलाइन खरिद खुल्छ।"},"art":"stage","accent":"#ff4ecd","status":"published","audience":"global","access":"public","validUntil":"2026-12-20","featured":false,"__href":"/offers/entertainment-studio"},{"id":"o6","slug":"darkroom-pro","division":"darkroom","title":{"en":"Darkroom Pro (planned)","ne":"डार्करूम प्रो (योजना)"},"short":{"en":"Advanced collections and monitoring — not yet launched.","ne":"उन्नत संग्रह र निगरानी — अझै सुरु भएको छैन।"},"desc":{"en":"Planned premium layer: private collections, saved searches and broken-link monitoring. Disabled until the feature actually exists.","ne":"योजना गरिएको प्रिमियम तह: निजी संग्रह, सुरक्षित खोज र बिग्रिएको लिङ्क निगरानी। सुविधा तयार नभएसम्म बन्द।"},"npr":0,"usd":0,"mode":"inquiry","features":[{"en":"Private collections","ne":"निजी संग्रह"},{"en":"Saved searches","ne":"सुरक्षित खोज"},{"en":"Broken-link monitoring","ne":"बिग्रिएको लिङ्क निगरानी"}],"terms":{"en":"Not purchasable. Listed to show the roadmap only.","ne":"खरिदयोग्य छैन। रोडम्याप देखाउन मात्र सूचीबद्ध।"},"art":"editorial","accent":"#f5c26b","status":"draft","audience":"global","access":"public","validUntil":"","featured":false,"__href":"/offers/darkroom-pro"},{"id":"o7","slug":"acttolog-member-join","division":"darkroom","title":{"en":"Acttolog Member — Join Free","ne":"Acttolog सदस्य — निःशुल्क सामेल"},"short":{"en":"One Google click: saved items, Academy gate, games progress, AI conversations.","ne":"एक Google क्लिक: सुरक्षित सामग्री, एकेडेमी, खेल प्रगति, AI कुराकानी।"},"desc":{"en":"Membership is free and private. No forms, no fees — continue with Google and the protected layers of the Acttolog World open: Academy courses, game scores, saved Darkroom resources and saved AI conversations.","ne":"सदस्यता निःशुल्क र निजी छ। कुनै फारम छैन — Google बाट जारी राख्नुहोस् र सुरक्षित तहहरू खुल्नेछन्।"},"npr":0,"usd":0,"mode":"inquiry","features":[{"en":"Private saved items & recent history","ne":"निजी सुरक्षित सामग्री"},{"en":"Academy + Games member layers","ne":"एकेडेमी + खेल सदस्य तह"},{"en":"Saved AI conversations","ne":"सुरक्षित AI कुराकानी"},{"en":"Darkroom resource submissions","ne":"डार्करूम स्रोत पेश गर्ने सुविधा"}],"terms":{"en":"Free forever. Profiles private by default.","ne":"सधैं निःशुल्क। प्रोफाइल निजी।"},"validUntil":"","accent":"#35e0ff","art":"nebula","status":"published","access":"public","audience":"global","featured":true,"visible":true,"__href":"/offers/acttolog-member-join"},{"id":"o8","slug":"thesyn-workshop-pass","division":"research","title":{"en":"Thesyn Workshop Pass","ne":"थेसिन वर्कसप पास"},"short":{"en":"Live cohort workshops: proposal clinic, SPSS/STATA lab, viva mock board.","ne":"लाइभ वर्कसप: प्रस्ताव क्लिनिक, SPSS/STATA ल्याब, भाइभा मक बोर्ड।"},"desc":{"en":"A recurring seat in small-group Thesyn Research workshops — bring your own data and leave with a defended structure.","ne":"साना समूहका वर्कसपमा आफ्नै डाटा ल्याउनुहोस् र बचाउयोग्य संरचनासँग जानुहोस्।"},"npr":5000,"usd":40,"mode":"both","features":[{"en":"Monthly proposal clinic","ne":"मासिक प्रस्ताव क्लिनिक"},{"en":"Analysis lab with screen-share","ne":"स्क्रिन-सेयरसहित विश्लेषण ल्याब"},{"en":"Viva mock board session","ne":"भाइभा मक बोर्ड"}],"terms":{"en":"Seat per cohort; schedule announced in-app.","ne":"प्रत्येक कोहर्टमा सिट; तालिका अनुभित्र घोषणा।"},"validUntil":"","accent":"#f5c26b","art":"offers","status":"published","access":"public","audience":"global","featured":false,"visible":true,"__href":"/offers/thesyn-workshop-pass"},{"id":"o9","slug":"gmax-story-pass","division":"entertainment","title":{"en":"Gmax Story Pass","ne":"Gmax स्टोरी पास"},"short":{"en":"Members cut of Gmax Story universes — TikTok, YouTube and Facebook serials.","ne":"Gmax स्टोरी ब्रह्माण्डको सदस्य कट — TikTok, YouTube र Facebook सिरियल।"},"desc":{"en":"Follow the canon across platforms: director notes, early cuts and members-only episodes from the Gmax Story channels.","ne":"प्लेटफर्मभर कथा पछ्याउनुहोस्: निर्देशक नोट, प्रारम्भिक कट र सदस्य-विशेष एपिसोड।"},"npr":999,"usd":8,"mode":"both","features":[{"en":"Members-only episodes","ne":"सदस्य-विशेष एपिसोड"},{"en":"Director notes & early cuts","ne":"निर्देशक नोट र प्रारम्भिक कट"},{"en":"Community story votes","ne":"कथा मतदान"}],"terms":{"en":"Digital membership; cancels any time.","ne":"डिजिटल सदस्यता; जुनसुकै बेला रद्द।"},"validUntil":"","accent":"#ff4ecd","art":"stage","status":"published","access":"public","audience":"global","featured":false,"visible":true,"__href":"/offers/gmax-story-pass"}],"cols":[{"key":"title","label":"Title"},{"key":"division","label":"Division"},{"key":"npr","label":"NPR"},{"key":"usd","label":"USD"},{"key":"mode","label":"Mode"},{"key":"status","label":"Status"}]}]]}],null,"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"},{"rsc":"$Ld","isPartia