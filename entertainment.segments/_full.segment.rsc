27:["$","section",null,{"className":"sec nb-sec","id":"en-notices","children":["$","div",null,{"className":"wrap","children":["$","$L21",null,{"children":["$","$L2f",null,{"notices":[{"id":"en-premiere","scope":"entertainment","category":"release","kind":"notice","title":{"en":"Nepal Series — new screening live","ne":"नेपाल सिरिज — नयाँ प्रदर्शनी live"},"org":{"en":"ACTTOLOG · Entertainment","ne":"ACTTOLOG · मनोरञ्जन"},"summary":{"en":"A new featured screening is now streaming in the Entertainment hall. Open the hall to watch.","ne":"नयाँ विशेष प्रदर्शनी अब मनोरञ्जन हलमा स्ट्रिम हुँदैछ। हेर्न हल खोल्नुहोस्।"},"detail":{"en":"Open the hall to watch the featured screening. Each title in the hall has its own page with the release date and the category it belongs to, and the Nepal Series titles are ACTTOLOG’s own productions rather than embedded third-party uploads.","ne":"विशेष प्रदर्शन हेर्न हल खोल्नुहोस्। हलको प्रत्येक शीर्षकको छुट्टै पृष्ठ हुन्छ, जसमा प्रकाशन मिति र त्यो पर्ने श्रेणी हुन्छ, र नेपाल सिरिजका शीर्षक तेस्रो पक्षको अपलोड होइनन् — एक्टोलग आफ्नै निर्माण हुन्।"},"sourceUrl":"/entertainment","sourceName":"Entertainment","tags":["screening","nepal series","featured"],"posted":"2026-11-14","verifiedOn":"2026-11-17","featured":true},{"id":"en-schedule","scope":"entertainment","category":"event","kind":"notice","title":{"en":"Weekend watch-list refreshed","ne":"सप्ताहन्तको हेर्ने-सूची परिमार्जन"},"org":{"en":"ACTTOLOG · Entertainment","ne":"ACTTOLOG · मनोरञ्जन"},"summary":{"en":"Categories and featured picks updated for the weekend — documentaries, shorts and Nepal stories.","ne":"सप्ताहन्तका लागि श्रेणी र विशेष छनोट अपडेट — वृत्तचित्र, छोटो र नेपालका कथा।"},"detail":{"en":"The weekend watch-list is an editorial pick from the hall’s own catalogue: documentaries, shorts and Nepal stories. It is refreshed by hand, not by a recommendation engine, and each pick links straight to its screening page.","ne":"सप्ताहन्तको दर्शन सूची हलकै सूचीबाट सम्पादकीय छनोट हो: वृत्तचित्र, छोटो चलचित्र र नेपालका कथा। यो सिफारिस इन्जिनले नभई हातैले अद्यावधिक गरिन्छ, र प्रत्येक छनोट सिधै आफ्नो प्रदर्शन पृष्ठमा जोडिन्छ।"},"sourceUrl":"/entertainment","sourceName":"Entertainment","tags":["watch-list","documentary","weekend"],"posted":"2026-11-15","verifiedOn":"2026-11-17","closesOn":"2026-11-30"},{"id":"en-moic","scope":"entertainment","category":"government","kind":"source","title":{"en":"Ministry of Information and Communications","ne":"सञ्चार तथा सूचना प्रविधि मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Film certification, media policy and broadcasting notices.","ne":"चलचित्र प्रमाणीकरण, मिडिया नीति र प्रसारण सूचना।"},"detail":{"en":"The ministry behind the Film Development Board and national broadcasting policy. Censor certificates, film-industry notices and media regulations are published here — the official record behind a Nepali release.","ne":"चलचित्र विकास बोर्ड र राष्ट्रिय प्रसारण नीतिको जिम्मेवारी बोकेको मन्त्रालय। सेन्सर प्रमाणपत्र, चलचित्र उद्योग सूचना र मिडिया नियम यहाँ प्रकाशित हुन्छन्।"},"sourceUrl":"https://moic.gov.np","sourceName":"moic.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["film","policy","media"],"posted":"2026-11-18","verifiedOn":"2026-11-18"}],"categories":[{"id":"government","label":{"en":"Government","ne":"सरकारी"},"color":"var(--cy)","count":1},{"id":"release","label":{"en":"Release","ne":"रिलिज"},"color":"var(--mg)","count":1},{"id":"event","label":{"en":"Event","ne":"कार्यक्रम"},"color":"var(--mg)","count":1}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"en","variant":"section","accent":"var(--mg)","title":"$undefined","subtitle":{"en":"Premiere and schedule notices from the entertainment desk, plus the ministry that publishes media-sector notices.","ne":"मनोरञ्जन डेस्कका प्रिमियर र तालिका सूचना, र सञ्चार क्षेत्रका सूचना प्रकाशित गर्ने मन्त्रालय।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:48.931Z"},"mof.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:51.114Z"},"mofaga.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:45:23.285Z"},"gorkhapatra.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:24.060Z"},"nea.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:25.358Z"},"ntc.net.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:26.993Z"},"noc.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:28.884Z"},"vacancy.nepalairlines.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:31.583Z"},"epf.org.np":{"status":"reachable"