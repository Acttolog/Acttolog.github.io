a:["$","section",null,{"className":"sec nb-sec","id":"ac-notices","children":["$","div",null,{"className":"wrap","children":["$","$L3",null,{"children":["$","$L17",null,{"notices":[{"id":"ac-moe","scope":"academy","category":"government","kind":"source","title":{"en":"Ministry of Education, Science & Technology","ne":"शिक्षा, विज्ञान तथा प्रविधि मन्त्रालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Scholarship, teacher-licensing and education-sector notices relevant to students and educators.","ne":"विद्यार्थी र शिक्षकसँग सम्बन्धित छात्रवृत्ति, शिक्षक-इजाजत र शिक्षा-क्षेत्रका सूचना।"},"detail":{"en":"The Ministry of Education, Science and Technology publishes scholarship calls, teacher-licensing notices and education-sector circulars. Scholarship advertisements name the level, the quota and the submitting office; teacher-licensing notices are administered through the education bodies named in the notice itself.","ne":"शिक्षा, विज्ञान तथा प्रविधि मन्त्रालयले छात्रवृत्ति आह्वान, शिक्षक अनुमतिपत्र सूचना र शिक्षा क्षेत्रका परिपत्र प्रकाशित गर्छ। छात्रवृत्ति विज्ञापनमा तह, कोटा र बुझाउने कार्यालय खुलाइन्छ; शिक्षक अनुमतिपत्रका सूचना सूचनामै नाम तोकिएका शिक्षा निकायमार्फत सञ्चालित हुन्छन्।"},"sourceUrl":"https://moe.gov.np","sourceName":"moe.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["scholarship","education","licensing"],"posted":"2026-11-17","verifiedOn":"2026-11-17"},{"id":"ac-enroll","scope":"academy","category":"course","kind":"notice","title":{"en":"New course open for enrollment","ne":"नयाँ पाठ्यक्रम दर्ताका लागि खुला"},"org":{"en":"ACTTOLOG · Academy","ne":"ACTTOLOG · एकेडेमी"},"summary":{"en":"A new module-based course is live. Public lessons are free; members unlock the full track.","ne":"नयाँ मोड्युल-आधारित पाठ्यक्रम live छ। सार्वजनिक पाठ निःशुल्क; सदस्यले पूरा ट्र्याक खोल्छन्।"},"detail":{"en":"Courses are module-based: public lessons are open to everyone, and the full track unlocks for members. The lesson order, the module map and the estimated time are shown before you enroll, so you can judge the commitment first.","ne":"पाठ्यक्रम मोड्युलमा आधारित छन्: सार्वजनिक पाठ सबैका लागि खुला छन्, र पूरा धार सदस्यका लागि खुल्छ। भर्ना हुनुअघि पाठको क्रम, मोड्युल नक्सा र अनुमानित समय देखाइन्छ, त्यसैले पहिले समय दिन सक्ने कि भनेर आँकलन गर्न सकिन्छ।"},"sourceUrl":"/academy","sourceName":"Academy","tags":["course","enrollment","modules"],"posted":"2026-11-08","verifiedOn":"2026-11-17","closesOn":"2026-12-15","featured":true},{"id":"ac-path","scope":"academy","category":"course","kind":"notice","title":{"en":"Learning paths & progress tracking","ne":"सिकाइ मार्ग र प्रगति ट्र्याकिङ"},"org":{"en":"ACTTOLOG · Academy","ne":"ACTTOLOG · एकेडेमी"},"summary":{"en":"Follow a structured path lesson by lesson; your progress is saved on this device.","ne":"पाठ-पाठमा संरचित मार्ग पछ्याउनुहोस्; तपाईंको प्रगति यही यन्त्रमा सुरक्षित हुन्छ।"},"detail":{"en":"A learning path is an ordered sequence of lessons with a progress marker at each step. Progress is stored on this device only — it is not synced to an account, so clearing this site’s data resets it.","ne":"सिकाइ धार पाठहरूको क्रमबद्ध शृंखला हो, प्रत्येक चरणमा प्रगति चिन्ह हुन्छ। प्रगति यसै यन्त्रमा मात्र राखिन्छ — खातासँग सिंक हुँदैन, त्यसैले यो साइटको डाटा मेटाउँदा प्रगति पनि रिसेट हुन्छ।"},"sourceUrl":"/academy","sourceName":"Academy","tags":["path","progress","free"],"posted":"2026-11-11","verifiedOn":"2026-11-17"},{"id":"ac-pu","scope":"academy","category":"government","kind":"source","title":{"en":"Pokhara University","ne":"पोखरा विश्वविद्यालय"},"org":{"en":"Pokhara University","ne":"पोखरा विश्वविद्यालय"},"summary":{"en":"Admission notices, exam routines and result publication.","ne":"भर्ना सूचना, परीक्षा तालिका र नतिजा प्रकाशन।"},"detail":{"en":"Public university in Gandaki Province running engineering, management and health programmes through affiliated colleges. Entrance notices and semester routines appear on its own portal first.","ne":"गण्डकी प्रदेशको सार्वजनिक विश्वविद्यालय, सम्बन्धन प्राप्त कलेजहरूमार्फत इन्जिनियरिङ, व्यवस्थापन र स्वास्थ्य कार्यक्रम सञ्चालन। प्रवेश सूचना र सेमेस्टर तालिका पहिले यहीँ आउँछन्।"},"sourceUrl":"https://pu.edu.np","sourceName":"pu.edu.np","location":{"en":"Pokhara","ne":"पोखरा"},"tags":["university","admission","exam"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"ac-purbanchal","scope":"academy","category":"government","kind":"source","title":{"en":"Purbanchal University","ne":"पूर्वाञ्चल विश्वविद्यालय"},"org":{"en":"Purbanchal University","ne":"पूर्वाञ्चल विश्वविद्यालय"},"summary":{"en":"Entrance applications, affiliation notices and academic calendar.","ne":"प्रवेश आवेदन, सम्बन्धन सूचना र शैक्षिक पात्रो।"},"detail":{"en":"Public university headquartered in Biratnagar with a large affiliated-college network across the eastern hills and Terai. Affiliation and entrance notices are the ones students most often miss.","ne":"विराटनगरमा मुख्यालय भएको सार्वजनिक विश्वविद्यालय, पूर्वी पहाड र तराईभरि ठूलो सम्बन्धन सञ्जाल। सम्बन्धन र प्रवेश सूचना विद्यार्थीले प्रायः छुटाउँछन्।"},"sourceUrl":"https://purbanchaluniversity.edu.np","sourceName":"purbanchaluniversity.edu.np","location":{"en":"Biratnagar","ne":"विराटनगर"},"tags":["university","affiliation","entrance"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"ac-neb","scope":"academy","category":"exam","kind":"source","title":{"en":"National Examination Board","ne":"राष्ट्रिय परीक्षा बोर्ड"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"SEE and Grade 11–12 exam notices, routines and results.","ne":"एसईई र कक्षा ११–१२ परीक्षा सूचना, तालिका र नतिजा।"},"detail":{"en":"Conducts the secondary and higher-secondary leaving examinations. Grade-sheet corrections, exam centre changes and result publication dates are announced here, not by the schools.","ne":"माध्यमिक र उच्च माध्यमिक उत्तीर्ण परीक्षा सञ्चालन गर्छ। ग्रेड-शीट संशोधन, परीक्षा केन्द्र परिवर्तन र नतिजा प्रकाशन मिति यहाँ घोषणा हुन्छन्।"},"sourceUrl":"https://neb.gov.np","sourceName":"neb.gov.np","location":{"en":"Bhaktapur","ne":"भक्तपुर"},"tags":["see","exam","result"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"ac-see","scope":"academy","category":"exam","kind":"source","title":{"en":"Office of the Controller of Examinations","ne":"परीक्षा नियन्त्रक कार्यालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"SEE examination control notices and grade-sheet services.","ne":"एसईई परीक्षा नियन्त्रण सूचना र ग्रेड-शीट सेवा।"},"detail":{"en":"The examination controller’s office at Sanothimi handles SEE registration, verification and grade-sheet reissue. It is the counter of record when a result needs correcting.","ne":"सानोठिमीस्थित परीक्षा नियन्त्रक कार्यालयले एसईई दर्ता, प्रमाणीकरण र ग्रेड-शीट पुनःजारी हेर्छ। नतिजा सच्याउनुपर्दा यही आधिकारिक कार्यालय हो।"},"sourceUrl":"https://see.gov.np","sourceName":"see.gov.np","location":{"en":"Sanothimi, Bhaktapur","ne":"सानोठिमी, भक्तपुर"},"tags":["see","verification","exam"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"ac-afu","scope":"academy","category":"government","kind":"source","title":{"en":"Agriculture and Forestry University","ne":"कृषि तथा वन विज्ञान विश्वविद्यालय"},"org":{"en":"Agriculture and Forestry University","ne":"कृषि तथा वन विज्ञान विश्वविद्यालय"},"summary":{"en":"Agriculture, veterinary and forestry admission notices.","ne":"कृषि, पशु चिकित्सा र वन विज्ञान भर्ना सूचना।"},"detail":{"en":"Nepal’s dedicated agriculture and forestry university, based in Rampur, Chitwan. Entrance notices for BSc Ag, BVSc and BSc Forestry are published on its own portal each intake.","ne":"चितवनको रामपुरमा आधारित नेपालको समर्पित कृषि तथा वन विश्वविद्यालय। हरेक भर्नामा प्रवेश सूचना आफ्नै पोर्टलमा प्रकाशित हुन्छ।"},"sourceUrl":"https://afu.edu.np","sourceName":"afu.edu.np","location":{"en":"Rampur, Chitwan","ne":"रामपुर, चितवन"},"tags":["agriculture","forestry","admission"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"ac-ioe","scope":"academy","category":"government","kind":"source","title":{"en":"Institute of Engineering, Tribhuvan University","ne":"इन्जिनियरिङ अध्ययन संस्थान, त्रिभुवन विश्वविद्यालय"},"org":{"en":"Tribhuvan University","ne":"त्रिभुवन विश्वविद्यालय"},"summary":{"en":"BE entrance notices, seat allocation and exam routines.","ne":"बीई प्रवेश सूचना, सिट बाँडफाँट र परीक्षा तालिका।"},"detail":{"en":"The engineering institute behind Pulchowk, Thapathali and the constituent campuses. Its entrance examination notice sets the dates every engineering aspirant in Nepal works to.","ne":"पुल्चोक, ठापाथली र आङ्गिक क्याम्पसहरू सञ्चालन गर्ने इन्जिनियरिङ संस्थान। यसको प्रवेश परीक्षा सूचनाले नेपालका सबै इन्जिनियरिङ आकाङ्क्षीको मिति तय गर्छ।"},"sourceUrl":"https://ioe.tu.edu.np","sourceName":"ioe.tu.edu.np","location":{"en":"Lalitpur","ne":"ललितपुर"},"tags":["engineering","entrance","ioe"],"posted":"2026-11-18","verifiedOn":"2026-11-18"}],"categories":[{"id":"government","label":{"en":"Government","ne":"सरकारी"},"color":"var(--cy)","count":5},{"id":"exam","label":{"en":"Exam","ne":"परीक्षा"},"color":"var(--ok)","count":2},{"id":"course","label":{"en":"Course","ne":"पाठ्यक्रम"},"color":"var(--vi)","count":2}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"en","variant":"section","accent":"var(--vi)","subtitle":{"en":"Enrolment and learning-path notices, plus the official university and examination portals.","ne":"भर्ना र सिकाइ-मार्ग सूचना, र आधिकारिक विश्वविद्यालय तथा परीक्षा पोर्टलहरू।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:48.931Z"},"mof.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:51.114Z"},"mofaga.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:45:23.285Z"},"gorkhapatra.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:24.060Z"},"nea.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:25.358Z"},"ntc.net.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:26.993Z"},"noc.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:28.884Z"},"vacancy.nepalairlines.com.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:31.583Z"},"epf.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:32.487Z"},"nlk.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:45:33.201Z"},"ddc.gov.np":{"status":"unreachable","checkedAt":"2026-11-17T23:46:05.372Z"},"caanepal.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:06.687Z"},"jobs.nrb.org.np":{"status":"reachable","checkedAt":"2026-11-17T23:46:07.392Z"},"nepalbank.com.np":{"status":"r