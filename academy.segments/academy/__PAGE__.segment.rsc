ull,{"children":["$","div",null,{"className":"panel mb-8 p-6 sm:p-8","children":["$","div",null,{"className":"grid items-center gap-8 lg:grid-cols-[1.2fr_.8fr]","children":[["$","div",null,{"children":[["$","div",null,{"className":"eyebrow mb-3","children":"LEARNING & KNOWLEDGE"}],["$","p",null,{"className":"mut text-[13.8px] leading-relaxed","children":"Acttolog Academy turns research practice into structured learning. Courses are built from modules, modules from lessons, and every lesson ends with something you keep — a template, a checklist or a dataset."}],["$","p",null,{"className":"dim mt-3 text-[12.8px] leading-relaxed","children":"Acttolog एकेडेमीले अनुसन्धान अभ्यासलाई संरचित सिकाइमा बदल्छ। पाठ्यक्रम मोड्युलबाट, मोड्युल पाठबाट बन्छन्, र हरेक पाठको अन्त्यमा तपाईंले राख्न सकिने कुरा हुन्छ — टेम्प्लेट, चेकलिस्ट वा डाटासेट।"}],["$","div",null,{"className":"mono dim mt-5 flex flex-wrap gap-2 text-[10.5px] tracking-[.16em]","children":["$","span",null,{"className":"chip","children":"COURSES → MODULES → LESSONS → RESOURCES"}]}]]}],["$","div",null,{"className":"rounded-xl border p-5","style":{"borderColor":"var(--line)","background":"var(--panel2)"},"children":[["$","div",null,{"className":"mono dim mb-3 text-[10.5px] tracking-[.2em]","children":"PUBLIC NOTE"}],["$","p",null,{"className":"mut text-[12.9px] leading-relaxed","children":"The Academy is a protected area. Guests see the introduction and course list only; lessons open after “Continue with Google”."}]]}]]}]}]}],["$","$L6",null,{"courses":[{"id":"c1","slug":"research-methods-foundations","title":{"en":"Research Methods Foundations","ne":"अनुसन्धान विधिको आधार"},"level":"Beginner","summary":{"en":"Build a defensible research design from a vague idea: questions, constructs, sampling, ethics and a written methodology.","ne":"अस्पष्ट idea बाट बलियो अनुसन्धान डिजाइन बनाउने — प्रश्न, कन्स्ट्रक्ट, नमूना, नैतिकता र लिखित विधि।"},"image":"art:academy","duration":{"en":"6 weeks","ne":"६ हप्ता"},"featured":true,"status":"published","access":"members","audience":"global","resources":[{"en":"Methodology template","ne":"विधि टेम्प्लेट"},{"en":"Research question worksheet","ne":"प्रश्न कार्यपत्र"},{"en":"Ethics checklist","ne":"नैतिकता चेकलिस्ट"}],"modules":[{"title":{"en":"From Topic to Question","ne":"विषयबाट प्रश्नसम्म"},"lessons":[{"en":"Topics, problems and questions","ne":"विषय, समस्या र प्रश्न"},{"en":"The three-filter test","ne":"तीन-फिल्टर परीक्षण"},{"en":"Writing the one-sentence question","ne":"एक-वाक्य प्रश्न लेखन"}]},{"title":{"en":"Design & Constructs","ne":"डिजाइन र कन्स्ट्रक्ट"},"lessons":[{"en":"Qualitative, quantitative and mixed designs","ne":"गुणात्मक, परिमाणात्मक र मिश्र डिजाइन"},{"en":"Operational definitions","ne":"परिचालनात्मक परिभाषा"},{"en":"Validity and reliability","ne":"वैधता र विश्वसनीयता"}]},{"title":{"en":"Sampling & Data Collection","ne":"नमूना र डाटा संकलन"},"lessons":[{"en":"Populations, frames and samples","ne":"जनसंख्या, फ्रेम र नमूना"},{"en":"Survey and interview instruments","ne":"सर्भे र अन्तर्वार्ता उपकरण"}]},{"title":{"en":"Writing the Methodology","ne":"विधि लेखन"},"lessons":[{"en":"Chapter structure reviewers expect","ne":"समीक्षकले अपेक्षा गर्ने संरचना"},{"en":"Justifying every choice","ne":"हरेक छनोटको औचित्य"}]}]},{"id":"c2","slug":"data-analysis-econometrics-lab","title":{"en":"Data Analysis & Econometrics Lab","ne":"डाटा विश्लेषण र इकोनोमेट्रिक्स ल्याब"},"level":"Intermediate","summary":{"en":"A hands-on lab covering cleaning, exploration, regression diagnostics, panel and time-series models, and reproducible reporting.","ne":"सफाइ, अन्वेषण, रिग्रेसन डायग्नोस्टिक्स, प्यानल र टाइम-सिरीज मोडेल, र पुनरुत्पादनयोग्य प्रतिवेदन।"},"image":"art:research","duration":{"en":"8 weeks","ne":"८ हप्ता"},"featured":true,"status":"published","access":"members","audience":"global","resources":[{"en":"Analysis folder template","ne":"विश्लेषण फोल्डर टेम्प्लेट"},{"en":"Diagnostics checklist","ne":"डायग्नोस्टिक्स चेकलिस्ट"}],"modules":[{"title":{"en":"Preparation","ne":"तयारी"},"lessons":[{"en":"The five-folder structure","ne":"पाँच-फोल्डर संरचना"},{"en":"Cleaning and transformation logs","ne":"सफाइ र रूपान्तरण लग"}]},{"title":{"en":"Exploration","ne":"अन्वेषण"},"lessons":[{"en":"Distributions and outliers","ne":"वितरण र आउटलायर"},{"en":"Publication-ready figures","ne":"प्रकाशनयोग्य चित्र"}]},{"title":{"en":"Regression & Diagnostics","ne":"रिग्रेसन र डायग्नोस्टिक्स"},"lessons":[{"en":"OLS assumptions in practice","ne":"OLS मान्यता व्यवहारमा"},{"en":"Heteroskedasticity and robust errors","ne":"हेटेरोस्केडास्टिसिटी र रोबस्ट त्रुटि"}]},{"title":{"en":"Beyond Cross-Section","ne":"क्रस-सेक्सन बाहिर"},"lessons":[{"en":"Panel data structures","ne":"प्यानल डाटा संरचना"},{"en":"Time-series and stationarity","ne":"टाइम-सिरीज र स्टेसनारिटी"}]}]},{"id":"c3","slug":"immersive-web-3d-storytelling","title":{"en":"Immersive Web & 3D Storytelling","ne":"इमर्सिभ वेब र 3D स्टोरीटेलिङ"},"level":"Advanced","summary":{"en":"Design and ship performant 3D web experiences: composition, shader fundamentals, meaningful motion and adaptive quality.","ne":"उच्च गतिको 3D वेब अनुभव — कम्पोजिसन, शेडर आधार, अर्थपूर्ण मोसन र अडप्टिभ क्वालिटी।"},"image":"art:nebula","duration":{"en":"5 weeks","ne":"५ हप्ता"},"featured":false,"status":"published","access":"members","audience":"global","resources":[{"en":"Performance budget sheet","ne":"परफर्मेन्स बजेट सिट"}],"modules":[{"title":{"en":"Foundations","ne":"आधार"},"lessons":[{"en":"Scene, camera, renderer","ne":"सिन, क्यामेरा, रेन्डरर"},{"en":"Light and material basics","ne":"प्रकाश र मटेरियल आधार"}]},{"title":{"en":"Motion & Meaning","ne":"मोसन र अर्थ"},"lessons":[{"en":"Scroll-linked camera moves","ne":"स्क्रोल-जोडिएको क्यामेरा चाल"},{"en":"Reduced-motion design","ne":"रिड्युस्ड-मोसन डिजाइन"}]},{"title":{"en":"Performance","ne":"परफर्मेन्स"},"lessons":[{"en":"Adaptive quality tiers","ne":"अडप्टिभ क्वालिटी टियर"},{"en":"Asset budgets and lazy loading","ne":"एसेट बजेट र लेजी लोडिङ"}]}]}],"guestVisible":3}]