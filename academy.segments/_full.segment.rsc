14:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"name\":\"ACTTOLOG\",\"url\":\"https://acttolog.github.io/\",\"description\":\"Acttolog is a digital ecosystem that connects technology, research, education, entertainment, creativity, useful resources, and emerging digital opportunities in one connected world.\",\"contactPoint\":{\"@type\":\"ContactPoint\",\"telephone\":\"9802336200\",\"email\":\"thesynresearch@gmail.com\",\"contactType\":\"customer service\",\"availableLanguage\":[\"en\",\"ne\"]}},{\"@type\":\"WebSite\",\"name\":\"ACTTOLOG\",\"url\":\"https://acttolog.github.io/\",\"inLanguage\":[\"en\",\"ne\"],\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://acttolog.github.io/search?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}}]}"}}]
