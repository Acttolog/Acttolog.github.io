,"children":"Acttolog एकेडेमीले अनुसन्धान अभ्यासलाई संरचित सिकाइमा बदल्छ। पाठ्यक्रम मोड्युलबाट, मोड्युल पाठबाट बन्छन्, र हरेक पाठको अन्त्यमा तपाईंले राख्न सकिने कुरा हुन्छ — टेम्प्लेट, चेकलिस्ट वा डाटासेट।"}],["$","div",null,{"className":"flex flex-wrap gap-2 mt-5 mono text-[10px] tracking-[.16em] dim","children":["$","span",null,{"className":"chip","children":"COURSES → MODULES → LESSONS → RESOURCES"}]}]]}],["$","div",null,{"className":"rounded-xl border p-5","style":{"borderColor":"var(--line)","background":"var(--panel2)"},"children":[["$","div",null,{"className":"mono text-[9.7px] tracking-[.2em] dim mb-3","children":"PUBLIC NOTE"}],["$","p",null,{"className":"mut text-[12.9px] leading-relaxed","children":"The Academy is a protected area. Guests see the introduction and course list only; lessons open after “Continue with Google”."}]]}]]}]}]}],["$","$L23",null,{"courses":[{"id":"c1","slug":"research-methods-foundations","title":{"en":"Research Methods Foundations","ne":"अनुसन्धान विधिको आधार"},"level":"Beginner","summary":{"en":"Build a defensible research design from a vague idea: questions, constructs, sampling, ethics and a written methodology.","ne":"अस्पष्ट idea बाट बलियो अनुसन्धान डिजाइन बनाउने — प्रश्न, कन्स्ट्रक्ट, नमूना, नैतिकता र लिखित विधि।"},"image":"art:academy","duration":{"en":"6 weeks","ne":"६ हप्ता"},"featured":true,"status":"published","access":"members","audience":"global","resources":[{"en":"Methodology template","ne":"विधि टेम्प्लेट"},{"en":"Research question worksheet","ne":"प्रश्न कार्यपत्र"},{"en":"Ethics checklist","ne":"नैतिकता चेकलिस्ट"}],"modules":[{"title":{"en":"From Topic to Question","ne":"विषयबाट प्रश्नसम्म"},"lessons":[{"en":"Topics, problems and questions","ne":"विषय, समस्या र प्रश्न"},{"en":"The three-filter test","ne":"तीन-फिल्टर परीक्षण"},{"en":"Writing the one-sentence question","ne":"एक-वाक्य प्रश्न लेखन"}]},{"title":{"en":"Design & Constructs","ne":"डिजाइन र कन्स्ट्रक्ट"},"lessons":[{"en":"Qualitative, quantitative and mixed designs","ne":"गुणात्मक, परिमाणात्मक र मिश्र डिजाइन"},{"en":"Operational definitions","ne":"परिचालनात्मक परिभाषा"},{"en":"Validity and reliability","ne":"वैधता र विश्वसनीयता"}]},{"title":{"en":"Sampling & Data Collection","ne":"नमूना र डाटा संकलन"},"lessons":[{"en":"Populations, frames and samples","ne":"जनसंख्या, फ्रेम र नमूना"},{"en":"Survey and interview instruments","ne":"सर्भे र अन्तर्वार्ता उपकरण"}]},{"title":{"en":"Writing the Methodology","ne":"विधि लेखन"},"lessons":[{"en":"Chapter structure reviewers expect","ne":"समीक्षकले अपेक्षा गर्ने संरचना"},{"en":"Justifying every choice","ne":"हरेक छनोटको औचित्य"}]}]},{"id":"c2","slug":"data-analysis-econometrics-lab","title":{"en":"Data Analysis & Econometrics Lab","ne":"डाटा विश्लेषण र इकोनोमेट्रिक्स ल्याब"},"level":"Intermediate","summary":{"en":"A hands-on lab covering cleaning, exploration, regression diagnostics, panel and time-series models, and reproducible reporting.","ne":"सफाइ, अन्वेषण, रिग्रेसन डायग्नोस्टिक्स, प्यानल र टाइम-सिरीज मोडेल, र पुनरुत्पादनयोग्य प्रतिवेदन।"},"image":"art:research","duration":{"en":"8 weeks","ne":"८ हप्ता"},"featured":true,"status":"published","access":"members","audience":"global","resources":[{"en":"Analysis folder template","ne":"विश्लेषण फोल्डर टेम्प्लेट"},{"en":"Diagnostics checklist","ne":"डायग्नोस्टिक्स चेकलिस्ट"}],"modules":[{"title":{"en":"Preparation","ne":"तयारी"},"lessons":[{"en":"The five-folder structure","ne":"पाँच-फोल्डर संरचना"},{"en":"Cleaning and transformation logs","ne":"सफाइ र रूपान्तरण लग"}]},{"title":{"en":"Exploration","ne":"अन्वेषण"},"lessons":[{"en":"Distributions and outliers","ne":"वितरण र आउटलायर"},{"en":"Publication-ready figures","ne":"प्रकाशनयोग्य चित्र"}]},{"title":{"en":"Regression & Diagnostics","ne":"रिग्रेसन र डायग्नोस्टिक्स"},"lessons":[{"en":"OLS assumptions in practice","ne":"OLS मान्यता व्यवहारमा"},{"en":"Heteroskedasticity and robust errors","ne":"हेटेरोस्केडास्टिसिटी र रोबस्ट त्रुटि"}]},{"title":{"en":"Beyond Cross-Section","ne":"क्र