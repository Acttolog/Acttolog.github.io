5b:["$","$L24","maghe",{"delay":270,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--gold)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"07"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Maghe Sankranti / Maghi"}],["$","div",null,{"className":"mono np-fest-when","children":"14–15 Jan (Magh 1)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"Sun enters Capricorn; winter breaks. Families eat ghee, til and sweet potato, take ritual dips at Devighat and Triveni, and Tharu communities dance, wrestle and drink the year's first rice beer."}],["$","div",null,{"className":"np-fest-where tag","children":"Nationwide; Tharu Maghi in the Terai"}]]}]}]
5c:["$","$L24","sakela",{"delay":315,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--ok)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"08"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Sakela (Sungwa / Tawang)"}],["$","div",null,{"className":"mono np-fest-when","children":"Jan (full moon) and Jun (new moon)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"Kirat Mundhum thanksgiving for the harvest, danced in concentric rings for days on hillsides — arguably the oldest continuous festival calendar in the Himalaya."}],["$","div",null,{"className":"np-fest-where tag","children":"Rai and Limbu villages, east"}]]}]}]
5d:["$","$L24","biska",{"delay":360,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--mg)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"09"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Biska Jatra / Bhandu Plate Festival"}],["$","div",null,{"className":"mono np-fest-when","children":"9 days around Apr (Baisakh)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"The year turns in Bhaktapur: a linga of wood dragged to the temple, oil lamps on a plate thrown to the crowd, and the village deities carried out of the gates on the final day, and devotees thrown beneath the chariot wheels at the Bhandu plate rite."}],["$","div",null,{"className":"np-fest-where tag","children":"Bhaktapur"}]]}]}]
5e:["$","$L24","machhindranath",{"delay":405,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--cy)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"10"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Rato Machhindranath Jatra"}],["$","div",null,{"className":"mono np-fest-when","children":"Apr–Jun, weeks-long"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"The longest chariot festival in Asia, pulling the red lord of rain and harvest through Patan's lanes to guarantee the monsoon and the valley's rice."}],["$","div",null,{"className":"np-fest-where tag","children":"Patan"}]]}]}]
