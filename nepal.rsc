:"wrap","children":[["$","$L24",null,{"children":["$","div",null,{"className":"sechead","children":[["$","div",null,{"children":[["$","div",null,{"className":"secnum","children":["01"," · GEOGRAPHY"]}],["$","h2",null,{"className":"h2","children":"Twelve regions, one country of contrasts"}],["$","p",null,{"className":"lead mt-4","children":"Nepal runs from 59 m above sea level in the Terai to 8,848.86 m at Sagarmatha inside a hundred kilometres. Pick a region to see what belongs to it."}]]}],["$","div",null,{"className":"mono np-head-meta","children":[12," REGIONS · ",32," PLACES"]}]]}]}],["$","$L25",null,{"regions":[{"id":"katmandu-valley","name":{"en":"Kathmandu Valley","ne":"काठमाडौँ उपत्यका"},"center":[27.7172,85.324],"zoom":11,"accent":"var(--vi)","blurb":{"en":"Three royal cities in one basin, where Hindu and Buddhist shrines share a skyline and a priests' calendar.","ne":"एउटै उपत्यकामा तीन रजगज नगर।"}},{"id":"khumbu","name":{"en":"Khumbu / Sagarmatha","ne":"खुम्बु / सगरमाथा"},"center":[27.9881,86.925],"zoom":10,"accent":"var(--cy)","blurb":{"en":"The Sherpa heartland. Stone-walled villages, monasteries on ridge spurs, glacier valleys opening onto Everest.","ne":"शर्पाको मुल भूमि।"}},{"id":"annapurna","name":{"en":"Annapurna & Gandaki","ne":"अन्नपूर्ण, गण्डकी"},"center":[28.51,83.85],"zoom":10,"accent":"var(--mg)","blurb":{"en":"Subtropical gorge to high desert in a single week, crossing a river canyon that is arguably the deepest on earth.","ne":"उपोष्ण खोंचदेखि उच्च मरुसम्म।"}},{"id":"pokhara","name":{"en":"Pokhara Valley","ne":"पोखरा उपत्यका"},"center":[28.209,83.926],"zoom":11,"accent":"var(--ok)","blurb":{"en":"A lake town under the Fishtail, where the Annapurna wall reflects in still water at dawn.","ne":"माछापुछ्रेको छेउमा ताल।"}},{"id":"chitwan","name":{"en":"Chitwan & Narayani","ne":"चितवन, नारायणी"},"center":[27.55,84.45],"zoom":10,"accent":"var(--gold)","blurb":{"en":"Sal forest, river and grassland — stronghold of the one-horned rhino and home of Tharu culture.","ne":"गैँडाको घर र थारू संस्कृति।"}},{"id":"lumbini","name":{"en":"Lumbini","ne":"लुम्बिनी"},"center":[27.4697,83.2757],"zoom":11,"accent":"var(--cy)","blurb":{"en":"Birthplace of Siddhartha Gautama. Ashoka's pillar, a sacred garden, monasteries from score countries.","ne":"गौतम बुद्धको जन्मस्थल।"}},{"id":"langtang","name":{"en":"Langtang & Gosainkunda","ne":"लान्तंग, गोजाकुण्ड"},"center":[28.22,85.52],"zoom":10,"accent":"var(--vi)","blurb":{"en":"Nepal's closest high valley to the capital — Tamang villages, yak pastures, a lake holy to two faiths.","ne":"राजधानीनिकट उच्च उपत्यका।"}},{"id":"mustang","name":{"en":"Upper Mustang","ne":"माथि मुस्ताङ"},"center":[29.1,83.88],"zoom":10,"accent":"var(--mg)","blurb":{"en":"The walled kingdom of Lo — ochre cliffs, cave dwellings, barley at 3,800 m, and the rain the country never gets.","ne":"लो राज्यको किल्लाबद्ध सहर।"}},{"id":"dolpo","name":{"en":"Dolpo & Far-West Lakes","ne":"डोल्पो, पश्चिमका ताल"},"center":[29.2,81.4],"zoom":10,"accent":"var(--ok)","blurb":{"en":"Tibetan-in-exile culture inside Nepal: the Bon monastery of Shey, turquoise Phoksundo, and Rara.","ne":"नेपालभित्र तिब्बती संस्कृति।"}},{"id":"kanchenjunga","name":{"en":"Kanchenjunga & Ilam","ne":"कञ्चनजङ्घा, इलाम"},"center":[27.7025,87.93],"zoom":10,"accent":"var(--cy)","blurb":{"en":"The east — tea gardens on rolling hills, Kirat Rai and Limbu villages, the third-highest peak kept quiet.","ne":"पूर्व — चिया बगान र किराँती संस्कृति।"}},{"id":"mithila","name":{"en":"Mithila & Terai","ne":"मिथिला, तराई"},"center":[26.729,85.925],"zoom":10,"accent":"var(--gold)","blurb":{"en":"Sita's city, Maithili poetry, Madhubani line-work on plaster, and Chhath's river-bank worship.","ne":"सीताको नगर, मधुबनी र छठ।"}},{"id":"bardiya","name":{"en":"Bardiya & Suklaphanta","ne":"बर्दिया, शुक्लाफाँटा"},"center":[28.64,81.35],"zoom":10,"accent":"var(--mg)","blurb":{"en":"Wild Terai on the Karnali and Sharda — fewer visitors, more rhino, river dolphins, huge swamp-deer herds.","ne":"कर्णालीको जङ्गली तराई।"}}],"placesByRegion":{"katmandu-valley":[{"id":"swayambhunath","name":{"en":"Swayambhunath","ne":"स्वयम्भूनाथ"},"region":"katmandu-valley","type":"heritage","coords":[27.7149,85.2949],"unesco":true,"desc":{"en":"The self-born lotus. Thirteen tiers and five sets of dhyani-Buddha eyes watch the valley from a hill, reached by 365 steps and guarded by resident macaques.","ne":"स्वयम्भूको आँखाले उपत्यका हेर्छ।"},"image":"nepal/swayambhunath","best":["Oct","Nov","Mar","Apr"],"tags":["Buddhist","Viewpoint"]},{"id":"boudhanath","name":{"en":"Boudhanath","ne":"बौद्धनाथ"},"region":"katmandu-valley","type":"heritage","coords":[27.7228,85.3617],"unesco":true,"desc":{"en":"Among the largest domed stupas anywhere, ringed by a circumambulation path where butter lamps gutter and the kora turns clockwise all evening.","ne":"विशाल गुम्बा र परिक्रमा पथ।"},"image":"nepal/boudhanath","best":["All year"],"tags":["Buddhist","Stupa"]},{"id":"bhaktapur","name":{"en":"Bhaktapur Durbar Square","ne":"भक्तपुर दरबार"},"region":"katmandu-valley","type":"heritage","coords":[27.6725,85.425],"unesco":true,"desc":{"en":"The valley's best-preserved medieval city: five pagoda tiers of Nyatapola, the 55-window palace, pottery wheels turning in the same lanes as four centuries ago.","ne":"पाँच तले न्यातपोल र ५५ ढोकाको महल।"},"image":"nepal/bhaktapur-durbar","best":["Sep","Oct","Apr"],"tags":["Newar","Architecture"]},{"id":"patan","name":{"en":"Patan Durbar Square","ne":"पाटन दरबार"},"region":"katmandu-valley","type":"heritage","coords":[27.654,85.322],"unesco":true,"desc":{"en":"The cradle of Newar metalwork and stone carving, whose Krishna Mandir is carved from a single block and whose museum is the finest in the country.","ne":"निकुटिलो शिल्पको जन्मस्थान।"},"image":"nepal/patan-durbar","best":["Oct","Nov"],"tags":["Newar","Museum"]},{"id":"pashupatinath","name":{"en":"Pashupatinath","ne":"पशुपतिनाथ"},"region":"katmandu-valley","type":"heritage","coords":[27.7384,85.352],"unesco":true,"desc":{"en":"Shiva's own temple on the Bagmati, where cremation ghats, sadhus, and the Mahadev rings of the dead make the valley confront mortality openly.","ne":"बागमती किनारमा शिवको धाम।"},"image":"nepal/pashupatinath","best":["Feb","Mar"],"tags":["Hindu","Riverside"],"note":{"en":"Non-Hindus may view from the east bank; entry to the main temple is restricted.","ne":"अहिन्दूलाई पूर्वी किनारबाट दर्शन।"}},{"id":"changunarayan","name":{"en":"Changu Narayan","ne":"चाङ्गुनारायण"},"region":"katmandu-valley","type":"heritage","coords":[27.7939,85.4286],"unesco":true,"desc":{"en":"The oldest continuously used temple site in the valley, on a ridge of sal trees, holding a 5th-century Lithu inscription — the earliest dated record found in Nepal.","ne":"उपत्यकाको पुरानो निरन्तर पूजित धाम।"},"image":"nepal/changunarayan","best":["Oct","Nov","Mar"],"tags":["Hindu","Ridge walk"]},{"id":"thamel","name":{"en":"Thamel & Asan","ne":"ठमेल र असन"},"region":"katmandu-valley","type":"city","coords":[27.7119,85.3132],"desc":{"en":"The trekking capital's bazaars — Thamel for gear and cafes, Asan for spice towers, thread and temple flowers sold from stalls older than most governments.","ne":"ट्रेकिङ राजधानीको बजार।"},"image":"nepal/thamel","best":["All year"],"tags":["Shopping","Food"]}],"khumbu":[{"id":"epc","name":{"en":"Everest Base Camp","ne":"सगरमाथा आधार शिविर"},"region":"khumbu","type":"mountain","coords":[28.0025,86.8528],"desc":{"en":"Reached on foot through Namche and Tengboche, the Khumbu Icefall's seracs assembled above the glacier bowl in summer, dismantled by winter.","ne":"नामे बजार र थेङ्गबोचे हुँदै पैदल।"},"image":"nepal/everest-bc","best":["Apr","May","Oct","Nov"],"tags":["Trek","5,364 m"],"note":{"en":"Altitude: acclimatise properly; most programmes include two rest days above Namche.","ne":"उचाइ: नामेमा दुई विश्राम।"}},{"id":"kalapattar","name":{"en":"Kala Patthar","ne":"कालापत्थर"},"region":"khumbu","type":"mountain","coords":[28.3239,86.854],"desc":{"en":"The black rock at 5,643 m that gives the closest sunset view of Everest's full pyramid that a non-climber will ever get.","ne":"सूर्यास्तमा एभरेस्टको नजिकको दृश्य।"},"image":"nepal/kalapattar","best":["Oct","Nov"],"tags":["Sunrise","5,643 m"]},{"id":"namche","name":{"en":"Namche Bazaar","ne":"नामे बजार"},"region":"khumbu","type":"village","coords":[27.8023,86.7109],"desc":{"en":"A Sherpa market town terraced into an amphitheatre bowl, busiest on Saturday, and the mandatory acclimatisation stop before the high Khumbu.","ne":"शर्पा बजार, शनिबार सबैभन्दा व्यस्त।"},"image":"nepal/namche-prayer-flags","best":["All year"],"tags":["Market","Acclimatise"]},{"id":"tengboche","name":{"en":"Tengboche Monastery","ne":"थेङ्गबोचे गुम्बा"},"region":"khumbu","type":"monastery","coords":[27.8353,86.768],"desc":{"en":"The great Nyingma monastery on a forested spur, with Everest and Lhotse framed behind the prayer flags; the dawn chiying puja is open to trekkers.","ne":"हिमालको अगाडि गुम्बा।"},"image":"nepal/tengboche","best":["Oct","Nov","Apr"],"tags":["Buddhist","Ceremony"]},{"id":"gokyo","name":{"en":"Gokyo Lakes","ne":"गोक्यो ताल"},"region":"khumbu","type":"lake","coords":[28.005,86.7],"desc":{"en":"Six high turquoise lakes below Cho Oyu, the holiest Tibetan Buddhist and Bon site in Nepal, and the quieter alternative to the EBC crowds.","ne":"छो ओयुको काखमा रहेका छ वटा ताल।"},"image":"nepal/gokyo","best":["Oct","Nov"],"tags":["Trek","Sacred"]}],"annapurna":[{"id":"abc","name":{"en":"Annapurna Sanctuary","ne":"अन्नपूर्ण गन्धर्व क्षेत्र"},"region":"annapurna","type":"mountain","coords":[28.5333,83.8733],"desc":{"en":"A glacial amphitheatre ringed by thirteen peaks including Annapurna I and Machapuchare, reached through Ghorepani and the bamboo bowls of Chhomrong.","ne":"बाह्र शिखरले घेरेको हिमाली माटो।"},"image":"nepal/abc","best":["Oct","Nov","Mar","Apr"],"tags":["Trek","4,130 m"]},{"id":"poonhill","name":{"en":"Poon Hill","ne":"पुन हिल"},"region":"annapurna","type":"viewpoint","coords":[28.445,83.802],"desc":{"en":"At 3,210 m, the classic four-day sunrise view — the whole Annapurna and Dhaulagiri range lit from below in about twenty minutes.","ne":"सूर्योदयको क्लासिक दृश्य।"},"image":"nepal/poonhill","best":["Oct","Nov","Mar","Apr"],"tags":["Short trek","Sunrise"]},{"id":"kandi-gandaki","name":{"en":"Kali Gandaki Gorge","ne":"कालीगण्डकी खोंच"},"region":"annapurna","type":"landscape","coords":[28.85,83.65],"desc":{"en":"The river that cut between Dhaulagiri (8,167 m) and Annapurna (8,091 m), producing one of the deepest gorges on the planet and a wind corridor that blows every afternoon.","ne":"संसारकै गहिरो खोंचमध्ये एक।"},"image":"nepal/kaligandaki","best":["Oct","Apr"],"tags":["Scenic","Wind"]},{"id":"tansen","name":{"en":"Tansen Bazaar, Palpa","ne":"तानसेन बजार"},"region":"annapurna","type":"village","coords":[28.07,83.61],"desc":{"en":"A ridge town of Newar and Magar lanes above the Kali Gandaki, with the Sikali cave temples, a Goreto garden and the Ghami pipeline of terracotta roofs.","ne":"किनारको शहर।"},"image":"nepal/tansen","best":["Oct","Nov","Mar"],"tags":["Heritage stay"]}],"pokhara":[{"id":"phemwa","name":{"en":"Phewa Lake","ne":"फेवा ताल"},"region":"pokhara","type":"lake","coords":[28.2136,83.945],"desc":{"en":"Nepal's second-largest lake, boatable at dawn when Machapuchare doubles in the water, with the Tal Barahi temple on an island and Lakeside trailing behind it.","ne":"बिहानै मच्छापुछ्रेको प्रतिबिम्ब।"},"image":"nepal/phewa-lake","best":["Oct","Nov","Mar"],"tags":["Boating","Sunrise"]},{"id":"sarangkot","name":{"en":"Sarangkot","ne":"सराङ्गकोट"},"region":"pokhara","type":"viewpoint","coords":[28.25,83.91],"desc":{"en":"The ridge village above Pokhara for the Annapurna sunrise and, in season, one of the world's better paragliding launches down to the lake.","ne":"हिमाल हेर्ने टुप्पो।"},"image":"nepal/sarangkot","best":["Oct","Nov","Mar","Apr"],"tags":["Sunrise","Paragliding"]},{"id":"gupteswor","name":{"en":"Gupteshwor & Mahendra Caves","ne":"गुप्तेस्वर, महन्द्र गुफा"},"region":"pokhara","type":"cave","desc":{"en":"A limestone cave temple with an idol said to be self-manifested, and across the valley a second cave with a 150-step shaft and bats at dusk.","ne":"चुनढुङ्गाको गुफा।"},"coords":[28.3,83.953],"image":"nepal/gupteshwor","best":["All year"],"tags":["Cave","Family"]},{"id":"bandipur","name":{"en":"Bandipur","ne":"बन्दीपुर"},"region":"pokhara","type":"village","coords":[28.222,83.977],"desc":{"en":"A Newar hilltown preserved against traffic — slate roofs, a wide covered temple courtyard, and an uninterrupted view of the Dhaulagiri range at breakfast.","ne":"पक्की संरक्षित पहाडी नगर।"},"image":"nepal/bandipur","best":["Oct","Nov","Mar","Apr"],"tags":["Heritage stay","Viewpoint"]},{"id":"manakamana","name":{"en":"Manakamana","ne":"मनकामना"},"region":"pokhara","type":"heritage","coords":[27.863,84.653],"desc":{"en":"A hill temple to the wish-fulfilling goddess, reached since 1998 by an aerial tramway across rice fields and river gorges, and by a two-hour foot climb before that.","ne":"आकाशे गाडी र मनकामनाको धाम।"},"image":"nepal/manakamana","best":["Sep","Oct","Apr"],"tags":["Cable car","Hindu"]}],"chitwan":[{"id":"chitwan-rhino","name":{"en":"Chitwan National Park","ne":"चितवन राष्ट्रिय निकुञ्ज"},"region":"chitwan","type":"wildlife","coords":[27.53,84.42],"unesco":true,"desc":{"en":"Terai grasslands called phanta where rhino, gharial, marsh mugger, leopard and sloth bear live within a day's drive of the capital. Canoe on the Rapti, walk the sal forest, watch Tharu stick-dance.","ne":"गैँडा, घियाल, अग्लो भालु र थारू संस्कृति।"},"image":"nepal/greater-rhinoceros","best":["Oct","Nov","Dec","Jan","Feb","Mar"],"tags":["Safari","Rhino","UNESCO"]}],"lumbini":[{"id":"lumbini-garden","name":{"en":"Lumbini Sacred Garden","ne":"लुम्बिनी पुण्य भूमि"},"region":"lumbini","type":"heritage","coords":[27.4697,83.2757],"unesco":true,"desc":{"en":"The exact birthplace of the Buddha, marked by Ashoka's 3rd-century pillar and the Maya Devi temple, set in a planned grove where monasteries from more than twenty nations stand in quiet rivalry.","ne":"अशोकस्तम्भ र मायादेवी मन्दिर।"},"image":"nepal/lumbini-maya-devi","best":["Oct","Nov","Feb","Mar"],"tags":["Buddhist","Pilgrimage","UNESCO"]}],"langtang":[{"id":"gosainkunda","name":{"en":"Gosainkunda","ne":"गोजाकुण्ड"},"region":"langtang","type":"lake","coords":[28.083,85.417],"desc":{"en":"A lake at 4,320 m that Shiva is said to have punched in the mountain with his trident; on Janai Purnima tens of thousands of pilgrims walk up to bathe in it.","ne":"शिवले त्रिशुलेले फोडेको ताल।"},"image":"nepal/gosainkunda","best":["Aug","Oct","Nov"],"tags":["Trek","Pilgrimage"]},{"id":"kyanjing","name":{"en":"Kyanjin Gompa, Langtang","ne":"क्यन्जिन गुम्बा"},"region":"langtang","type":"monastery","coords":[28.2283,85.51],"desc":{"en":"The head of the Langtang valley below the frozen wall of Langtang Lirung — a Tamang and Tibetan settlement of yak herds, a cheese factory, and one of the finest sunrise ridgelines anywhere.","ne":"लान्तंग लिरुङ्गको अगाडि गुम्बा।"},"image":"nepal/kyanjing","best":["Oct","Nov","Mar","Apr"],"tags":["Trek","Cheese"]}],"mustang":[{"id":"lo-manthang","name":{"en":"Lo Manthang","ne":"लो म्याान्थाङ"},"region":"mustang","type":"heritage","coords":[29.0972,83.883],"desc":{"en":"The walled capital of the Lho kingdom since 1380, three royal palaces and chortens inside a mud-brick perimeter, on a high cold desert that was once the trade road to Tibet.","ne":"१३८० देखि किल्लाभित्रको राजधानी।"},"image":"nepal/lo-manthang","best":["Apr","May","Sep","Oct"],"tags":["Restricted","Kingdom"]},{"id":"skytombs","name":{"en":"Sky Caves of Ghami & Samdar","ne":"आकाशे गुफा"},"region":"mustang","type":"cave","coords":[29.35,83.8],"desc":{"en":"Dozens of painted burial caves bored into vertical cliffs above the Kali Gandaki, some reachable only by ladders, holding wooden coffins and Bon and Buddhist murals.","ne":"ठाडो पर्खालमा चित्रित समाधि गुफा।"},"image":"nepal/skycaves","best":["May","Sep"],"tags":["Archaeology"]}],"dolpo":[{"id":"phoksundo","name":{"en":"Phoksundo Lake","ne":"फोक्सुण्डो ताल"},"region":"dolpo","type":"lake","coords":[29.173,81.473],"desc":{"en":"Nepal's deepest and impossibly turquoise lake, with the oldest Bon monastery in the country on its shore and the village of Shey two days further on.","ne":"गहिरो फिरौजे ताल र बोन गुम्बा।"},"image":"nepal/phoksundo","best":["May","Jun","Sep","Oct"],"tags":["Restricted","Bon","Lake"]},{"id":"rara","name":{"en":"Rara Lake","ne":"रारा ताल"},"region":"dolpo","type":"lake","coords":[29.261,81.839],"desc":{"en":"The largest lake wholly inside Nepal, at 2,960 m, ringed by conifer forest whose colour flips between lapis and pine-green with the hour.","ne":"नेपालकै सबैभन्दा ठूलो ताल।"},"image":"nepal/rara-lake","best":["May","Oct","Nov"],"tags":["Remote","Lake"]}],"mithila":[{"id":"janaki","name":{"en":"Janaki Temple, Janakpur","ne":"जानकी मन्दिर"},"region":"mithila","type":"heritage","coords":[26.7291,85.9247],"desc":{"en":"A Mithila marble temple to Sita, built 1910–1920, with mirror-work, carved pillars and a two-storey sanctum; the whole town turns out for Ram Navami and Vivah Panchami.","ne":"मिथिला शैलीको सिताको मन्दिर।"},"image":"nepal/janaki-temple","best":["Jan","Mar","Apr"],"tags":["Hindu","Mithila"]}],"kanchenjunga":[{"id":"koshitappu","name":{"en":"Koshi Tappu","ne":"कोशी तप्पु"},"region":"kanchenjunga","type":"wildlife","coords":[26.64,86.83],"desc":{"en":"Floodplain wetland east of the Sapta Koshi with some of Asia's best birding — hundreds of species, blackbuck, and the riverine habitat of the gharial.","ne":"चराको स्वर्ग।"},"image":"nepal/koshitappu","best":["Nov","Dec","Jan","Feb"],"tags":["Birding","Wetland"]}],"bardiya":[{"id":"bardiya","name":{"en":"Bardiya National Park","ne":"बर्दिया राष्ट्रिय निकुञ्ज"},"region":"bardiya","type":"wildlife","coords":[28.64,81.35],"desc":{"en":"Nepal's largest Terai park on the Karnali — the best place for wild elephant, one-horned rhino at close range, Gangetic dolphin, and Tharu villages untouched by tour buses.","ne":"तराईकै सबैभन्दा ठूलो निकुञ्ज।"},"image":"nepal/bardiya","best":["Nov","Dec","Jan","Feb","Mar"],"tags":["Safari","Dolphin"]}]}}]]}]}],"$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"],null,"$L32"]}]
