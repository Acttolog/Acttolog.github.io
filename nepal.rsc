28:["$","section",null,{"className":"sec np-alt","id":"festivals","children":["$","div",null,{"className":"wrap","children":[["$","$L24",null,{"children":["$","div",null,{"className":"sechead","children":["$","div",null,{"children":[["$","div",null,{"className":"secnum","children":["04"," · CULTURE"]}],["$","h2",null,{"className":"h2","children":"The festival calendar"}],["$","p",null,{"className":"lead mt-4","children":"Nepal's working week is Sunday to Friday and its year is held together by festivals. Timing a visit around one changes the whole trip."}]]}]}]}],["$","div",null,{"className":"np-fest","children":[["$","$L24","dashain",{"delay":0,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--mg)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"01"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Dashain"}],["$","div",null,{"className":"mono np-fest-when","children":"15 days, Sep–Oct (Shrawan–Ashwin)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"The longest and biggest Hindu festival of the year, honouring Durga's victory. Ghatasthapana sows the sacred jamara; Fulpati brings the deity in; on Vijayadashami elders put tika and bless, and the country eats, flies kites, swings on bamboo ping, and reconciles."}],["$","div",null,{"className":"np-fest-where tag","children":"Nationwide"}]]}]}],["$","$L24","tihar",{"delay":45,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--gold)"},"children":[["$","div",null,{"className":"np-fest-media","children":["$","picture",null,{"children":"$54"}]}],["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"02"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Tihar / Deepawali"}],["$","div",null,{"className":"mono np-fest-when","children":"5 days, Oct–Nov (Kartik)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"The festival of lights and of debts owed to animals: crows, then dogs, then cows are worshipped, Laxmi is invited in at dusk on the third night, and brothers and sisters exchange bhai tika on the fifth. Every windowsill holds a diyo."}],["$","div",null,{"className":"np-fest-where tag","children":"Nationwide"}]]}]}],["$","$L24","holi",{"delay":90,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--cy)"},"children":[["$","div",null,{"className":"np-fest-media","children":["$","picture",null,{"children":"$55"}]}],["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"03"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Holi / Fagu Purnima"}],["$","div",null,{"className":"mono np-fest-when","children":"Feb–Mar (Falgun full moon)"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"Colour, water and the burning of the symbolic Hiraka effigy the night before. In Patan crowds gather around a pole on a plaza that has been assembled from a single tree trunk."}],["$","div",null,{"className":"np-fest-where tag","children":"Nationwide; Patan's Tingun Chher is the spectacle"}]]}]}],["$","$L24","chhath",{"delay":135,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--mg)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"04"}],["$","div",null,{"children":[["$","h3",null,{"className":"np-fest-name","children":"Chhath"}],["$","div",null,{"className":"mono np-fest-when","children":"4 days after Tihar, Oct–Nov"}]]}]]}],["$","p",null,{"className":"np-fest-desc","children":"The most austere and beautiful rite in Nepal: devotees fast without water, then stand waist-deep in cold river water at dawn and dusk to offer arghya to the rising and setting sun, for their children's lives."}],["$","div",null,{"className":"np-fest-where tag","children":"Terai — Janakpur, Dhanusha, Siraha"}]]}]}],["$","$L24","indrajatra",{"delay":180,"children":["$","article",null,{"className":"np-fest-card panel","style":{"--a":"var(--vi)"},"children":[null,["$","div",null,{"className":"np-fest-top","children":[["$","span",null,{"className":"mono np-fest-n","children":"05"}],["$","div",null,{"children":["$L56","$L57"]}]]}],"$L58","$L59"]}]}],"$L5a","$L5b","$L5c","$L5d","$L5e"]}]]}]}]
