0:{"buildId":"xz5GWcpCVEMXWFCc_VMq7","data":[{"rsc":["$","$1","c",{"children":[[["$","section",null,{"className":"relative overflow-hidden pt-[calc(var(--nav)+50px)] pb-12","children":[["$","div",null,{"className":"absolute inset-0 -z-10 opacity-40","children":["$","$L2",null,{"className":"h-full w-full","intensity":4.5,"clean":true,"children":["$","img",null,{"src":"/media/games.jpg","alt":"","className":"h-full w-full object-cover","style":{"maskImage":"linear-gradient(180deg,#000,transparent 86%)","WebkitMaskImage":"linear-gradient(180deg,#000,transparent 86%)"}}]}]}],["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-4","children":[["$","$L3",null,{"children":["$","div",null,{"className":"eyebrow","children":"ACTTOLOG DIVISION · GAMES"}]}],["$","$L4",null,{"className":"sp-head-trigger","label":"Open spatial view","children":[["$","svg",null,{"width":14,"height":14,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5M3 17l9 5 9-5\"/>"}}],"SPATIAL VIEW"]}]]}],["$","$L3",null,{"delay":60,"children":["$","h1",null,{"className":"h1 mt-5 max-w-[22ch]","children":"Games"}]}],["$","$L3",null,{"delay":120,"children":["$","p",null,{"className":"lead mt-6","children":"Browser games, mini games, educational play and experimental interactive experiences."}]}],"$undefined"]}]]}],["$","$L5",null,{"world":"arena","title":"Games World","titleNe":"गेम्स वर्ल्ड","subtitle":"A futuristic game lobby in 360° — hotspots lead into Entertainment and back to the ACTTOLOG world hub.","accent":"var(--ok)","earthLink":"/explore?mode=earth&lat=35.68100&lng=139.76700"}],["$","section",null,{"className":"sec pt-2","children":["$","div",null,{"className":"wrap","children":[["$","$L6",null,{"games":[{"id":"g12","slug":"snake-himalaya","title":{"en":"Snake Himalaya","ne":"स्नेक हिमालय"},"desc":{"en":"The classic snake as a neon trail across the high grid. Eat momo to grow and quicken the pulse; walls and your own tail end the run. Arrows, WASD or swipe.","ne":"क्लासिक स्नेक खेल उच्च ग्रिडमा नियोन ट्रेलका रूपमा। मःम खाएर लामो हुनुहोस् र गति बढाउनुहोस्; भित्ता र आफ्नै पुच्छरले खेल सकिन्छ।"},"thumb":"/media/arcade/thumbs/snake-himalaya.jpg","url":"/arcade/index.html?game=snake-himalaya","launch":"live","engine":"arcade-snake","category":"Arcade","tags":["nepal","snake","neon"],"release":"2026-11-14","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g13","slug":"himalaya-breakout","title":{"en":"Himalaya Breakout","ne":"हिमालय ब्रेकआउट"},"desc":{"en":"Break a five-row prayer-flag wall with one glowing ball and three lives. Clear the wall to climb a level — the ball only gets faster. Mouse, touch or arrow keys.","ne":"पाँच पङ्क्तिको prayer-flag पर्खाललाई एउटा चम्किलो बल र तीन जीवनले तोड्नुहोस्। पर्खाल सफा गरेपछि अर्को तह — बल झन् छिटो हुन्छ।"},"thumb":"/media/arcade/thumbs/himalaya-breakout.jpg","url":"/arcade/index.html?game=himalaya-breakout","launch":"live","engine":"arcade-breakout","category":"Arcade","tags":["nepal","breakout","bricks"],"release":"2026-11-14","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g14","slug":"danphe-flight","title":{"en":"Danphe Flight","ne":"डाँफे उडान"},"desc":{"en":"Fly Nepal's national bird, the Himalayan monal, between carved temple pillars. One tap per wingbeat; the gap tightens with every point you score.","ne":"नेपालको राष्ट्रिय पन्छी डाँफेलाई मन्दिरका स्तम्भहरूबीच उडाउनुहोस्। एक ट्यापमा एक पखेटा; स्कोर बढ्दै जाँदा खाँचो साँघुरो हुन्छ।"},"thumb":"/media/arcade/thumbs/danphe-flight.jpg","url":"/arcade/index.html?game=danphe-flight","launch":"live","engine":"arcade-danphe","category":"Arcade","tags":["nepal","danphe","one-tap"],"release":"2026-11-14","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g15","slug":"memory-nepal","title":{"en":"Memory Nepal","ne":"मेमोरी नेपाल"},"desc":{"en":"Flip, remember, match: eight pairs of Nepal icons — momo, danphe, laligurans and more. A move counter, a clock and a personal best for the fewest moves.","ne":"पल्टाउनुहोस्, सम्झनुहोस्, मिलाउनुहोस्: नेपालका आठ जोडी चिन्ह — मःम, डाँफे, लालीगुराँस र अरू। कम चालमा सक्ने व्यक्तिगत कीर्तिमान सहित।"},"thumb":"/media/arcade/thumbs/memory-nepal.jpg","url":"/arcade/index.html?game=memory-nepal","launch":"live","engine":"arcade-memory","category":"Puzzle","tags":["nepal","memory","pairs"],"release":"2026-11-14","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g6","slug":"khoja-nepal","title":{"en":"Khoja Nepal","ne":"खोज नेपाल"},"desc":{"en":"A daily photo hunt across Nepal: five real places, five map pins. Drop your best guess, learn the distance, then share the score.","ne":"नेपालभरका पाँच वास्तविक ठाउँको दैनिक फोटो खोजी: नक्सामा अनुमान राख्नुहोस्, दूरी थाहा पाउनुहोस् र स्कोर साझा गर्नुहोस्।"},"thumb":"/media/arcade/thumbs/khoja-nepal.jpg","url":"/arcade/index.html?game=khoja-nepal","launch":"live","engine":"arcade-khoja","category":"Geography","tags":["nepal","map","daily"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public"},{"id":"g7","slug":"merge-himalaya","title":{"en":"Merge Himalaya","ne":"मर्ज हिमालय"},"desc":{"en":"The 2048 formula rebuilt as a Himalayan expedition. Merge tea houses, trekkers and base camps all the way to the 2048 Himalaya tile.","ne":"२०४८ सूत्रलाई हिमाली अभियानमा बदलिएको खेल। चिया घर, ट्रेकर र आधार शिविर मिलाउँदै २०४८ को हिमालय टाइलसम्म पुग्नुहोस्।"},"thumb":"/media/arcade/thumbs/merge-himalaya.jpg","url":"/arcade/index.html?game=merge-himalaya","launch":"live","engine":"arcade-merge","category":"Puzzle","tags":["nepal","2048","merge"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public"},{"id":"g8","slug":"himalaya-stack","title":{"en":"Himalaya Stack","ne":"हिमालय स्ट्याक"},"desc":{"en":"Stack blocks from Base Camp upward. One tap drops each block; perfect drops keep your tower wide while misses shave it thin. Climb toward 8,848 m.","ne":"आधार शिविरदेखि माथि ब्लकहरू थप्दै जानुहोस्। एउटा ट्यापमा ब्लक खस्छ; सटीक खसाल्दा टावर चौडा रहन्छ, चुक्दा साँघुरो हुन्छ। ८,८४८ मिटरतर्फ लक्ष्य राख्नुहोस्।"},"thumb":"/media/arcade/thumbs/himalaya-stack.jpg","url":"/arcade/index.html?game=himalaya-stack","launch":"live","engine":"arcade-stack","category":"Arcade","tags":["nepal","tower","one-tap"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g9","slug":"typerush-nepal","title":{"en":"TypeRush Nepal","ne":"टाइपरश नेपाल"},"desc":{"en":"Sixty seconds, one passage about Nepal. Type facts or romanized Nepali words against the clock and chase a clean words-per-minute score.","ne":"साठी सेकेन्ड, नेपालबारे एउटा अनुच्छेद। नेपालका तथ्य वा रोमन लिपिमा नेपाली शब्द समयसँग दौडिएर टाइप गर्नुहोस् र उच्च WPM स्कोर बनाउनुहोस्।"},"thumb":"/media/arcade/thumbs/typerush-nepal.jpg","url":"/arcade/index.html?game=typerush-nepal","launch":"live","engine":"arcade-typerush","category":"Typing","tags":["nepal","typing","wpm"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g10","slug":"nepal-daily","title":{"en":"Nepal Daily","ne":"नेपाल डेली"},"desc":{"en":"Ten questions a day on Nepal's mountains, culture, wildlife, food and history. The same set for everyone; practice never breaks your streak.","ne":"नेपालका हिमाल, संस्कृति, वन्यजन्तु, खानपान र इतिहासबारे दिनका दस प्रश्न। सबैका लागि एउटै सेट; अभ्यासले स्ट्रिक भाँड्दैन।"},"thumb":"/media/arcade/thumbs/nepal-daily.jpg","url":"/arcade/index.html?game=nepal-daily","launch":"live","engine":"arcade-daily","category":"Trivia","tags":["nepal","quiz","daily"],"release":"2026-10-30","featured":false,"visible":true,"status":"published","access":"public"},{"id":"g11","slug":"ludo-himalaya","title":{"en":"Ludo Himalaya","ne":"लुडो हिमालय"},"desc":{"en":"The classic ludo table in three dimensions: walnut, brass and glass. Roll six to leave the yard, capture rivals, then race four marbles up your home column.","ne":"तीन आयाममा क्लासिक लुडो टेबल: ओखरको काठ, पित्तल र काँच। छक्का परे घरबाट निस्कनुहोस्, प्रतिद्वन्द्वीलाई काट्नुहोस् र चार गोटी आ-आफ्नो घरतर्फ दौडाउनुहोस्।"},"thumb":"/media/arcade/thumbs/ludo-himalaya.jpg","url":"/arcade/index.html?game=ludo-himalaya","launch":"live","engine":"arcade-ludo","category":"Board","tags":["nepal","ludo","dice","3d"],"release":"2026-10-30","featured":true,"visible":true,"status":"published","access":"public"},{"id":"g5","slug":"cube-26","title":{"en":"CUBE/26","ne":"क्युब/२६"},"desc":{"en":"A studio-grade 3D cube lab for 2×2 and 3×3 puzzles: scramble, solve, or paint any position sticker by sticker, then run the verified solve plan on the cube.","ne":"२×२ र ३×३ पजलका लागि स्टुडियो-स्तरको ३डी क्युब ल्याब: स्क्र्याम्बल गर्नुहोस्, समाधान गर्नुहोस्, वा जुनसुकै अवस्था स्टिकर-स्टिकर रङ्गाउनुहोस्, अनि प्रमाणित समाधान योजना क्युबमा चल्न दिनुहोस्।"},"thumb":"/media/cube26.jpg","url":"/cube26/","launch":"live","engine":"cube-26","category":"Puzzle","tags":["3d","rubik","solver"],"release":"2026-10-29","featured":true,"visible":true,"status":"published","access":"public"},{"id":"g2","slug":"signal-drift","title":{"en":"Signal Drift","ne":"सिग्नल ड्रिफ्ट"},"desc":{"en":"A timing game: lock the signal inside the target arc across five increasingly fast rounds.","ne":"टाइमिङ खेल: पाँच चरणमा बढ्दो गतिमा सिग्नललाई लक्षित आर्कभित्र रोक्नुहोस्।"},"thumb":"art:nebula","url":"","launch":"embedded","engine":"signal-drift","category":"Arcade","tags":["reflex"],"release":"2026-09-19","featured":true,"visible":true,"status":"published","access":"members"},{"id":"g1","slug":"orbit-recall","title":{"en":"Orbit Recall","ne":"अर्बिट रिकल"},"desc":{"en":"A memory game built from the Acttolog divisions. Match the orbital pairs before the timer drifts.","ne":"Acttolog विभागहरूबाट बनेको स्मृति खेल। समय सकिनुअघि जोडी मिलाउनुहोस्।"},"thumb":"art:games","url":"","launch":"embedded","engine":"orbit-recall","category":"Puzzle","tags":["memory"],"release":"2026-09-17","featured":true,"visible":true,"status":"published","access":"members"}]}],"$L7","$L8","$L9"]}]}],"$La"],null,"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$d","varyParams":"$12"}],"isUpgradeableISRFallback":false,"a":"$@13","rootVaryParams":null,"needsRuntimeRequest":"$@14"}
