%20r%3D%220.42%22%20fill%3D%22%23fff%22%20opacity%3D%220.61%22%2F%3E%20%3C%2Fsvg%3E21:["$","section",null,{"className":"pt-[calc(var(--nav)+48px)] pb-16","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Why Darkroom Publishes No Popularity Numbers\",\"description\":\"A resource list ranked by clicks rewards whoever marketed hardest, not whoever is most useful.\",\"datePublished\":\"2026-08-19\",\"author\":{\"@type\":\"Organization\",\"name\":\"Acttolog Editorial\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"ACTTOLOG\"},\"inLanguage\":[\"en\",\"ne\"]}"}}],["$","div",null,{"className":"wrap","children":[["$","nav",null,{"className":"flex items-center gap-2 text-[12.3px] dim mb-7 flex-wrap","aria-label":"Breadcrumb","children":[["$","$L1c",null,{"href":"/","className":"hover:text-[var(--cy)]","children":"Home"}],["$","span",null,{"children":"/"}],["$","$L1c",null,{"href":"/blog","className":"hover:text-[var(--cy)]","children":"Blog"}],["$","span",null,{"children":"/"}],["$","span",null,{"style":{"color":"var(--txt)"},"className":"truncate max-w-[40ch]","children":"Why Darkroom Publishes No Popularity Numbers"}]]}],["$","div",null,{"className":"grid lg:grid-cols-[1fr_320px] gap-8 items-start","children":[["$","article",null,{"children":[["$","$L29",null,{"children":[["$","div",null,{"className":"flex flex-wrap gap-2 mb-4","children":[["$","span",null,{"className":"badge b-vi","children":"Media"}],["$","span",null,{"className":"badge b-mut","children":"Public"}],false]}],["$","h1",null,{"className":"h1 !text-[clamp(1.8rem,4.6vw,3.1rem)] max-w-[24ch] mb-4","children":"Why Darkroom Publishes No Popularity Numbers"}],["$","p",null,{"className":"font-display font-semibold text-[17px] mut mb-5 max-w-[52ch]","children":"डार्करूमले लोकप्रियता सङ्ख्या किन देखाउँदैन"}],["$","div",null,{"className":"mono text-[10.3px] tracking-[.2em] dim mb-8 flex flex-wrap items-center gap-3","children":[["$","span",null,{"children":"ACTTOLOG EDITORIAL"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":"19 Aug 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[1," MIN READ"]}]]}]]}],["$","$L29",null,{"children":["$","div",null,{"className":"rounded-2xl overflow-hidden mb-8 border","style":{"borderColor":"var(--line)"},"children":["$","img",null,{"src":"$2a","alt":"","className":"w-full h-[280px] sm:h-[380px] object-cover"}]}]}],"$L2b"]}],"$L2c"]}]]}]]}]
