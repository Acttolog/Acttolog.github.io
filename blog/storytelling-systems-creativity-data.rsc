m] dim mb-8 flex flex-wrap items-center gap-3","children":[["$","span",null,{"children":"ACTTOLOG EDITORIAL"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":"01 Sept 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[1," MIN READ"]}]]}]]}],["$","$L2b",null,{"children":["$","div",null,{"className":"rounded-2xl overflow-hidden mb-8 border","style":{"borderColor":"var(--line)"},"children":["$","img",null,{"src":"$2c","alt":"","className":"w-full h-[280px] sm:h-[380px] object-cover"}]}]}],"$L2d"]}],"$L2e"]}]]}]]}]
