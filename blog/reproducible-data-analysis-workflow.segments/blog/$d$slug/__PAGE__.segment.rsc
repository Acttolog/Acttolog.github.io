me":"mono text-[10.3px] tracking-[.2em] dim mb-8 flex flex-wrap items-center gap-3","children":[["$","span",null,{"children":"ACTTOLOG EDITORIAL"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":"12 Sept 2026"}],["$","span",null,{"children":"·"}],["$","span",null,{"children":[1," MIN READ"]}]]}]]}],["$","$L3",null,{"children":["$","div",null,{"className":"rounded-2xl overflow-hidden mb-8 border","style":{"borderColor":"var(--line)"},"children":["$","img",null,{"src":"$4","alt":"","className":"w-full h-[280px] sm:h-[380px] object-cover"}]}]}],"$L5"]}],"$L6"]}]]}]]}],null,"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
