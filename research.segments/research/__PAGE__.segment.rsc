a:["$","$L3",null,{"children":["$","div",null,{"className":"panel mt-14 p-7 sm:p-9","style":{"borderColor":"color-mix(in srgb,var(--gold) 30%,transparent)"},"children":["$","div",null,{"className":"flex items-start gap-4","children":[["$","span",null,{"className":"grid h-11 w-11 flex-none place-items-center rounded-xl","style":{"background":"color-mix(in srgb,var(--gold) 13%,transparent)","color":"var(--gold)","border":"1px solid color-mix(in srgb,var(--gold) 32%,transparent)"},"children":["$","svg",null,{"width":20,"height":20,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":1.7,"strokeLinecap":"round","strokeLinejoin":"round","aria-hidden":"true","dangerouslySetInnerHTML":{"__html":"<path d=\"M12 3l8 3v6c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V6z\"/><path d=\"M9 12l2 2 4-4\"/>"}}]}],["$","div",null,{"children":[["$","div",null,{"className":"eyebrow mb-3","style":{"color":"var(--gold)"},"children":"ACADEMIC INTEGRITY"}],["$","p",null,{"className":"mut text-[13.6px] leading-relaxed","children":"Thesyn Research does not advertise absolute guarantees such as “0% plagiarism”, “100% AI-free” or assured academic success. What is offered is honest, documented work: manual academic quality review, similarity/plagiarism checking, AI-related checking, citation and reference checking, identification of problem areas, and academic rewriting guidance."}],["$","p",null,{"className":"dim mt-3 text-[12.6px] leading-relaxed","children":"थेसिन रिसर्चले “०% प्लेजरिजम”, “१००% एआई-मुक्त” वा सफलताको निश्चित ग्यारेन्टी जस्ता दाबी गर्दैन। यहाँ इमानदार र अभिलेखित कार्य उपलब्ध छ: म्यानुअल शैक्षिक गुणस्तर समीक्षा, सिमिलारिटी जाँच, एआई सम्बन्धी जाँच, उद्धरण जाँच, समस्या क्षेत्रको पहिचान र शैक्षिक पुनर्लेखन मार्गदर्शन।"}]]}]]}]}]}]
b:["$","section",null,{"className":"sec nb-sec","id":"rs-notices","children":["$","div",null,{"className":"wrap","children":["$","$L3",null,{"children":["$","$L2d",null,{"notices":[{"id":"rs-ugc","scope":"research","category":"government","kind":"source","title":{"en":"University Grants Commission Nepal","ne":"विश्वविद्यालय अनुदान आयोग नेपाल"},"org":{"en":"Government body","ne":"सरकारी निकाय"},"summary":{"en":"Research grants, fellowships and faculty-development notices for universities and researchers.","ne":"विश्वविद्यालय र अनुसन्धानकर्ताका लागि अनुसन्धान अनुदान, फेलोसिप र प्राध्यापक-विकास सूचना।"},"detail":{"en":"The University Grants Commission funds Nepali universities and researchers. Its notices carry research grants, fellowships, doctoral support and faculty-development calls, each with its own eligibility and deadline. These are competitive awards administered by the Commission, not Loksewa vacancies, so the application route is the Commission’s own call document.","ne":"विश्वविद्यालय अनुदान आयोगले नेपालका विश्वविद्यालय र अनुसन्धानकर्तालाई अनुदान दिन्छ। यसका सूचनामा अनुसन्धान अनुदान, फेलोसिप, विद्यावारिधि सहयोग र प्राध्यापक विकासका आह्वान आउँछन्, प्रत्येकको छुट्टै योग्यता र अन्तिम मिति हुन्छ। यी आयोग आफैंले सञ्चालन गर्ने प्रतिस्पर्धात्मक पुरस्कार हुन्, लोक सेवाका रिक्त पद होइनन्, त्यसैले आवेदनको बाटो आयोगकै आह्वान दस्तावेज हो।"},"sourceUrl":"https://ugc.gov.np","sourceName":"ugc.gov.np","location":{"en":"Bhaktapur","ne":"भक्तपुर"},"tags":["grant","fellowship","research"],"posted":"2026-11-17","verifiedOn":"2026-11-17","featured":true},{"id":"rs-method","scope":"research","category":"service","kind":"notice","title":{"en":"Research methodology & analysis support — open intake","ne":"अनुसन्धान विधि र विश्लेषण सहयोग — खुला दर्ता"},"org":{"en":"ACTTOLOG · Thesyn Research","ne":"ACTTOLOG · थेसिन रिसर्च"},"summary":{"en":"Proposal design, SPSS/STATA/EViews analysis and thesis structuring. Integrity-first: we support your work, never write it for you.","ne":"प्रस्ताव डिजाइन, SPSS/STATA/EViews विश्लेषण र थेसिस संरचना। इमानदारी-प्रथम: हामी तपाईंको काममा सहयोग गर्छौं, लेखिदिँदैनौं।"},"detail":{"en":"Support is scoped to method: research design, instrument choice, analysis in SPSS, STATA or EViews, and thesis structure. We work on your data and your argument. We do not write the thesis, and we say so before intake so the boundary is clear from the first message.","ne":"सहयोग विधिमा सीमित छ: अनुसन्धान ढाँचा, उपकरण छनोट, SPSS, STATA वा EViews मा विश्लेषण, र शोधपत्रको संरचना। हामी तपाईंको डाटा र तर्कमा काम गर्छौं। शोधपत्र लेखिदिँदैनौं, र पहिलो सन्देशमै सीमा स्पष्ट हुने गरी भर्ना हुनुअघि नै भन्छौं।"},"sourceUrl":"/research#packages","sourceName":"Thesyn Research","tags":["analysis","thesis","spss"],"posted":"2026-11-05","verifiedOn":"2026-11-17","closesOn":"2026-12-20"},{"id":"rs-library","scope":"research","category":"resource","kind":"notice","title":{"en":"Digital library — Nepal & international evidence added","ne":"डिजिटल पुस्तकालय — नेपाल र अन्तर्राष्ट्रिय प्रमाण थपियो"},"org":{"en":"ACTTOLOG · Thesyn Research","ne":"ACTTOLOG · थेसिन रिसर्च"},"summary":{"en":"Curated guides, datasets and video labs for literature review and method selection — free to read.","ne":"साहित्य समीक्षा र विधि छनोटका लागि क्युरेटेड गाइड, डेटासेट र भिडियो ल्याब — निःशुल्क पढ्न।"},"detail":{"en":"The library groups evidence by question rather than by publisher: Nepal datasets, international indicators, method guides and video labs. Every entry links the body that publishes it, and the source ledger records when that link was last checked.","ne":"पुस्तकालयले प्रमाण प्रकाशकअनुसार नभई प्रश्नअनुसार समूह बनाउँछ: नेपालका डाटासेट, अन्तर्राष्ट्रिय सूचक, विधि मार्गदर्शिका र भिडियो ल्याब। प्रत्येक प्रविष्टिले त्यसलाई प्रकाशित गर्ने निकायलाई जोड्छ, र स्रोत खातामा त्यो लिंक कहिले जाँचिएको थियो भन्ने रेकर्ड हुन्छ।"},"sourceUrl":"/research","sourceName":"Thesyn Research","tags":["library","evidence","free"],"posted":"2026-11-12","verifiedOn":"2026-11-17"},{"id":"rs-nso","scope":"research","category":"government","kind":"source","title":{"en":"National Statistics Office","ne":"राष्ट्रिय तथ्याङ्क कार्यालय"},"org":{"en":"Government of Nepal","ne":"नेपाल सरकार"},"summary":{"en":"Census, national accounts and official statistical releases.","ne":"जनगणना, राष्ट्रिय लेखा र आधिकारिक तथ्याङ्कीय विज्ञप्ति।"},"detail":{"en":"Nepal’s official statistical producer, successor to the Central Bureau of Statistics. Census tables, GDP releases and the Nepal Living Standards Survey are published here — the authority for any national figure quoted on the site.","ne":"नेपालको आधिकारिक तथ्याङ्क उत्पादक, केन्द्रीय तथ्याङ्क विभागको उत्तराधिकारी। जनगणना तालिका, कुल गार्हस्थ्य उत्पादन र जीवनस्तर सर्वेक्षण यहाँ प्रकाशित हुन्छन्।"},"sourceUrl":"https://nsonepal.gov.np","sourceName":"nsonepal.gov.np","location":{"en":"Kathmandu","ne":"काठमाडौं"},"tags":["census","statistics","national accounts"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"rs-openalex","scope":"research","category":"resource","kind":"source","title":{"en":"OpenAlex","ne":"ओपनएलेक्स"},"org":{"en":"OurResearch (non-profit)","ne":"आवररिसर्च (गैरनाफामूलक)"},"summary":{"en":"Open catalogue of scholarly works, authors, venues and institutions.","ne":"शैक्षिक कृति, लेखक, प्रकाशन स्थल र संस्थाको खुला सूची।"},"detail":{"en":"A free, fully open index of the global research record, released under CC0. It replaces paywalled citation databases for literature mapping, so a research desk can trace a claim to its source without a subscription.","ne":"विश्वव्यापी अनुसन्धान रेकर्डको निःशुल्क, पूर्ण खुला अनुक्रमणिका (CC0)। साहित्य नक्साङ्कनका लागि शुल्क लाग्ने उद्धरण डाटाबेसको विकल्प।"},"sourceUrl":"https://openalex.org","sourceName":"openalex.org","location":{"en":"Global","ne":"विश्वव्यापी"},"tags":["scholarly","citations","open access"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"rs-crossref","scope":"research","category":"resource","kind":"source","title":{"en":"Crossref","ne":"क्रसरेफ"},"org":{"en":"Crossref (non-profit DOI registration agency)","ne":"क्रसरेफ (गैरनाफामूलक DOI दर्ता निकाय)"},"summary":{"en":"DOI registration and citation linking for scholarly publishing.","ne":"शैक्षिक प्रकाशनका लागि DOI दर्ता र उद्धरण लिङ्किङ।"},"detail":{"en":"The registration agency that makes a DOI resolve. Metadata deposited here is what lets a reference be checked against the publisher’s record rather than copied from a secondary list.","ne":"DOI लाई रिजोल्भ गराउने दर्ता निकाय। यहाँ जम्मा भएको मेटाडाटाले सन्दर्भलाई प्रकाशकको रेकर्डविरुद्ध जाँच्न सम्भव बनाउँछ।"},"sourceUrl":"https://www.crossref.org","sourceName":"crossref.org","location":{"en":"Lynnfield, Massachusetts","ne":"लिनफिल्ड, म्यासाचुसेट्स"},"tags":["doi","metadata","publishing"],"posted":"2026-11-18","verifiedOn":"2026-11-18"},{"id":"rs-unstats","scope":"research","category":"resource","kind":"source","title":{"en":"UN Statistics Division","ne":"राष्ट्रसंघ तथ्याङ्क महाशाखा"},"org":{"en":"United Nations","ne":"संयुक्त राष्ट्रसंघ"},"summary":{"en":"SDG indicator series, statistical standards and country data.","ne":"दिगो विकास लक्ष्य सूचक शृङ्खला, तथ्याङ्कीय मापदण्ड र देश डाटा।"},"detail":{"en":"Custodian of the global SDG indicator framework and the international statistical standards national offices follow. When ACTTOLOG compares Nepal against a regional average, the definition and series come from here.","ne":"विश्वव्यापी दिगो विकास लक्ष्य सूचक ढाँचा र अन्तर्राष्ट्रिय तथ्याङ्कीय मापदण्डको संरक्षक। नेपाललाई क्षेत्रीय औसतसँग तुलना गर्दा परिभाषा र शृङ्खला यहाँबाट आउँछ।"},"sourceUrl":"https://unstats.un.org/UNSDWebsite/","sourceName":"unstats.un.org","location":{"en":"New York","ne":"न्यूयोर्क"},"tags":["sdg","standards","statistics"],"posted":"2026-11-18","verifiedOn":"2026-11-18"}],"categories":[{"id":"government","label":{"en":"Government","ne":"सरकारी"},"color":"var(--cy)","count":2},{"id":"service","label":{"en":"Service","ne":"सेवा"},"color":"var(--cy)","count":1},{"id":"resource","label":{"en":"Resource","ne":"स्रोत"},"color":"var(--gold)","count":4}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"en","variant":"section","accent":"var(--cy)","subtitle":{"en":"Research desk notices, plus the official statistics and open-research portals we cite.","ne":"अनुसन्धान डेस्कका सूचना, र हामीले उद्धृत गर्ने आधिकारिक तथ्याङ्क तथा खुला अनुसन्धान पोर्टलहरू।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:47.525Z"},"moha.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:48.931Z"},"mof.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44:51.114Z"},"mofaga.gov.np":{"status":"unreachabl