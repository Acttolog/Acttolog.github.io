28:["$","section",null,{"className":"sec nb-sec","id":"gm-notices","children":["$","div",null,{"className":"wrap","children":["$","$L21",null,{"children":["$","$L30",null,{"notices":[{"id":"gm-launch","scope":"games","category":"release","kind":"notice","title":{"en":"Nepal Series game — now playable","ne":"नेपाल सिरिज खेल — अब खेल्न मिल्ने"},"org":{"en":"ACTTOLOG · Games","ne":"ACTTOLOG · खेल"},"summary":{"en":"A new Nepal-themed game is live in the arcade. Launch instantly — no account, plays on mobile.","ne":"नयाँ नेपाल-थिमको खेल आर्केडमा live छ। तुरुन्त सुरु — खाता चाहिँदैन, मोबाइलमा चल्छ।"},"detail":{"en":"The arcade runs entirely in the browser: no account, no install and no download. Nepal Series games are original builds with touch controls, so the same link plays on a phone and on a desktop.","ne":"आर्केड पूरै ब्राउजरमा चल्छ: खाता चाहिँदैन, इन्स्टल गर्नुपर्दैन, डाउनलोड पनि छैन। नेपाल सिरिजका खेल मौलिक निर्माण हुन् र टच नियन्त्रण छन्, त्यसैले एउटै लिंक फोन र डेस्कटप दुवैमा खेल्न सकिन्छ।"},"sourceUrl":"/games","sourceName":"Games","tags":["arcade","nepal series","mobile"],"posted":"2026-11-13","verifiedOn":"2026-11-17","featured":true},{"id":"gm-quick","scope":"games","category":"event","kind":"notice","title":{"en":"Quick-play lineup refreshed","ne":"तुरुन्त-खेल्ने सूची परिमार्जन"},"org":{"en":"ACTTOLOG · Games","ne":"ACTTOLOG · खेल"},"summary":{"en":"Snake Himalaya, Breakout, Danphe Flight, Memory Nepal, Stack and Ludo Himalaya — direct launch.","ne":"स्नेक हिमालय, ब्रेकआउट, डाँफे फ्लाइट, मेमोरी नेपाल, स्ट्याक र लुडो हिमालय — सिधै सुरु।"},"detail":{"en":"Quick-play is a direct launch row: one tap opens the game itself rather than a description page. The six entries are chosen for short sessions — Snake Himalaya, Breakout, Danphe Flight, Memory Nepal, Stack and Ludo Himalaya.","ne":"क्विक-प्ले सिधै खेल्ने पङ्क्ति हो: एक ट्यापले विवरण पृष्ठ होइन, खेल आफैं खोल्छ। छोटो समयमा खेल्न मिल्ने गरी छ वटा छानिएका छन् — स्नेक हिमालय, ब्रेकआउट, डाँफे फ्लाइट, मेमोरी नेपाल, स्ट्याक र लुडो हिमालय।"},"sourceUrl":"/games","sourceName":"Games","tags":["quick play","ludo","arcade"],"posted":"2026-11-16","verifiedOn":"2026-11-17"}],"categories":[{"id":"release","label":{"en":"Release","ne":"रिलिज"},"color":"var(--mg)","count":1},{"id":"event","label":{"en":"Event","ne":"कार्यक्रम"},"color":"var(--mg)","count":1}],"meta":{"name":{"en":"Notice Board","ne":"सूचना पाटी"},"tagline":{"en":"Government, sansthan and bank recruitment portals — each linked to the body that publishes its notices.","ne":"सरकारी, संस्थान र बैंकका पदपूर्ति पोर्टलहरू — प्रत्येक आफ्ना सूचना प्रकाशन गर्ने निकायमै लिङ्क गरिएको।"},"disclosure":{"en":"This is a curated, source-linked directory — not an automated government feed. Each portal carries the reachability check we actually ran, so a badge tells you whether it answered, not whether a vacancy is open. Always open the source and verify the current notice, dates and eligibility before applying. ACTTOLOG-owned entries carry our own editorial availability window.","ne":"यो स्रोत-लिङ्कित क्युरेटेड सूची हो — स्वचालित सरकारी फिड होइन। हरेक पोर्टलमा हामीले वास्तवमै गरेको पहुँच जाँच राखिएको छ, त्यसैले ब्याजले पोर्टलले जवाफ दियो कि दिएन भन्छ, पद खुला छ कि छैन भन्दैन। आवेदन दिनुअघि स्रोत खोलेर हालको सूचना, मिति र योग्यता अनिवार्य जाँच्नुहोस्। ACTTOLOG आफ्ना प्रविष्टिहरूमा हाम्रै सम्पादकीय उपलब्धता अवधि राखिन्छ।"},"liveNote":{"en":"Status and countdowns are computed live in your browser from the dates below.","ne":"स्थिति र काउन्टडाउन तलका मितिबाट तपाईंको ब्राउजरमै प्रत्यक्ष गणना हुन्छ।"},"updated":"2026-11-18","shortDisclosure":{"en":"Curated directory, not an automated feed — open the source to verify.","ne":"क्युरेटेड सूची, स्वचालित फिड होइन — स्रोत खोलेर जाँच्नुहोस्।"}},"locale":"en","variant":"section","accent":"var(--ok)","title":"$undefined","subtitle":{"en":"Launch and event notices from the games desk.","ne":"गेम्स डेस्कका लन्च र कार्यक्रम सूचना।"},"reach":{"psc.gov.np":{"status":"reachable","checkedAt":"2026-11-17T23:44